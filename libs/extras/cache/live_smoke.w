# Optional interoperability check. Run only against disposable local servers:
# bin/wv2 libs/extras/cache/live_smoke.w -o bin/cache_live_smoke
# bin/cache_live_smoke <redis-port> <memcached-port>
import lib.assert
import libs.extras.cache.redis
import libs.extras.cache.memcached


int main(int argc, int argv):
	if (argc != 3):
		println2(c"usage: cache_live_smoke <redis-port> <memcached-port>")
		return 2
	char** values = cast(char**, argv)
	cache_connection* redis = redis_connect(c"127.0.0.1", atoi(values[1]), 3000)
	assert_equal(0, redis.error)
	redis_reply* rr = redis_ping(redis)
	asserts(c"PING", rr != 0 && rr.kind == redis_simple)
	assert_strings_equal(c"PONG", rr.data)
	redis_reply_free(rr)
	rr = redis_set(redis, "w-cache-smoke", "\x00\x0d\x0aW")
	asserts(c"SET", rr != 0 && rr.kind == redis_simple)
	redis_reply_free(rr)
	list[string] args = new list[string]
	args.push("MGET")
	args.push("w-cache-smoke")
	args.push("w-cache-smoke-absent")
	rr = redis_command(redis, args)
	asserts(c"MGET", rr != 0 && rr.kind == redis_array)
	assert_equal(2, rr.elements.length)
	assert_equal(4, rr.elements[0].length)
	asserts(c"Redis binary", mem_eq(rr.elements[0].data, c"\x00\x0d\x0aW", 4))
	assert_equal(redis_nil, rr.elements[1].kind)
	redis_reply_free(rr)
	list_free[string](args)
	rr = redis_del(redis, "w-cache-smoke")
	asserts(c"DEL", rr != 0 && rr.kind == redis_integer)
	assert_strings_equal(c"1", rr.data)
	redis_reply_free(rr)
	cache_close(redis)

	cache_connection* mc = memcached_connect(c"127.0.0.1", atoi(values[2]), 3000)
	assert_equal(0, mc.error)
	memcached_reply* mr = memcached_store(mc, c"set", "w-cache-smoke", "\x00\x0d\x0aW", c"4294967295", 60, 0)
	asserts(c"memcached set", mr != 0 && mr.status == memcached_stored)
	memcached_reply_free(mr)
	mr = memcached_gets(mc, "w-cache-smoke")
	asserts(c"memcached gets", mr != 0 && mr.status == memcached_value)
	assert_equal(4, mr.length)
	asserts(c"memcached binary", mem_eq(mr.data, c"\x00\x0d\x0aW", 4))
	assert_strings_equal(c"4294967295", mr.flags)
	char* token = strclone(mr.cas)
	memcached_reply_free(mr)
	mr = memcached_cas(mc, "w-cache-smoke", "42", c"0", 60, token)
	asserts(c"memcached cas", mr != 0 && mr.status == memcached_stored)
	memcached_reply_free(mr)
	mr = memcached_cas(mc, "w-cache-smoke", "oops", c"0", 60, token)
	asserts(c"memcached stale cas", mr != 0 && mr.status == memcached_exists)
	memcached_reply_free(mr)
	free(token)
	mr = memcached_incr(mc, "w-cache-smoke", c"1")
	asserts(c"memcached incr", mr != 0 && mr.status == memcached_number)
	assert_strings_equal(c"43", mr.data)
	memcached_reply_free(mr)
	mr = memcached_decr(mc, "w-cache-smoke", c"100")
	asserts(c"memcached decr", mr != 0 && mr.status == memcached_number)
	assert_strings_equal(c"0", mr.data)
	memcached_reply_free(mr)
	mr = memcached_touch(mc, "w-cache-smoke", 60)
	asserts(c"memcached touch", mr != 0 && mr.status == memcached_touched)
	memcached_reply_free(mr)
	mr = memcached_delete(mc, "w-cache-smoke")
	asserts(c"memcached delete", mr != 0 && mr.status == memcached_deleted)
	memcached_reply_free(mr)
	mr = memcached_get(mc, "w-cache-smoke")
	asserts(c"memcached miss", mr != 0 && mr.status == memcached_not_found)
	memcached_reply_free(mr)
	cache_close(mc)
	println(c"Redis and Memcached live smoke: OK")
	return 0
