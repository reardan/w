void test_redis_reply_limits():
	cache_bad_redis("*65536\x0d\x0a", cache_error_limit)
	cache_bad_redis("$16777216\x0d\x0a", cache_error_limit)
	string_builder* nested = string_new()
	for i in range(65): string_append(nested, c"*1\x0d\x0a")
	string view = string_builder_to_string(nested)
	cache_bad_redis(view, cache_error_limit)
	free(cast(void*, view))
	string_free(nested)
	cache_fixture* f = cache_fixture_one("*1\x0d\x0a$4\x0d\x0aPING\x0d\x0a", "*2\x0d\x0a$4\x0d\x0aabcd\x0d\x0a$4\x0d\x0aefgh\x0d\x0a", 1)
	f.client.max_bytes = 20
	asserts(c"aggregate byte cap", redis_ping(f.client) == 0)
	assert_equal(cache_error_limit, f.client.error)
	cache_fixture_finish(f)


void test_cache_timeout_and_connect_failure():
	cache_fixture* f = cache_fixture_one("*1\x0d\x0a$4\x0d\x0aPING\x0d\x0a", "", 0)
	f.client.io.timeout_ms = 30
	asserts(c"timeout", redis_ping(f.client) == 0)
	assert_equal(cache_error_timeout, f.client.error)
	cache_fixture_finish(f)
	cache_connection* c = redis_connect(c"127.0.0.1", 0, 100)
	assert_equal(cache_error_argument, c.error)
	cache_close(c)
	int port = 0
	int listener = net_test_listen(&port)
	close(listener)
	c = memcached_connect(c"127.0.0.1", port, 100)
	assert_equal(cache_error_connect, c.error)
	cache_close(c)


void test_memcached_binary_empty_and_miss():
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push("set key 0 60 4\x0d\x0a\x00\x0d\x0ax\x0d\x0a")
	responses.push("STORED\x0d\x0a")
	requests.push("gets key\x0d\x0a")
	responses.push("VALUE key 4294967295 4 18446744073709551615\x0d\x0a\x00\x0d\x0ax\x0d\x0aEND\x0d\x0a")
	requests.push("get empty\x0d\x0a")
	responses.push("VALUE empty 0 0\x0d\x0a\x0d\x0aEND\x0d\x0a")
	requests.push("get absent\x0d\x0a")
	responses.push("END\x0d\x0a")
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 1)
	memcached_reply* r = memcached_set(f.client, "key", "\x00\x0d\x0ax", 60)
	asserts(c"store reply", r != 0)
	assert_equal(memcached_stored, r.status)
	memcached_reply_free(r)
	r = memcached_gets(f.client, "key")
	asserts(c"gets reply", r != 0)
	assert_equal(memcached_value, r.status)
	assert_equal(4, r.length)
	asserts(c"binary value", mem_eq(r.data, c"\x00\x0d\x0ax", 4))
	assert_strings_equal(c"4294967295", r.flags)
	assert_strings_equal(c"18446744073709551615", r.cas)
	memcached_reply_free(r)
	r = memcached_get(f.client, "empty")
	assert_equal(memcached_value, r.status)
	assert_equal(0, r.length)
	asserts(c"empty allocation", r.data != 0)
	memcached_reply_free(r)
	r = memcached_get(f.client, "absent")
	assert_equal(memcached_not_found, r.status)
	assert_equal(0, f.client.error)
	memcached_reply_free(r)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)


void test_memcached_storage_variants_cas_and_counters():
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push("add k 7 0 1\x0d\x0av\x0d\x0a")
	responses.push("NOT_STORED\x0d\x0a")
	requests.push("replace k 7 0 1\x0d\x0av\x0d\x0a")
	responses.push("STORED\x0d\x0a")
	requests.push("append k 7 0 1\x0d\x0av\x0d\x0a")
	responses.push("STORED\x0d\x0a")
	requests.push("prepend k 7 0 1\x0d\x0av\x0d\x0a")
	responses.push("NOT_STORED\x0d\x0a")
	requests.push("cas k 4294967295 0 1 18446744073709551615\x0d\x0av\x0d\x0a")
	responses.push("EXISTS\x0d\x0a")
	requests.push("cas k 0 0 1 1\x0d\x0av\x0d\x0a")
	responses.push("NOT_FOUND\x0d\x0a")
	requests.push("cas k 0 0 1 2\x0d\x0av\x0d\x0a")
	responses.push("STORED\x0d\x0a")
	requests.push("incr k 18446744073709551615\x0d\x0a")
	responses.push("18446744073709551615\x0d\x0a")
	requests.push("decr k 1\x0d\x0a")
	responses.push("0\x0d\x0a")
	requests.push("incr absent 1\x0d\x0a")
	responses.push("NOT_FOUND\x0d\x0a")
	requests.push("touch k 2592001\x0d\x0a")
	responses.push("TOUCHED\x0d\x0a")
	requests.push("delete k\x0d\x0a")
	responses.push("DELETED\x0d\x0a")
	requests.push("delete k\x0d\x0a")
	responses.push("NOT_FOUND\x0d\x0a")
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 0)
	memcached_reply* r = memcached_store(f.client, c"add", "k", "v", c"7", 0, 0)
	assert_equal(memcached_not_stored, r.status)
	memcached_reply_free(r)
	r = memcached_store(f.client, c"replace", "k", "v", c"7", 0, 0)
	assert_equal(memcached_stored, r.status)
	memcached_reply_free(r)
	r = memcached_store(f.client, c"append", "k", "v", c"7", 0, 0)
	assert_equal(memcached_stored, r.status)
	memcached_reply_free(r)
	r = memcached_store(f.client, c"prepend", "k", "v", c"7", 0, 0)
	assert_equal(memcached_not_stored, r.status)
	memcached_reply_free(r)
	r = memcached_cas(f.client, "k", "v", c"4294967295", 0, c"18446744073709551615")
	assert_equal(memcached_exists, r.status)
	memcached_reply_free(r)
	r = memcached_cas(f.client, "k", "v", c"0", 0, c"1")
	assert_equal(memcached_not_found, r.status)
	memcached_reply_free(r)
	r = memcached_cas(f.client, "k", "v", c"0", 0, c"2")
	assert_equal(memcached_stored, r.status)
	memcached_reply_free(r)
	r = memcached_incr(f.client, "k", c"18446744073709551615")
	assert_equal(memcached_number, r.status)
	assert_strings_equal(c"18446744073709551615", r.data)
	memcached_reply_free(r)
	r = memcached_decr(f.client, "k", c"1")
	assert_strings_equal(c"0", r.data)
	memcached_reply_free(r)
	r = memcached_incr(f.client, "absent", c"1")
	assert_equal(memcached_not_found, r.status)
	memcached_reply_free(r)
	r = memcached_touch(f.client, "k", 2592001)
	assert_equal(memcached_touched, r.status)
	memcached_reply_free(r)
	r = memcached_delete(f.client, "k")
	assert_equal(memcached_deleted, r.status)
	memcached_reply_free(r)
	r = memcached_delete(f.client, "k")
	assert_equal(memcached_not_found, r.status)
	memcached_reply_free(r)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)


void test_memcached_argument_and_server_error_recovery():
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push("set k 0 0 1\x0d\x0av\x0d\x0a")
	responses.push("SERVER_ERROR out of memory\x0d\x0a")
	requests.push("get k\x0d\x0a")
	responses.push("CLIENT_ERROR bad request\x0d\x0a")
	requests.push("delete k\x0d\x0a")
	responses.push("ERROR\x0d\x0a")
	requests.push("get k\x0d\x0a")
	responses.push("END\x0d\x0a")
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 0)
	asserts(c"space key", memcached_get(f.client, "bad key") == 0)
	assert_equal(cache_error_argument, f.client.error)
	asserts(c"NUL key", memcached_get(f.client, "bad\x00key") == 0)
	asserts(c"CRLF key", memcached_set(f.client, "k\x0d\x0adelete k", "v", 0) == 0)
	asserts(c"empty key", memcached_get(f.client, "") == 0)
	asserts(c"negative expiry", memcached_touch(f.client, "k", -1) == 0)
	asserts(c"overflow delta", memcached_incr(f.client, "k", c"18446744073709551616") == 0)
	asserts(c"injected delta", memcached_incr(f.client, "k", c"1\x0d\x0aquit") == 0)
	asserts(c"overflow flags", memcached_store(f.client, c"set", "k", "v", c"4294967296", 0, 0) == 0)
	asserts(c"missing cas", memcached_cas(f.client, "k", "v", c"0", 0, 0) == 0)
	asserts(c"invalid verb", memcached_store(f.client, c"get", "k", "v", c"0", 0, 0) == 0)
	memcached_reply* r = memcached_set(f.client, "k", "v", 0)
	assert_equal(memcached_error, r.status)
	assert_equal(cache_error_server, f.client.error)
	assert_strings_equal(c"SERVER_ERROR out of memory", r.data)
	memcached_reply_free(r)
	r = memcached_get(f.client, "k")
	assert_equal(memcached_error, r.status)
	memcached_reply_free(r)
	r = memcached_delete(f.client, "k")
	assert_equal(memcached_error, r.status)
	memcached_reply_free(r)
	r = memcached_get(f.client, "k")
	assert_equal(memcached_not_found, r.status)
	assert_equal(0, f.client.error)
	memcached_reply_free(r)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)


