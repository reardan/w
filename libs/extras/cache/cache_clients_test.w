void test_cache_values_cross_buffer_boundaries():
	# Much larger than both the reader buffer and a typical TCP segment.
	string_builder* value = string_new()
	for i in range(131072): string_append_char(value, i & 255)
	string payload = string_builder_to_string(value)
	string_builder* request = string_from(c"*3\x0d\x0a$3\x0d\x0aSET\x0d\x0a$1\x0d\x0ak\x0d\x0a$131072\x0d\x0a")
	string_append_string(request, payload)
	string_append(request, c"\x0d\x0a")
	string_builder* response = string_from(c"$131072\x0d\x0a")
	string_append_string(response, payload)
	string_append(response, c"\x0d\x0a")
	string req = string_builder_to_string(request)
	string resp = string_builder_to_string(response)
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push(req)
	responses.push("+OK\x0d\x0a")
	requests.push("*2\x0d\x0a$3\x0d\x0aGET\x0d\x0a$1\x0d\x0ak\x0d\x0a")
	responses.push(resp)
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 0)
	redis_reply* rr = redis_set(f.client, "k", payload)
	asserts(c"large SET", rr != 0 && rr.kind == redis_simple)
	redis_reply_free(rr)
	rr = redis_get(f.client, "k")
	asserts(c"large GET", rr != 0 && rr.kind == redis_bulk)
	assert_equal(value.length, rr.length)
	asserts(c"large binary value", mem_eq(value.data, rr.data, rr.length))
	redis_reply_free(rr)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)
	free(cast(void*, req))
	free(cast(void*, resp))
	string_clear(request)
	string_append(request, c"set k 0 0 131072\x0d\x0a")
	string_append_string(request, payload)
	string_append(request, c"\x0d\x0a")
	string_clear(response)
	string_append(response, c"VALUE k 0 131072\x0d\x0a")
	string_append_string(response, payload)
	string_append(response, c"\x0d\x0aEND\x0d\x0a")
	req = string_builder_to_string(request)
	resp = string_builder_to_string(response)
	requests = new list[string]
	responses = new list[string]
	requests.push(req)
	responses.push("STORED\x0d\x0a")
	requests.push("get k\x0d\x0a")
	responses.push(resp)
	f = cache_fixture_start(requests, responses, 0, 0)
	memcached_reply* mr = memcached_set(f.client, "k", payload, 0)
	asserts(c"large set", mr != 0 && mr.status == memcached_stored)
	memcached_reply_free(mr)
	mr = memcached_get(f.client, "k")
	asserts(c"large get", mr != 0 && mr.status == memcached_value)
	assert_equal(value.length, mr.length)
	asserts(c"large memcached binary value", mem_eq(value.data, mr.data, mr.length))
	memcached_reply_free(mr)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)
	free(cast(void*, req))
	free(cast(void*, resp))
	free(cast(void*, payload))
	string_free(request)
	string_free(response)
	string_free(value)


void test_cache_header_and_key_limits():
	string_builder* line = string_from(c"+")
	for i in range(8192): string_append_char(line, 120)
	string_append(line, c"\x0d\x0a")
	string view = string_builder_to_string(line)
	cache_bad_redis(view, cache_error_limit)
	free(cast(void*, view))
	string_free(line)
	string_builder* key = string_new()
	for i in range(250): string_append_char(key, 107)
	view = string_builder_to_string(key)
	assert_equal(1, memcached_key_valid(view))
	free(cast(void*, view))
	string_append_char(key, 107)
	view = string_builder_to_string(key)
	assert_equal(0, memcached_key_valid(view))
	free(cast(void*, view))
	string_free(key)
