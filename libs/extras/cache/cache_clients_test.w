void test_redis_binary_roundtrip_and_reuse():
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push("*3\x0d\x0a$3\x0d\x0aSET\x0d\x0a$3\x0d\x0ak\x00x\x0d\x0a$4\x0d\x0a\x00\x0d\x0az\x0d\x0a")
	responses.push("+OK\x0d\x0a")
	requests.push("*2\x0d\x0a$3\x0d\x0aGET\x0d\x0a$3\x0d\x0ak\x00x\x0d\x0a")
	responses.push("$4\x0d\x0a\x00\x0d\x0az\x0d\x0a")
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 1)
	redis_reply* r = redis_set(f.client, "k\x00x", "\x00\x0d\x0az")
	asserts(c"SET reply", r != 0)
	assert_equal(redis_simple, r.kind)
	assert_strings_equal(c"OK", r.data)
	redis_reply_free(r)
	r = redis_get(f.client, "k\x00x")
	asserts(c"GET reply", r != 0)
	assert_equal(redis_bulk, r.kind)
	assert_equal(4, r.length)
	asserts(c"binary reply", mem_eq(r.data, c"\x00\x0d\x0az", 4))
	redis_reply_free(r)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)


void test_redis_nested_nil_empty_and_full_width_integers():
	cache_fixture* f = cache_fixture_one("*1\x0d\x0a$4\x0d\x0aPING\x0d\x0a", "*7\x0d\x0a$-1\x0d\x0a$0\x0d\x0a\x0d\x0a*-1\x0d\x0a*0\x0d\x0a:9223372036854775807\x0d\x0a:-9223372036854775808\x0d\x0a*2\x0d\x0a+ok\x0d\x0a-ERR nested\x0d\x0a", 0)
	redis_reply* r = redis_ping(f.client)
	asserts(c"array reply", r != 0)
	assert_equal(0, f.client.error)
	assert_equal(redis_array, r.kind)
	assert_equal(7, r.elements.length)
	assert_equal(redis_nil, r.elements[0].kind)
	assert_equal(redis_bulk, r.elements[1].kind)
	assert_equal(0, r.elements[1].length)
	assert_equal(redis_nil, r.elements[2].kind)
	assert_equal(redis_array, r.elements[3].kind)
	assert_equal(0, r.elements[3].elements.length)
	assert_equal(redis_integer, r.elements[4].kind)
	assert_strings_equal(c"9223372036854775807", r.elements[4].data)
	assert_strings_equal(c"-9223372036854775808", r.elements[5].data)
	assert_equal(redis_error, r.elements[6].elements[1].kind)
	redis_reply_free(r)
	cache_fixture_finish(f)


void test_redis_server_error_and_argument_recovery():
	list[string] requests = new list[string]
	list[string] responses = new list[string]
	requests.push("*2\x0d\x0a$3\x0d\x0aDEL\x0d\x0a$1\x0d\x0ak\x0d\x0a")
	responses.push("-NOAUTH Authentication required.\x0d\x0a")
	requests.push("*1\x0d\x0a$4\x0d\x0aPING\x0d\x0a")
	responses.push("+PONG\x0d\x0a")
	cache_fixture* f = cache_fixture_start(requests, responses, 0, 0)
	list[string] empty = new list[string]
	asserts(c"empty command", redis_command(f.client, empty) == 0)
	assert_equal(cache_error_argument, f.client.error)
	list_free[string](empty)
	redis_reply* r = redis_del(f.client, "k")
	asserts(c"error reply", r != 0)
	assert_equal(redis_error, r.kind)
	assert_equal(cache_error_server, f.client.error)
	assert_strings_equal(c"NOAUTH Authentication required.", r.data)
	redis_reply_free(r)
	r = redis_ping(f.client)
	assert_equal(0, f.client.error)
	assert_strings_equal(c"PONG", r.data)
	redis_reply_free(r)
	cache_fixture_finish(f)
	list_free[string](requests)
	list_free[string](responses)


