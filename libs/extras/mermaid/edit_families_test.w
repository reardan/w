# wbuild: x64
# Graphical editing of requirement, use-case, architecture, block, C4,
# swimlane, mindmap and treeView diagrams. Each family's edits round-trip:
# edit -> save -> reopen -> SVG export, with lossless undo to the original.
import lib.testing
import libs.extras.mermaid.edit_commands

int ef_find(mm_editor* e, char* id):
	return mm_find_node(e.document, id)

# Save, reopen from disk, re-render and export; the reopened document must
# be the edited one and its scene must export as SVG.
void ef_round_trip(mm_editor* e, char* name):
	string_builder* path = string_from(c"bin/mermaid_edit_family_")
	string_append(path, name)
	string_append(path, c".mmd")
	unlink(path.data)
	assert_equal(1, mm_editor_save_as(e, path.data))
	mm_document* reopened = mm_read_selected(path.data, e.selected)
	asserts(c"reopens", reopened != 0 && reopened.error == 0)
	assert_strings_equal(e.document.source, reopened.source)
	assert_equal(e.document.nodes.length, reopened.nodes.length)
	assert_equal(e.document.edges.length, reopened.edges.length)
	mm_scene* scene = mm_render(reopened)
	asserts(c"renders", scene != 0)
	char* svg = mm_svg(scene)
	asserts(c"exports SVG", svg != 0 && index_of(svg, c"<svg") >= 0)
	free(svg)
	mm_scene_free(scene)
	mm_document_free(reopened)
	unlink(path.data)
	string_free(path)

void ef_undo_all(mm_editor* e, char* source):
	while (e.position > 0): assert_equal(1, mm_editor_undo(e, 0))
	assert_strings_equal(source, e.document.source)

void test_requirement_add_connect_kind_move_and_delete():
	char* source = c"requirementDiagram\n%% keep\nrequirement reliable {\n  id: 1\n  text: Orders must be durable\n}\nelement storage {\n  type: database\n}\nstorage - satisfies -> reliable\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(1, mm_editor_add_graph_node(e, c"audit", c""))
	assert_equal(3, e.document.nodes.length)
	assert_equal(1, mm_editor_connect(e, c"audit", c"reliable"))
	assert_equal(2, e.document.edges.length)
	assert_strings_equal(c"traces", e.document.edges[1].label)
	assert_equal(1, mm_editor_edge_kind(e, 1, c"verifies"))
	assert_strings_equal(c"verifies", e.document.edges[1].label)
	asserts(c"relation keyword replaced in place", index_of(e.document.source, c"audit - verifies -> reliable\n") >= 0)
	assert_equal(1, mm_editor_edge_kind(e, 0, c"contains"))
	assert_equal(0, e.document.edges[0].dashed)
	assert_equal(0, mm_editor_edge_kind(e, 0, c"bogus"))
	int storage = ef_find(e, c"storage")
	assert_equal(1, mm_editor_can_move(e, storage))
	assert_equal(1, mm_editor_move_node(e, storage, 500, 300))
	assert_equal(500, e.scene.nodes[ef_find(e, c"storage")].x)
	assert_equal(1, mm_editor_member_set(e, ef_find(e, c"reliable"), 1, c"text: Orders survive restarts"))
	assert_strings_equal(c"text: Orders survive restarts", e.document.nodes[ef_find(e, c"reliable")].members[1].text)
	asserts(c"property edited in place", index_of(e.document.source, c"  text: Orders survive restarts\n") >= 0)
	asserts(c"identifier rename explained", index_of(mm_editor_edit_reason(e, MM_EDIT_LABEL, storage), c"identifiers") >= 0)
	ef_round_trip(e, c"requirement")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"reliable")))
	assert_equal(0, e.document.edges.length)
	asserts(c"relations naming it removed", index_of(e.document.source, c"reliable") < 0 && index_of(e.document.source, c"%% keep\n") >= 0)
	ef_round_trip(e, c"requirement_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_usecase_rename_actor_connect_delete_and_add():
	char* source = c"usecase-beta\nactor Customer\nactor Staff(\"Order staff\")\nCheckout(Place order)\nCustomer --> Checkout\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"Customer"), c"Buyer"))
	assert_strings_equal(c"Buyer", e.document.nodes[ef_find(e, c"Customer")].label)
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"Staff"), c"Clerk"))
	asserts(c"quoted label replaced", index_of(e.document.source, c"actor Staff(\"Clerk\")\n") >= 0)
	assert_equal(1, mm_editor_connect(e, c"Staff", c"Checkout"))
	assert_equal(2, e.document.edges.length)
	assert_equal(1, mm_editor_add_graph_node(e, c"Refund", c"Refund order"))
	assert_strings_equal(c"Refund order", e.document.nodes[ef_find(e, c"Refund")].label)
	assert_equal(1, mm_editor_edge_label(e, 0, c"starts"))
	assert_strings_equal(c"starts", e.document.edges[0].label)
	assert_equal(1, mm_editor_move_node(e, ef_find(e, c"Refund"), 600, 100))
	ef_round_trip(e, c"usecase")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"Checkout")))
	assert_equal(0, e.document.edges.length)
	ef_round_trip(e, c"usecase_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_architecture_rename_connect_add_delete_and_move():
	char* source = c"architecture-beta\ngroup api(cloud)[API]\nservice db(database)[Database] in api\nservice server(server)[Server] in api\nservice edge(internet)[Gateway]\nedge:B --> T:server\nserver:L --> R:db\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"edge"), c"Front door"))
	asserts(c"label in place", index_of(e.document.source, c"service edge(internet)[Front door]\n") >= 0)
	assert_equal(1, mm_editor_add_node_in(e, c"cache", c"Cache", ef_find(e, c"api")))
	assert_equal(ef_find(e, c"api"), e.document.nodes[ef_find(e, c"cache")].parent)
	assert_equal(1, mm_editor_connect(e, c"cache", c"db"))
	assert_equal(3, e.document.edges.length)
	assert_equal(1, mm_editor_delete_edge(e, 0))
	assert_equal(2, e.document.edges.length)
	assert_equal(1, mm_editor_move_node(e, ef_find(e, c"edge"), 40, 400))
	ef_round_trip(e, c"architecture")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"server")))
	assert_equal(-1, ef_find(e, c"server"))
	ef_round_trip(e, c"architecture_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_block_rename_delete_item_connect_and_add():
	char* source = c"block\ncolumns 3\nsource[Source] parser[\"Native parser\"]:2\nspace scene[(\"Display list\")]\nparser --> scene\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(0, mm_editor_can_move(e, ef_find(e, c"parser")))
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"source"), c"Input"))
	asserts(c"label in place", index_of(e.document.source, c"source[Input] parser") >= 0)
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"source")))
	asserts(c"only the item span", index_of(e.document.source, c"\nparser[\"Native parser\"]:2\nspace scene") >= 0)
	assert_equal(1, mm_editor_add_graph_node(e, c"svg", c"SVG"))
	assert_equal(1, mm_editor_connect(e, c"scene", c"svg"))
	assert_equal(2, e.document.edges.length)
	ef_round_trip(e, c"block")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"scene")))
	assert_equal(0, e.document.edges.length)
	asserts(c"space keeps its place", index_of(e.document.source, c"space") >= 0)
	ef_round_trip(e, c"block_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_c4_and_swimlane_structural_edits():
	char* source = c"C4Context\nPerson(user, \"User\", \"Authors diagrams\")\nSystem(app, \"Editor\")\nRel(user, app, \"Edits\")\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"C4 parses", e.document.error == 0)
	assert_equal(0, mm_editor_can_move(e, ef_find(e, c"user")))
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"app"), c"Desktop editor"))
	assert_equal(1, mm_editor_add_graph_node(e, c"store", c"File system"))
	assert_equal(1, mm_editor_connect(e, c"app", c"store"))
	assert_equal(1, mm_editor_edge_label(e, 1, c"Writes"))
	assert_strings_equal(c"Writes", e.document.edges[1].label)
	ef_round_trip(e, c"c4")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"user")))
	assert_equal(1, e.document.edges.length)
	ef_round_trip(e, c"c4_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)
	source = c"swimlane-beta LR\nsubgraph Customer\n  request([Request])\nend\nsubgraph Engineering\n  work[Implement]\nend\nrequest --> work\n"
	e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"swimlane parses", e.document.error == 0)
	assert_equal(1, mm_editor_set_label(e, ef_find(e, c"work"), c"Build"))
	assert_equal(1, mm_editor_add_node_in(e, c"review", c"Review", ef_find(e, c"Customer")))
	assert_equal(1, mm_editor_connect(e, c"work", c"review"))
	assert_equal(1, mm_editor_edge_label(e, 1, c"done"))
	ef_round_trip(e, c"swimlane")
	assert_equal(1, mm_editor_delete_node(e, ef_find(e, c"work")))
	assert_equal(0, e.document.edges.length)
	ef_round_trip(e, c"swimlane_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_mindmap_outline_add_rename_reorder_and_delete():
	char* source = c"mindmap\n  root((Native diagrams))\n    Models\n      Bounded parsing\n    Rendering\n      SVG\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(1, mm_outline_add(e, 1, c"Lossless source", 0))
	assert_strings_equal(c"Lossless source", e.document.nodes[3].label)
	assert_equal(1, e.document.nodes[3].parent)
	assert_equal(1, mm_outline_add(e, 1, c"Editing", 1))
	assert_strings_equal(c"Editing", e.document.nodes[4].label)
	assert_equal(0, e.document.nodes[4].parent)
	assert_equal(0, mm_outline_add(e, 0, c"Second root", 1))
	assert_equal(1, mm_editor_set_label(e, 5, c"Drawing"))
	asserts(c"label in its line", index_of(e.document.source, c"\n    Drawing\n") >= 0)
	assert_equal(1, mm_outline_reorder(e, 5, 1))
	assert_strings_equal(c"Drawing", e.document.nodes[4].label)
	assert_strings_equal(c"SVG", e.document.nodes[5].label)
	assert_equal(4, e.document.nodes[5].parent)
	assert_strings_equal(c"Editing", e.document.nodes[6].label)
	assert_equal(0, mm_editor_delete_node(e, 0))
	ef_round_trip(e, c"mindmap")
	assert_equal(1, mm_editor_delete_node(e, 1))
	assert_equal(4, e.document.nodes.length)
	assert_strings_equal(c"mindmap\n  root((Native diagrams))\n    Drawing\n      SVG\n    Editing\n", e.document.source)
	ef_round_trip(e, c"mindmap_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)

void test_treeview_glyph_outline_edits():
	char* source = c"treeView-beta\nw/\n├── libs/\n│   └── parser.w ## Diagram dispatch\n└── README.md\n"
	mm_editor* e = mm_editor_new(c"bin/unused.mmd", source)
	asserts(c"parses", e.document.error == 0)
	assert_equal(1, mm_outline_add(e, 1, c"render.w", 0))
	assert_equal(1, e.document.nodes[3].parent)
	assert_strings_equal(c"render.w", e.document.nodes[3].label)
	assert_equal(1, mm_outline_add(e, 4, c"LICENSE", 0))
	assert_equal(4, e.document.nodes[5].parent)
	assert_equal(1, mm_editor_set_label(e, 2, c"parse.w"))
	assert_strings_equal(c"Diagram dispatch", e.document.nodes[2].annotation)
	assert_equal(1, mm_outline_reorder(e, 4, 1))
	assert_strings_equal(c"README.md", e.document.nodes[1].label)
	ef_round_trip(e, c"treeview")
	assert_equal(1, mm_editor_delete_node(e, 3))
	assert_equal(3, e.document.nodes.length)
	ef_round_trip(e, c"treeview_deleted")
	ef_undo_all(e, source)
	mm_editor_free(e)
