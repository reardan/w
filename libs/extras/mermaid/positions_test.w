void test_mermaid_class_and_state_positions_persist_and_reset():
	list[char*] sources = list[char*]{c"classDiagram\n%% keep\nAnimal <|-- Duck\nnote for Duck \"quack\"\n", c"stateDiagram-v2\n[*] --> Idle\nIdle --> Busy : go\nnote right of Busy : working\n"}
	list[char*] ids = list[char*]{c"Duck", c"Busy"}
	for i in range(2):
		mm_editor* e = mm_editor_new(c"unused.mmd", sources[i])
		asserts(c"UML parses", e.document.error == 0)
		int node = mm_find_node(e.document, ids[i])
		assert_equal(1, mm_editor_can_move(e, node))
		assert_equal(1, mm_editor_move_node(e, node, 640, 480))
		string_builder* record = string_from(c"%% @w-position \"")
		string_append(record, ids[i])
		string_append(record, c"\" 640 480\n")
		asserts(c"UML position persisted", index_of(e.document.source, record.data) >= 0)
		string_free(record)
		node = mm_find_node(e.document, ids[i])
		assert_equal(640, e.scene.nodes[node].x)
		assert_equal(480, e.scene.nodes[node].y)
		assert_equal(1, mm_editor_has_positions(e))
		assert_equal(1, mm_editor_reset_positions(e))
		assert_strings_equal(sources[i], e.document.source)
		assert_equal(1, mm_editor_undo(e, 0))
		assert_equal(1, mm_editor_undo(e, 0))
		assert_strings_equal(sources[i], e.document.source)
		mm_editor_free(e)
	mm_editor* e = mm_editor_new(c"unused.mmd", c"stateDiagram-v2\nstate Outer {\n[*] --> Inner\n}\n")
	# Composite states and their members move; a composite carries its members.
	int outer = mm_find_node(e.document, c"Outer")
	int inner = mm_find_node(e.document, c"Inner")
	assert_equal(1, mm_editor_can_move(e, outer))
	assert_equal(1, mm_editor_can_move(e, inner))
	int dx = e.scene.nodes[inner].x - e.scene.nodes[outer].x
	int dy = e.scene.nodes[inner].y - e.scene.nodes[outer].y
	assert_equal(1, mm_editor_move_node(e, outer, 700, 500))
	outer = mm_find_node(e.document, c"Outer")
	inner = mm_find_node(e.document, c"Inner")
	assert_equal(700, e.scene.nodes[outer].x)
	assert_equal(700 + dx, e.scene.nodes[inner].x)
	assert_equal(500 + dy, e.scene.nodes[inner].y)
	asserts(c"one group record", index_of(e.document.source, c"%% @w-position \"Outer\" 700 500\n") >= 0 && index_of(e.document.source, c"\"Inner\"") < 0)
	mm_editor_free(e)
	__w_list_free(cast(__w_list*, sources))
	__w_list_free(cast(__w_list*, ids))
