# wbuild: x64
import lib.testing
import libs.extras.mermaid.editor

void test_mermaid_drag_preview_is_transactional_and_reroutes_edges():
	char* source = c"flowchart LR\nA[Alpha] --> B[Beta]\n"
	mm_editor* e = mm_editor_new(c"bin/unused_position.mmd", source)
	mm_document* document = e.document
	mm_scene* scene = e.scene
	mm_bounds* original = scene.nodes[0]
	int x = original.x
	int y = original.y
	int edge_x = scene.items[0].x
	assert_equal(1, mm_editor_move_begin(e, 0))
	for i in range(100): assert_equal(1, mm_editor_move_preview(e, 200 + i, 300 + i))
	assert_equal(cast(int, document), cast(int, e.document))
	assert_equal(cast(int, scene), cast(int, e.scene))
	assert_equal(cast(int, original), cast(int, e.scene.nodes[0]))
	assert_equal(299, e.scene.nodes[0].x)
	assert_equal(399, e.scene.nodes[0].y)
	asserts(c"edge follows moving source endpoint", e.scene.items[0].x != edge_x)
	assert_strings_equal(source, e.document.source)
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(1, e.history.length)
	assert_equal(1, mm_editor_move_commit(e))
	assert_equal(2, e.history.length)
	assert_equal(0, e.moving)
	assert_equal(1, mm_editor_dirty(e))
	asserts(c"position persisted in ordinary Mermaid comment", index_of(e.document.source, c"%% @w-position \"A\" 299 399\n") >= 0)
	assert_equal(299, e.scene.nodes[0].x)
	assert_equal(399, e.scene.nodes[0].y)
	assert_equal(1, mm_editor_undo(e, 0))
	assert_equal(x, e.scene.nodes[0].x)
	assert_equal(y, e.scene.nodes[0].y)
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(1, mm_editor_undo(e, 1))
	assert_equal(299, e.scene.nodes[0].x)
	assert_equal(399, e.scene.nodes[0].y)
	mm_editor_free(e)

void test_mermaid_drag_cancel_and_noop_leave_no_history():
	mm_editor* e = mm_editor_new(c"unused.mmd", c"flowchart TD\nA --> B\n")
	char* before = mm_svg(e.scene)
	int x = e.scene.nodes[1].x
	int y = e.scene.nodes[1].y
	assert_equal(1, mm_editor_move_begin(e, 1))
	assert_equal(1, mm_editor_move_preview(e, 500, 450))
	mm_editor_move_cancel(e)
	char* after = mm_svg(e.scene)
	assert_strings_equal(before, after)
	free(after)
	assert_equal(1, e.history.length)
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(0, mm_editor_move_commit(e))
	assert_equal(1, mm_editor_move_node(e, 1, x, y))
	assert_equal(1, e.history.length)
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(1, mm_editor_move_begin(e, 1))
	assert_equal(1, mm_editor_move_preview(e, 700, 550))
	assert_equal(1, mm_editor_move_preview(e, x, y))
	assert_equal(1, mm_editor_move_commit(e))
	assert_equal(1, e.history.length)
	assert_equal(0, mm_editor_dirty(e))
	free(before)
	mm_editor_free(e)

void test_mermaid_position_selected_fence_preserves_envelope_and_crlf():
	char* source = c"# Header\r\n```mermaid\r\nflowchart LR\r\nA\r\n```\r\nBetween\r\n~~~mermaid\r\nflowchart TD\r\nA --> B\r\n~~~\r\nAfter\r\n"
	mm_editor* e = mm_editor_new(c"unused.md", source)
	assert_equal(1, mm_editor_select(e, 1))
	assert_equal(1, mm_editor_move_node(e, 0, 400, 500))
	assert_strings_equal(c"# Header\r\n```mermaid\r\nflowchart LR\r\nA\r\n```\r\nBetween\r\n~~~mermaid\r\nflowchart TD\r\nA --> B\r\n%% @w-position \"A\" 400 500\r\n~~~\r\nAfter\r\n", e.document.source)
	assert_equal(1, mm_editor_move_begin(e, 0))
	assert_equal(1, mm_editor_move_preview(e, 800, 900))
	assert_equal(1, mm_editor_select(e, 0))
	assert_equal(0, e.moving)
	assert_equal(2, e.history.length)
	assert_equal(60, e.scene.nodes[0].x)
	assert_equal(1, mm_editor_select(e, 1))
	assert_equal(400, e.scene.nodes[0].x)
	assert_equal(500, e.scene.nodes[0].y)
	assert_equal(1, mm_editor_undo(e, 0))
	assert_strings_equal(source, e.document.source)
	mm_editor_free(e)

void test_mermaid_position_save_reopen_and_svg_share_geometry():
	char* path = c"bin/mermaid_position_saved.mmd"
	unlink(path)
	mm_editor* e = mm_editor_new(path, c"erDiagram\nCUSTOMER ||--o{ ORDER : places\n")
	assert_equal(1, mm_editor_move_node(e, 0, 600, 220))
	assert_equal(0, mm_editor_hit(e, 610, 230))
	assert_equal(1, mm_editor_save(e))
	assert_equal(0, mm_editor_dirty(e))
	mm_editor* reopened = mm_editor_open(path)
	asserts(c"reopen", reopened != 0)
	assert_equal(600, reopened.scene.nodes[0].x)
	assert_equal(220, reopened.scene.nodes[0].y)
	char* expected = mm_svg(e.scene)
	char* actual = mm_svg(reopened.scene)
	assert_strings_equal(expected, actual)
	asserts(c"exported entity keeps its position", index_of(actual, c"x=\"600\" y=\"220\"") >= 0)
	free(expected)
	free(actual)
	mm_editor_free(reopened)
	mm_editor_free(e)
	unlink(path)

void test_mermaid_positions_ignore_malformed_and_out_of_range_metadata():
	mm_editor* e = mm_editor_new(c"unused.mmd", c"flowchart LR\nA --> B\n%% @w-position A 220 330\n%% @w-position A -1 20\n%% @w-position A 999999999999999999999 20\n%% @w-position A 2 3 trailing\n%% @w-position A 10\n%% @w-position \"A 8 9\n%% @w-position Missing 5 6\n%% @w-position A 100001 2\n")
	asserts(c"malformed comments remain legal Mermaid", e.document.error == 0)
	assert_equal(220, e.scene.nodes[0].x)
	assert_equal(330, e.scene.nodes[0].y)
	assert_equal(0, mm_editor_move_node(e, 0, -1, 0))
	assert_equal(0, mm_editor_move_node(e, 0, 0, -1))
	assert_equal(0, mm_editor_move_node(e, 0, 100001, 0))
	assert_equal(0, mm_editor_move_node(e, 0, 0, 100001))
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(1, mm_editor_move_node(e, 0, 100000, 100000))
	assert_equal(100000, e.scene.nodes[0].x)
	assert_equal(100000, e.scene.nodes[0].y)
	asserts(c"malformed metadata preserved verbatim", index_of(e.document.source, c"%% @w-position A -1 20\n") >= 0)
	mm_editor_free(e)

void test_mermaid_positions_coalesce_duplicates_and_support_quoted_ids():
	mm_editor* e = mm_editor_new(c"unused.mmd", c"erDiagram\n\"Customer records\"\n%% @w-position \"Customer records\" 100 200\n%% @w-position \"Customer records\" 300 400\n%% ordinary comment\n")
	asserts(c"quoted entity parses", e.document.error == 0)
	assert_equal(300, e.scene.nodes[0].x)
	assert_equal(400, e.scene.nodes[0].y)
	assert_equal(1, mm_editor_move_node(e, 0, 500, 600))
	assert_strings_equal(c"erDiagram\n\"Customer records\"\n%% ordinary comment\n%% @w-position \"Customer records\" 500 600\n", e.document.source)
	mm_editor_free(e)

void test_mermaid_positions_title_gutter_and_styles_survive_refresh():
	mm_editor* e = mm_editor_new(c"unused.mmd", c"---\ntitle: Diagram title\n---\nflowchart LR\nA --> B\nstyle A fill:#ff0000\n")
	asserts(c"title parses", e.document.error == 0)
	char* initial = mm_svg(e.scene)
	assert_equal(1, mm_editor_move_begin(e, 0))
	assert_equal(0, mm_editor_move_preview(e, 50, 39))
	assert_equal(1, mm_editor_move_preview(e, 500, 340))
	char* preview = mm_svg(e.scene)
	asserts(c"style preserved", index_of(preview, c"#ff0000") >= 0)
	assert_equal(1, mm_editor_move_commit(e))
	assert_equal(500, e.scene.nodes[0].x)
	assert_equal(340, e.scene.nodes[0].y)
	asserts(c"title offset is excluded from stored layout coordinate", index_of(e.document.source, c"500 300\n") >= 0)
	char* committed = mm_svg(e.scene)
	assert_strings_equal(preview, committed)
	assert_equal(1, mm_editor_undo(e, 0))
	char* restored = mm_svg(e.scene)
	assert_strings_equal(initial, restored)
	free(initial)
	free(preview)
	free(committed)
	free(restored)
	mm_editor_free(e)

void test_mermaid_move_groups_nested_and_resets_stale_gestures():
	mm_editor* e = mm_editor_new(c"unused.mmd", c"flowchart TD\nsubgraph Group\nA\nend\nB\n%% @w-position A 500 600\n")
	asserts(c"group parses", e.document.error == 0)
	int group = mm_find_node(e.document, c"Group")
	int nested = mm_find_node(e.document, c"A")
	int top = mm_find_node(e.document, c"B")
	assert_equal(1, mm_editor_can_move(e, group))
	assert_equal(1, mm_editor_can_move(e, nested))
	assert_equal(0, mm_editor_move_begin(e, -1))
	assert_equal(0, mm_editor_move_begin(e, 100))
	# A nested record places the member; its group grows to keep enclosing it.
	assert_equal(500, e.scene.nodes[nested].x)
	assert_equal(600, e.scene.nodes[nested].y)
	mm_bounds* box = e.scene.nodes[group]
	asserts(c"group encloses moved member", box.x + box.w >= 500 + e.scene.nodes[nested].w && box.y + box.h >= 600 + e.scene.nodes[nested].h)
	assert_equal(1, mm_editor_move_begin(e, top))
	assert_equal(1, mm_editor_move_preview(e, 400, 500))
	assert_equal(1, mm_editor_change(e, c"flowchart LR\nDifferent\n"))
	assert_equal(0, e.moving)
	assert_equal(0, mm_editor_move_preview(e, 300, 400))
	assert_equal(0, mm_editor_move_commit(e))
	assert_equal(1, mm_editor_move_begin(e, 0))
	assert_equal(1, mm_editor_move_preview(e, 300, 400))
	assert_equal(1, mm_editor_undo(e, 0))
	assert_equal(0, e.moving)
	assert_equal(0, mm_editor_move_commit(e))
	mm_editor_change(e, c"classDiagram\nnamespace N {\nclass A\n}\n")
	assert_equal(1, mm_editor_can_move(e, mm_find_node(e.document, c"N")))
	assert_equal(1, mm_editor_can_move(e, mm_find_node(e.document, c"A")))
	mm_editor_change(e, c"pie\n\"A\" : 1\n")
	assert_equal(0, mm_editor_can_move(e, 0))
	mm_editor_change(e, c"mindmap\n  root\n    child\n")
	assert_equal(0, mm_editor_can_move(e, 1))
	mm_editor_free(e)

void test_mermaid_position_comments_cannot_execute_accessibility_text():
	char* source = c"```mermaid\nflowchart LR\nA --> B\naccDescr {\n%% @w-position A 900 800\n%% @w-position \"A\" 700 600\n}\n%% @w-position A 120 130\n```\n"
	mm_editor* e = mm_editor_new(c"unused.md", source)
	asserts(c"description block parses", e.document.error == 0)
	assert_equal(120, e.scene.nodes[0].x)
	assert_equal(130, e.scene.nodes[0].y)
	assert_equal(1, mm_editor_move_node(e, 0, 200, 300))
	asserts(c"description bytes are never removed as metadata", index_of(e.document.source, c"accDescr {\n%% @w-position A 900 800\n%% @w-position \"A\" 700 600\n}\n") >= 0)
	assert_strings_equal(c"\n%% @w-position A 900 800\n%% @w-position \"A\" 700 600", e.document.accessibility_description)
	assert_equal(200, e.scene.nodes[0].x)
	assert_equal(300, e.scene.nodes[0].y)
	assert_equal(1, mm_editor_undo(e, 0))
	assert_strings_equal(source, e.document.source)
	mm_editor_free(e)
	# Without any actual comment command, description text cannot change layout.
	e = mm_editor_new(c"unused.mmd", c"flowchart LR\nA --> B\naccDescr {\n%% @w-position A 900 800\n}\n")
	assert_equal(60, e.scene.nodes[0].x)
	assert_equal(60, e.scene.nodes[0].y)
	mm_editor_free(e)

void test_mermaid_auto_layout_is_undoable_and_preserves_other_source():
	char* path = c"bin/mermaid_position_reset.md"
	unlink(path)
	char* source = c"# Notes\n```mermaid\nflowchart LR\nA\n%% @w-position A 700 800\n```\n~~~mermaid\r\nflowchart LR\r\nA --> B\r\naccDescr {\r\n%% @w-position A 800 900\r\n}\r\n%% User comment\r\n%% @w-position A invalid 900\r\n%% @w-position A 400 500\r\n%% @w-position \"B\" 600 700\r\n~~~\r\nAfter\n"
	mm_editor* e = mm_editor_new(path, source)
	assert_equal(1, mm_editor_select(e, 1))
	assert_equal(1, mm_editor_has_positions(e))
	assert_equal(400, e.scene.nodes[0].x)
	assert_equal(1, mm_editor_save(e))
	assert_equal(1, mm_editor_reset_positions(e))
	assert_equal(0, mm_editor_has_positions(e))
	assert_equal(2, e.history.length)
	assert_equal(1, mm_editor_dirty(e))
	assert_equal(60, e.scene.nodes[0].x)
	assert_equal(60, e.scene.nodes[0].y)
	assert_strings_equal(c"# Notes\n```mermaid\nflowchart LR\nA\n%% @w-position A 700 800\n```\n~~~mermaid\r\nflowchart LR\r\nA --> B\r\naccDescr {\r\n%% @w-position A 800 900\r\n}\r\n%% User comment\r\n%% @w-position A invalid 900\r\n~~~\r\nAfter\n", e.document.source)
	assert_equal(1, mm_editor_reset_positions(e))
	assert_equal(2, e.history.length)
	assert_equal(1, mm_editor_undo(e, 0))
	assert_equal(0, mm_editor_dirty(e))
	assert_equal(1, mm_editor_has_positions(e))
	assert_strings_equal(source, e.document.source)
	assert_equal(400, e.scene.nodes[0].x)
	assert_equal(1, mm_editor_undo(e, 1))
	assert_equal(1, mm_editor_save(e))
	mm_document* reopened = mm_read_selected(path, 1)
	asserts(c"reset source reopens", reopened != 0 && reopened.error == 0)
	mm_scene* scene = mm_render(reopened)
	assert_equal(60, scene.nodes[0].x)
	mm_scene_free(scene)
	mm_document_free(reopened)
	mm_editor_free(e)
	unlink(path)

