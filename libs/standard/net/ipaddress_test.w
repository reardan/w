void append_flag(string_builder* out, int value):
	if (value): string_append_char(out, '1')
	else: string_append_char(out, '0')


void append_owned(string_builder* out, char* text):
	string_append(out, text)
	free(text)


char* finish(string_builder* out):
	char* text = out.data
	free(out)
	return text


char* describe_address(char* input):
	ip_address a
	if (ip_address_parse(input, &a) == 0): return strclone(c"!")
	string_builder* out = string_new()
	append_owned(out, ip_address_format(&a))
	string_append_char(out, '|')
	append_owned(out, ip_address_exploded(&a))
	string_append_char(out, '|')
	append_flag(out, ip_address_is_private(&a))
	append_flag(out, ip_address_is_global(&a))
	append_flag(out, ip_address_is_loopback(&a))
	append_flag(out, ip_address_is_link_local(&a))
	append_flag(out, ip_address_is_multicast(&a))
	append_flag(out, ip_address_is_unspecified(&a))
	append_flag(out, ip_address_is_reserved(&a))
	append_flag(out, ip_address_is_site_local(&a))
	return finish(out)


void append_address(string_builder* out, ip_address* a):
	append_owned(out, ip_address_format(a))


char* describe_network(char* input, int strict):
	ip_network n
	if (ip_network_parse(input, strict, &n) == 0): return strclone(c"!")
	string_builder* out = string_new()
	append_owned(out, ip_network_format(&n))
	ip_address a
	string_append_char(out, '|')
	ip_network_netmask(&n, &a)
	append_address(out, &a)
	string_append_char(out, '|')
	ip_network_hostmask(&n, &a)
	append_address(out, &a)
	string_append_char(out, '|')
	ip_network_broadcast(&n, &a)
	append_address(out, &a)
	string_append_char(out, '|')
	append_owned(out, ip_network_with_netmask(&n))
	string_append_char(out, '|')
	append_owned(out, ip_network_with_hostmask(&n))
	string_append_char(out, '|')
	append_owned(out, ip_network_num_addresses_text(&n))
	string_append_char(out, '|')
	append_flag(out, ip_network_is_private(&n))
	append_flag(out, ip_network_is_global(&n))
	append_flag(out, ip_network_is_loopback(&n))
	append_flag(out, ip_network_is_link_local(&n))
	append_flag(out, ip_network_is_multicast(&n))
	append_flag(out, ip_network_is_unspecified(&n))
	append_flag(out, ip_network_is_reserved(&n))
	append_flag(out, ip_network_is_site_local(&n))
	return finish(out)


ip_network must_network(char* text):
	ip_network n
	asserts(text, ip_network_parse(text, 1, &n))
	return n


void append_iteration(string_builder* out, ip_address_iterator* it):
	ip_address a
	int first = 1
	while (ip_address_iterator_next(it, &a)):
		if (first == 0): string_append_char(out, ',')
		first = 0
		append_address(out, &a)


void check_table(list[char*] inputs, list[char*] expected, list[char*] actual):
	assert_equal(inputs.length, expected.length)
	for i in range(inputs.length):
		if (strcmp(expected[i], actual[i]) != 0):
			print(c"input: ")
			println(inputs[i])
		assert_strings_equal(expected[i], actual[i])
		free(actual[i])
	inputs.free()
	expected.free()
	actual.free()


