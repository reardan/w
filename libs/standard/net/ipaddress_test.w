void test_subnets():
	list[char*] inputs = gen_subnet_networks()
	list[int] prefixes = gen_subnet_prefixes()
	list[char*] actual = list[char*]{}
	for i in range(inputs.length):
		ip_network n = must_network(inputs[i])
		int fits = 0
		int count = ip_network_subnet_count(&n, prefixes[i], &fits)
		if (count == 0 && fits):
			asserts(c"subnet_at on a bad prefix", ip_network_subnet_at(&n, prefixes[i], 0, &n) == 0)
			actual.push(strclone(c"!"))
			continue
		string_builder* out = string_new()
		ip_network s
		# Decimal count from the subnet-sized network math.
		ip_network block
		ip_network_make(&n.address, ip_max_prefixlen(n.address.version) - (prefixes[i] - n.prefixlen), 0, &block)
		append_owned(out, ip_network_num_addresses_text(&block))
		if (fits == 0): asserts(c"count overflow means a huge count", prefixes[i] - n.prefixlen > sizeof(int) * 8 - 2)
		else: assert_equal(count, 1 << (prefixes[i] - n.prefixlen))
		string_append_char(out, '|')
		asserts(c"first subnet", ip_network_subnet_at(&n, prefixes[i], 0, &s))
		append_owned(out, ip_network_format(&s))
		string_append_char(out, '|')
		if (ip_network_subnet_at(&n, prefixes[i], 1, &s)): append_owned(out, ip_network_format(&s))
		else: string_append_char(out, '-')
		string_append_char(out, '|')
		if (fits): asserts(c"last subnet", ip_network_subnet_at(&n, prefixes[i], count - 1, &s))
		else:
			# Too many subnets to index from the start; take the subnet
			# holding the broadcast address instead.
			ip_address last
			ip_network_broadcast(&n, &last)
			ip_network_make(&last, prefixes[i], 0, &s)
		append_owned(out, ip_network_format(&s))
		if (fits): asserts(c"one past the end", ip_network_subnet_at(&n, prefixes[i], count, &s) == 0)
		actual.push(finish(out))
	prefixes.free()
	check_table(inputs, gen_subnet_expected(), actual)


