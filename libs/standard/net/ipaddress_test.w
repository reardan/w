void test_compare_and_versions():
	ip_address a
	ip_address b
	ip_address_parse(c"255.255.255.255", &a)
	ip_address_parse(c"::", &b)
	assert_equal(4, a.version)
	assert_equal(6, b.version)
	assert_equal(-1, ip_address_compare(&a, &b))
	assert_equal(1, ip_address_compare(&b, &a))
	ip_address_parse(c"::ffff:255.255.255.255", &b)
	assert_equal(0, ip_address_equal(&a, &b))
	ip_address_parse(c"10.0.0.2", &b)
	ip_address_parse(c"10.0.0.10", &a)
	assert_equal(-1, ip_address_compare(&b, &a))
	ip_address_parse(c"2001:db8::1", &a)
	ip_address_parse(c"2001:DB8:0::01", &b)
	assert_equal(1, ip_address_equal(&a, &b))
	assert_equal(32, ip_max_prefixlen(4))
	assert_equal(128, ip_max_prefixlen(6))
	asserts(c"v4-only parser", ipv4_address_parse(c"::1", &a) == 0)
	asserts(c"v6-only parser", ipv6_address_parse(c"1.2.3.4", &a) == 0)
	asserts(c"null text", ip_address_parse(0, &a) == 0)
	ip_network n
	asserts(c"v4 network parser", ipv4_network_parse(c"::/0", 1, &n) == 0)
	asserts(c"v6 network parser", ipv6_network_parse(c"0.0.0.0/0", 1, &n) == 0)
	asserts(c"v6 netmask form", ipv6_network_parse(c"::/ffff::", 1, &n) == 0)
	asserts(c"make rejects 33", ip_network_make(&b, 129, 0, &n) == 0)
	asserts(c"make strict", ip_network_make(&b, 64, 1, &n) == 0)
	asserts(c"make loose", ip_network_make(&b, 64, 0, &n))
	char* text = ip_network_format(&n)
	assert_strings_equal(c"2001:db8::/64", text)
	free(text)


void test_ranges():
	# Ranges that slice into a larger string, as urlparse uses them.
	ip_address a
	char* text = c"[2001:db8::1]:443"
	asserts(c"bracketed v6", ipv6_parse_range(text, 1, 12, &a))
	char* hex = ipv6_format_hex(&a)
	assert_strings_equal(c"2001:db8::1", hex)
	free(hex)
	asserts(c"range excludes bracket", ipv6_parse_range(text, 0, 12, &a) == 0)
	asserts(c"v4 range", ipv4_parse_range(c"x10.0.0.1y", 1, 9, &a))
	char* s = ip_address_format(&a)
	assert_strings_equal(c"10.0.0.1", s)
	free(s)
	asserts(c"empty range", ipv4_parse_range(c"1.2.3.4", 3, 3, &a) == 0)
	ip_address_parse(c"::ffff:192.0.2.128", &a)
	hex = ipv6_format_hex(&a)
	assert_strings_equal(c"::ffff:c000:280", hex)
	free(hex)
	s = ip_address_format(&a)
	assert_strings_equal(c"::ffff:192.0.2.128", s)
	free(s)


void test_packed_and_ints():
	ip_address a
	ip_address b
	ip_address_parse(c"192.0.2.1", &a)
	char[16] raw
	ip_address_packed(&a, raw)
	assert_equal(192, raw[0] & 255)
	assert_equal(1, raw[3] & 255)
	asserts(c"from packed v4", ip_address_from_packed(raw, 4, &b))
	assert_equal(1, ip_address_equal(&a, &b))
	asserts(c"bad packed length", ip_address_from_packed(raw, 5, &b) == 0)
	ip_address_parse(c"2001:db8::ff00:42:8329", &a)
	ip_address_packed(&a, raw)
	assert_equal(32, raw[0] & 255)
	assert_equal(1, raw[1] & 255)
	assert_equal(41, raw[15] & 255)
	asserts(c"from packed v6", ip_address_from_packed(raw, 16, &b))
	assert_equal(1, ip_address_equal(&a, &b))
	# 32-bit patterns round-trip on both word sizes.
	int value = 0
	asserts(c"ipv4_parse", ipv4_parse(c"255.255.255.254", &value))
	char* s = ipv4_format(value)
	assert_strings_equal(c"255.255.255.254", s)
	free(s)
	ip_address_from_ipv4_int(value, &a)
	assert_equal(value, ip_address_to_ipv4_int(&a))
	asserts(c"ipv4_parse rejects", ipv4_parse(c"1.2.3.04", &value) == 0)
	int net = 0
	int host = 0
	ipv4_parse(c"192.168.0.0", &net)
	ipv4_parse(c"192.168.255.7", &host)
	assert_equal(1, ipv4_in_network(host, net, 16))
	assert_equal(0, ipv4_in_network(host, net, 17))
	assert_equal(1, ipv4_in_network(host, net, 0))
	assert_equal(0, ipv4_in_network(host, net, 33))
	ipv4_parse(c"255.255.255.255", &host)
	assert_equal(1, ipv4_in_network(host, host, 32))


void test_embedded_ipv4():
	ip_address a
	ip_address b
	ip_address c
	char* s
	ip_address_parse(c"::ffff:10.1.2.3", &a)
	asserts(c"mapped", ipv6_ipv4_mapped(&a, &b))
	s = ip_address_format(&b)
	assert_strings_equal(c"10.1.2.3", s)
	free(s)
	ipv4_to_ipv6_mapped(&b, &c)
	assert_equal(1, ip_address_equal(&a, &c))
	ip_address_parse(c"::10.1.2.3", &a)
	asserts(c"compat is not mapped", ipv6_ipv4_mapped(&a, &b) == 0)
	ip_address_parse(c"2002:c000:0204::1", &a)
	asserts(c"6to4", ipv6_sixtofour(&a, &b))
	s = ip_address_format(&b)
	assert_strings_equal(c"192.0.2.4", s)
	free(s)
	asserts(c"not 6to4", ipv6_sixtofour(&b, &c) == 0)
	ip_address_parse(c"2001:0000:4136:e378:8000:63bf:3fff:fdd2", &a)
	asserts(c"teredo", ipv6_teredo(&a, &b, &c))
	s = ip_address_format(&b)
	assert_strings_equal(c"65.54.227.120", s)
	free(s)
	s = ip_address_format(&c)
	assert_strings_equal(c"192.0.2.45", s)
	free(s)
	ip_address_parse(c"2001:db8::1", &a)
	asserts(c"not teredo", ipv6_teredo(&a, &b, &c) == 0)


void test_num_addresses_fits():
	ip_network n = must_network(c"10.0.0.0/8")
	int fits = 0
	assert_equal(16777216, ip_network_num_addresses(&n, &fits))
	assert_equal(1, fits)
	assert_equal(24, ip_network_host_bits(&n))
	n = must_network(c"0.0.0.0/0")
	int count = ip_network_num_addresses(&n, &fits)
	if (sizeof(int) == 4):
		assert_equal(0, fits)
		assert_equal(0, count)
	else:
		assert_equal(1, fits)
		assert_equal(1 << 32, count)
	n = must_network(c"::/0")
	assert_equal(0, ip_network_num_addresses(&n, &fits))
	assert_equal(0, fits)
	assert_equal(128, ip_network_host_bits(&n))
	char* text = ip_network_num_addresses_text(&n)
	assert_strings_equal(c"340282366920938463463374607431768211456", text)
	free(text)
	n = must_network(c"2001:db8::/120")
	assert_equal(256, ip_network_num_addresses(&n, &fits))
	assert_equal(1, fits)


void test_hosts_iteration_is_bounded():
	# Iterating a huge network touches only what the caller pulls.
	ip_network n = must_network(c"::/0")
	ip_address_iterator it
	ip_network_hosts(&n, &it)
	ip_address a
	for i in range(3): asserts(c"next", ip_address_iterator_next(&it, &a))
	char* s = ip_address_format(&a)
	assert_strings_equal(c"::3", s)
	free(s)
	n = must_network(c"10.0.0.0/31")
	ip_network_hosts(&n, &it)
	int count = 0
	while (ip_address_iterator_next(&it, &a)): count += 1
	assert_equal(2, count)
	asserts(c"drained", ip_address_iterator_next(&it, &a) == 0)
