# wbuild: arch_only=x64
# wbuild: target=orm_migrate_writer_roundtrip_test tag=tests_x64 dep=orm_migrate_writer_test data=tests/orm/migrations/library_m0001_initial.golden
# wbuild: step="bin/wv2 x64 bin/orm_migrate_writer_out/roundtrip_main.w -o bin/orm_migrate_writer_roundtrip"
# wbuild: step="bin/orm_migrate_writer_roundtrip" expect_stdout="orm_migrate_writer_roundtrip: 9 migrations ok"
# wbuild: step="cmp bin/orm_migrate_writer_out/library/m0001_initial.w tests/orm/migrations/library_m0001_initial.golden"
# U2.2: the writer emits one reviewable W module per migration plus an
# append-only index module. This test writes the library app's initial
# migration and a follow-up plan under bin/orm_migrate_writer_out/ and a
# small program that imports them; the orm_migrate_writer_roundtrip_test
# target compiles and runs that program (replaying the generated
# migrations must reproduce the state computed here and leave no diff
# against the snapshot) and compares the initial migration with
# tests/orm/migrations/library_m0001_initial.golden.
import libs.standard.orm.migrate.writer
import libs.standard.orm.migrate.autodetect
import tests.orm.generated.library_orm
import lib.assert
import lib.file


char* OUT():
	return c"bin/orm_migrate_writer_out"


char* DIR():
	return c"bin/orm_migrate_writer_out/library"


char* PREFIX():
	return c"bin.orm_migrate_writer_out.library"


void test_ident():
	assert_strings_equal(c"m0001_initial", orm_writer_ident(c"0001_initial"))
	assert_strings_equal(c"m0002_expand_a_b_c", orm_writer_ident(c"0002_expand_a.b-c"))


void test_migration_source():
	orm_migration* m = orm_migration_new(c"shop", c"0003_contract_order_note")
	m.dependencies.push(c"shop.0002_migrate_order_note")
	m.requires_applied = c"0001_expand_order_note"
	m.phase = ORM_PHASE_CONTRACT
	orm_op* a = orm_op_new(ORM_OP_ALTER_NULL, ORM_PHASE_CONTRACT, c"shop_order")
	a.column = c"note"
	a.field_json = c"{\"column\": \"note\", \"null\": false}"
	orm_migration_add(m, a)
	orm_op* b = orm_op_new(ORM_OP_COPY_COLUMN, ORM_PHASE_MIGRATE, c"shop_order")
	b.column = c"note2"
	b.source_column = c"note"
	b.non_atomic = 1
	b.batch_size = 250
	orm_migration_add(m, b)
	orm_op* r = orm_op_new(ORM_OP_RAW_SQL, ORM_PHASE_CONTRACT, 0)
	r.sql = c"UPDATE t SET a = 'x\"y'\n\t-- done"
	r.reverse_sql = c"SELECT 1"
	r.unsafe = 1
	r.dialects = ORM_OP_ON_POSTGRES
	orm_migration_add(m, r)
	m.atomic = 1
	char* want = c"# Generated by w-orm makemigrations (libs/standard/orm/migrate/writer.w).\n# Migration shop.0003_contract_order_note: review it, then commit it. makemigrations never\n# rewrites it; later schema changes become new migrations.\nimport libs.standard.orm.contract\n\n\norm_migration* shop_m0003_contract_order_note():\n\torm_migration* m = orm_migration_new(c\"shop\", c\"0003_contract_order_note\")\n\tm.dependencies.push(c\"shop.0002_migrate_order_note\")\n\tm.requires_applied = c\"0001_expand_order_note\"\n\tm.phase = ORM_PHASE_CONTRACT\n\torm_op* op = 0\n\n\t# contract ALTER_NULL shop_order.note\n\top = orm_op_new(ORM_OP_ALTER_NULL, ORM_PHASE_CONTRACT, c\"shop_order\")\n\top.column = c\"note\"\n\top.field_json = c\"{\\\"column\\\": \\\"note\\\", \\\"null\\\": false}\"\n\torm_migration_add(m, op)\n\n\t# migrate COPY_COLUMN shop_order.note2\n\top = orm_op_new(ORM_OP_COPY_COLUMN, ORM_PHASE_MIGRATE, c\"shop_order\")\n\top.column = c\"note2\"\n\top.source_column = c\"note\"\n\top.non_atomic = 1\n\top.batch_size = 250\n\torm_migration_add(m, op)\n\n\t# contract RAW_SQL\n\top = orm_op_new(ORM_OP_RAW_SQL, ORM_PHASE_CONTRACT, 0)\n\top.sql = c\"UPDATE t SET a = 'x\\\"y'\\n\\t-- done\"\n\top.reverse_sql = c\"SELECT 1\"\n\top.unsafe = 1\n\top.dialects = ORM_OP_ON_POSTGRES\n\torm_migration_add(m, op)\n\n\tm.atomic = 1\n\treturn m\n"
	assert_strings_equal(want, orm_writer_migration_source(c"shop", m))


void remove_files(char* dir, list[orm_migration*] ms, char* app):
	for orm_migration* m in ms:
		char* id = orm_writer_ident(m.name)
		char* p = orm_writer_path(dir, id, c".w")
		unlink(p)
		free(p)
		free(id)
	char* index = orm_concat3(dir, c"/", orm_concat3(app, c"_migrations.w", c""))
	unlink(index)


# The follow-up schema: a nullable column, a column rename, a dropped
# column and history on Tag.
char* next_snapshot():
	json_value* s = json_parse(library_schema_json())
	json_value* models = orm_sj_array(s, c"models")
	for json_value* m in models.array_values:
		char* name = orm_sj_str(m, c"name")
		json_value* fields = orm_sj_array(m, c"fields")
		if (strcmp(name, c"Tag") == 0):
			orm_sj_set_bool(m, c"history", 1)
			json_value* src = json_object()
			orm_sj_set_str(src, c"name", c"note")
			orm_sj_set_str(src, c"column", c"note")
			json_object_set(src, c"kind", json_int(ORM_TEXT))
			orm_sj_set_bool(src, c"null", 1)
			json_array_push(fields, orm_state_field_normalize(src))
			json_free(src)
		if (strcmp(name, c"Book") == 0):
			for i in range(fields.array_values.length):
				json_value* f = fields.array_values[i]
				if (strcmp(orm_sj_str(f, c"name"), c"title") == 0):
					orm_sj_set_str(f, c"name", c"headline")
					orm_sj_set_str(f, c"column", c"headline")
			for j in range(fields.array_values.length):
				if (strcmp(orm_sj_str(fields.array_values[j], c"name"), c"pages") == 0):
					json_free(orm_sj_array_take(fields, j))
					break
	char* out = json_stringify(s)
	json_free(s)
	return out


char* ROUNDTRIP_MAIN():
	return c"# Generated by orm_migrate_writer_test: replays the generated library\n# migrations and compares them with what the test computed in memory.\nimport libs.standard.orm.migrate.autodetect\nimport bin.orm_migrate_writer_out.library.library_migrations\nimport lib.assert\nimport lib.file\n\n\nint main():\n\tlist[orm_migration*] ms = library_migrations()\n\tassert_strings_equal(file_read_text(c\"bin/orm_migrate_writer_out/expected_plan.txt\"), orm_plan_describe(ms))\n\torm_state* st = orm_state_from_migrations(c\"library\", ms)\n\tasserts(st.error, st.error == 0)\n\tchar* state = orm_state_to_json(st)\n\tassert_strings_equal(file_read_text(c\"bin/orm_migrate_writer_out/expected_state.json\"), state)\n\torm_detect* d = orm_autodetect(state, file_read_text(c\"bin/orm_migrate_writer_out/snapshot.json\"), 0)\n\tassert_strings_equal(c\"\", orm_detect_describe(d))\n\tlist[orm_lint_finding*] findings = orm_lint_plan(ms, ORM_DIALECT_POSTGRES)\n\tassert_strings_equal(c\"\", orm_lint_format(findings))\n\tprint(c\"orm_migrate_writer_roundtrip: \")\n\tprint(itoa(ms.length))\n\tprint(c\" migrations ok\\n\")\n\treturn 0\n"


void write_text(char* path, char* text):
	asserts(path, file_write_text(path, text) != 0)


void test_write_round_trip():
	char* lib = library_schema_json()
	orm_makemig* init = orm_makemigrations(c"library", c"", lib, ORM_DIALECT_POSTGRES, 1, 0, 0)
	asserts(init.error, init.error == 0)
	char* next = next_snapshot()
	list[char*] hints = new list[char*]
	hints.push(c"Book.title->headline")
	orm_makemig* r = orm_makemigrations_next(c"library", init.migrations, next, ORM_DIALECT_POSTGRES, hints)
	asserts(r.error, r.error == 0)
	list[orm_migration*] all = new list[orm_migration*]
	for orm_migration* a in init.migrations: all.push(a)
	for orm_migration* b in r.migrations: all.push(b)
	remove_files(DIR(), all, c"library")
	char* error = 0
	# First the initial migration alone, then again: nothing new to write.
	assert_equal(1, orm_write_migrations(DIR(), PREFIX(), c"library", init.migrations, &error))
	assert_equal(0, orm_write_migrations(DIR(), PREFIX(), c"library", init.migrations, &error))
	char* index1 = file_read_text(c"bin/orm_migrate_writer_out/library/library_migrations.w")
	assert_contains(index1, c"import bin.orm_migrate_writer_out.library.m0001_initial\n")
	assert_contains(index1, c"list[orm_migration*] library_migrations():\n\tlist[orm_migration*] l = new list[orm_migration*]\n\tl.push(library_m0001_initial())\n\treturn l\n")
	# Then the follow-up plan: only its modules are new; the index appends.
	assert_equal(r.migrations.length, orm_write_migrations(DIR(), PREFIX(), c"library", all, &error))
	asserts(error, error == 0)
	char* index2 = file_read_text(c"bin/orm_migrate_writer_out/library/library_migrations.w")
	assert_contains(index2, c"\tl.push(library_m0001_initial())\n\tl.push(library_m0002_expand_library_tag_note())\n\tl.push(library_m0003_expand_library_book_title())\n")
	assert_contains(index2, c"import bin.orm_migrate_writer_out.library.m0003_expand_library_book_title\n")
	assert_equal(all.length, count(index2, c"\tl.push("))
	# Expectations for the generated program.
	orm_state* st = orm_state_from_migrations(c"library", all)
	asserts(st.error, st.error == 0)
	write_text(c"bin/orm_migrate_writer_out/expected_state.json", orm_state_to_json(st))
	write_text(c"bin/orm_migrate_writer_out/expected_plan.txt", orm_plan_describe(all))
	write_text(c"bin/orm_migrate_writer_out/snapshot.json", next)
	write_text(c"bin/orm_migrate_writer_out/roundtrip_main.w", ROUNDTRIP_MAIN())
	assert_equal(9, all.length)
	orm_state_free(st)
	all.free()
	orm_makemig_free(r)
	orm_makemig_free(init)


void test_existing_files_are_kept():
	char* dir = c"bin/orm_migrate_writer_out/keep"
	list[orm_migration*] ms = new list[orm_migration*]
	ms.push(orm_migration_new(c"keep", c"0001_initial"))
	ms.push(orm_migration_new(c"keep", c"0002_expand_x"))
	remove_files(dir, ms, c"keep")
	orm_writer_mkdirs(dir)
	write_text(c"bin/orm_migrate_writer_out/keep/m0001_initial.w", c"# hand-edited\n")
	# An index that already lists a migration this run does not know about.
	write_text(c"bin/orm_migrate_writer_out/keep/keep_migrations.w", c"\tl.push(keep_m0000_seed())\n")
	char* error = 0
	assert_equal(1, orm_write_migrations(dir, c"keep", c"keep", ms, &error))
	assert_strings_equal(c"# hand-edited\n", file_read_text(c"bin/orm_migrate_writer_out/keep/m0001_initial.w"))
	char* index = file_read_text(c"bin/orm_migrate_writer_out/keep/keep_migrations.w")
	assert_contains(index, c"import keep.m0000_seed\nimport keep.m0001_initial\nimport keep.m0002_expand_x\n")
	assert_contains(index, c"\tl.push(keep_m0000_seed())\n\tl.push(keep_m0001_initial())\n\tl.push(keep_m0002_expand_x())\n")
	# An unwritable directory reports the failure.
	char* err2 = 0
	assert_equal(-1, orm_write_migrations(c"/proc/orm_writer_no_such_dir", c"x", c"x", ms, &err2))
	assert_contains(err2, c"cannot write /proc/orm_writer_no_such_dir/")


int main():
	test_ident()
	test_migration_source()
	test_write_round_trip()
	test_existing_files_are_kept()
	print(c"orm_migrate_writer_test: ok\n")
	return 0
