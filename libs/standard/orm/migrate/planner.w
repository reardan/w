# w-orm safe-pattern migration planner (issue #754, unit U2.3).
#
# orm_plan turns high-level schema changes (orm_change, the autodetector's
# "intents") into an ordered list of orm_migration (contract C7) following
# the expand / migrate / contract table of section 5.2 of the plan
# (docs/projects/orm/u2_3.md lists every sequence). The planner only builds
# ops; SQL is generated by the applier (U2.4).
import libs.standard.orm.contract
import libs.standard.orm.migrate.lint
import lib.str
import structures.string


const int ORM_CHANGE_ADD_COLUMN = 1     # column, field_json, nullable, has_default, backfill
const int ORM_CHANGE_DROP_COLUMN = 2    # column, field_json (current field)
const int ORM_CHANGE_RENAME_COLUMN = 3  # column -> new_name, field_json, nullable
const int ORM_CHANGE_ALTER_TYPE = 4     # column, field_json (new type), new_name (default "<column>_new"), nullable
const int ORM_CHANGE_ALTER_NULL = 5     # column, field_json, nullable (target), backfill
const int ORM_CHANGE_ADD_INDEX = 6      # column or field_json columns, name
const int ORM_CHANGE_ADD_FK = 7         # column, name, sql (constraint body)
const int ORM_CHANGE_ADD_CHECK = 8      # column, name, sql (constraint body)
const int ORM_CHANGE_ADD_UNIQUE = 9     # column or field_json columns, name
const int ORM_CHANGE_RENAME_TABLE = 10  # table -> new_name, model_json (new table)
const int ORM_CHANGE_REBUILD_TABLE = 11 # table, model_json (new shape), new_name = shadow (default "<table>__new")
const int ORM_CHANGE_CREATE_TABLE = 12  # table, model_json
const int ORM_CHANGE_DROP_TABLE = 13    # table


struct orm_change:
	int kind
	char* table
	char* column
	char* new_name      # new column / table name (rename, type change, rebuild shadow)
	char* name          # index / constraint name; derived when 0
	char* field_json    # new field snapshot (or index columns)
	char* model_json    # new model snapshot (create / rename / rebuild table)
	char* sql           # constraint body for ADD_FK / ADD_CHECK
	char* backfill      # registered backfill name; default "<table>_<column>_backfill"
	int nullable        # target column is nullable
	int has_default     # added column has a database default
	int force           # emit the direct single-step op, marked unsafe
	int batch_size      # 0 = 1000


orm_change* orm_change_new(int kind, char* table, char* column):
	orm_change* c = new orm_change()
	c.kind = kind
	c.table = table
	c.column = column
	return c


struct orm_planner:
	char* app
	int dialect_id          # ORM_DIALECT_SQLITE / ORM_DIALECT_POSTGRES
	int next_number         # number of the first planned migration
	char* previous          # latest existing migration name (first dependency), or 0
	char* error             # set when orm_plan returns 0
	list[void*] owned       # strings the planner allocated


orm_planner* orm_planner_new(char* app, int dialect_id, int next_number, char* previous):
	orm_planner* p = new orm_planner()
	p.app = app
	p.dialect_id = dialect_id
	p.next_number = next_number
	if (p.next_number < 1): p.next_number = 1
	p.previous = previous
	p.owned = new list[void*]
	return p


char* orm_planner_own(orm_planner* p, char* s):
	p.owned.push(cast(void*, s))
	return s


char* orm_planner_cat(orm_planner* p, char* a, char* b, char* c2, char* d):
	string_builder* sb = string_new()
	if (a != 0): string_append(sb, a)
	if (b != 0): string_append(sb, b)
	if (c2 != 0): string_append(sb, c2)
	if (d != 0): string_append(sb, d)
	char* out = sb.data
	free(cast(void*, sb))
	return orm_planner_own(p, out)


# A stage is one future migration of one change.
struct orm_stage:
	int phase
	int requires_first      # contract: requires the change's first migration
	list[orm_op*] ops


struct orm_change_plan:
	orm_change* change
	char* label             # "<table>_<column>" used in migration names
	list[orm_stage*] stages
	char* first_name


orm_stage* orm_plan_stage(orm_change_plan* cp, int phase):
	orm_stage* s = new orm_stage()
	s.phase = phase
	s.requires_first = phase == ORM_PHASE_CONTRACT
	s.ops = new list[orm_op*]
	cp.stages.push(s)
	return s


orm_op* orm_stage_op(orm_stage* s, int kind, int phase, char* table, char* column):
	orm_op* op = orm_op_new(kind, phase, table)
	op.column = column
	s.ops.push(op)
	return op


int orm_plan_batch(orm_change* c):
	if (c.batch_size > 0): return c.batch_size
	return 1000


int orm_plan_pg(orm_planner* p):
	return p.dialect_id != ORM_DIALECT_SQLITE


char* orm_plan_field_nullable(orm_planner* p, char* field_json):
	return orm_planner_own(p, orm_mjson_set(field_json, c"null", c"true"))


char* orm_plan_field_column(orm_planner* p, char* field_json, char* column):
	char* q = orm_mjson_quote(column)
	char* out = orm_mjson_set(field_json, c"column", q)
	free(q)
	return orm_planner_own(p, out)


char* orm_plan_index_json(orm_planner* p, orm_change* c, int unique):
	char* json = c.field_json
	if (json == 0 || orm_mjson_has_value(json, c"columns") == 0):
		char* q = orm_mjson_quote(c.column)
		string_builder* b = string_new()
		string_append(b, c"[")
		string_append(b, q)
		string_append(b, c"]")
		free(q)
		json = orm_planner_own(p, orm_mjson_set(json, c"columns", b.data))
		string_free(b)
	if (unique): json = orm_planner_own(p, orm_mjson_set(json, c"unique", c"true"))
	return json


# NOT NULL tightening of table.column after its data is in place:
#   migrate:  BACKFILL (optional), PostgreSQL: ADD_CONSTRAINT CHECK (c IS NOT NULL) NOT VALID
#   contract: PostgreSQL: VALIDATE_CONSTRAINT, ALTER_NULL, DROP_CONSTRAINT; SQLite: ALTER_NULL
# `migrate` may be 0 when the caller has no migrate stage to add to.
void orm_plan_not_null(orm_planner* p, orm_change_plan* cp, orm_stage* migrate, orm_stage* contract, char* column, char* field_json, int backfill):
	orm_change* c = cp.change
	char* check = orm_planner_cat(p, c.table, c"_", column, c"_not_null")
	if (backfill):
		char* name = c.backfill
		if (name == 0): name = orm_planner_cat(p, c.table, c"_", column, c"_backfill")
		orm_op* b = orm_stage_op(migrate, ORM_OP_BACKFILL, ORM_PHASE_MIGRATE, c.table, column)
		b.name = name
		b.sql = name
		b.non_atomic = 1
		b.batch_size = orm_plan_batch(c)
	if (orm_plan_pg(p)):
		orm_op* add = orm_stage_op(migrate, ORM_OP_ADD_CONSTRAINT, ORM_PHASE_MIGRATE, c.table, column)
		add.name = check
		add.sql = orm_planner_cat(p, c"CHECK (", column, c" IS NOT NULL)", 0)
		orm_op* v = orm_stage_op(contract, ORM_OP_VALIDATE_CONSTRAINT, ORM_PHASE_CONTRACT, c.table, column)
		v.name = check
	orm_op* alter = orm_stage_op(contract, ORM_OP_ALTER_NULL, ORM_PHASE_CONTRACT, c.table, column)
	alter.field_json = orm_planner_own(p, orm_mjson_set(field_json, c"null", c"false"))
	if (orm_plan_pg(p)):
		orm_op* drop = orm_stage_op(contract, ORM_OP_DROP_CONSTRAINT, ORM_PHASE_CONTRACT, c.table, column)
		drop.name = check


void orm_plan_add_column(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* add = orm_stage_op(e, ORM_OP_ADD_COLUMN, ORM_PHASE_EXPAND, c.table, c.column)
	if (c.nullable || c.has_default || c.force):
		add.field_json = c.field_json
		if (c.nullable): add.field_json = orm_plan_field_nullable(p, c.field_json)
		if (c.nullable == 0 && c.has_default == 0): add.unsafe = 1
		return
	add.field_json = orm_plan_field_nullable(p, c.field_json)
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_plan_not_null(p, cp, m, k, c.column, c.field_json, 1)


void orm_plan_alter_null(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	if (c.nullable):
		orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
		orm_op* op = orm_stage_op(e, ORM_OP_ALTER_NULL, ORM_PHASE_EXPAND, c.table, c.column)
		op.field_json = orm_plan_field_nullable(p, c.field_json)
		return
	if (c.force):
		orm_stage* f = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
		f.requires_first = 0
		orm_op* op2 = orm_stage_op(f, ORM_OP_ALTER_NULL, ORM_PHASE_CONTRACT, c.table, c.column)
		op2.field_json = orm_planner_own(p, orm_mjson_set(c.field_json, c"null", c"false"))
		op2.unsafe = 1
		return
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_plan_not_null(p, cp, m, k, c.column, c.field_json, 1)


void orm_plan_drop_column(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	if (c.force):
		orm_stage* f = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
		f.requires_first = 0
		orm_op* d = orm_stage_op(f, ORM_OP_DROP_COLUMN, ORM_PHASE_CONTRACT, c.table, c.column)
		d.unsafe = 1
		return
	# Expand: no schema change beyond dropping NOT NULL (new code stops
	# writing the column); "deprecated": true tells the generator to stop
	# selecting and writing the field.
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* mark = orm_stage_op(e, ORM_OP_ALTER_NULL, ORM_PHASE_EXPAND, c.table, c.column)
	mark.field_json = orm_planner_own(p, orm_mjson_set(orm_plan_field_nullable(p, c.field_json), c"deprecated", c"true"))
	orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_stage_op(k, ORM_OP_DROP_COLUMN, ORM_PHASE_CONTRACT, c.table, c.column)


# Rename column / change type: field duplication.
void orm_plan_duplicate_column(orm_planner* p, orm_change_plan* cp, char* new_column):
	orm_change* c = cp.change
	char* field = orm_plan_field_column(p, c.field_json, new_column)
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* add = orm_stage_op(e, ORM_OP_ADD_COLUMN, ORM_PHASE_EXPAND, c.table, new_column)
	add.field_json = orm_plan_field_nullable(p, field)
	orm_op* sync = orm_stage_op(e, ORM_OP_SYNC_TRIGGER, ORM_PHASE_EXPAND, c.table, new_column)
	sync.source_column = c.column
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_op* copy = orm_stage_op(m, ORM_OP_COPY_COLUMN, ORM_PHASE_MIGRATE, c.table, new_column)
	copy.source_column = c.column
	copy.non_atomic = 1
	copy.batch_size = orm_plan_batch(c)
	# (deploy: code reads and writes the new column)
	orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	if (c.nullable == 0): orm_plan_not_null(p, cp, m, k, new_column, field, 0)
	orm_op* old = orm_stage_op(k, ORM_OP_ALTER_NULL, ORM_PHASE_CONTRACT, c.table, c.column)
	old.field_json = orm_planner_cat(p, c"{\"column\": ", orm_planner_own(p, orm_mjson_quote(c.column)), c", \"null\": true, \"deprecated\": true}", 0)
	orm_op* stop = orm_stage_op(k, ORM_OP_DROP_SYNC_TRIGGER, ORM_PHASE_CONTRACT, c.table, new_column)
	stop.source_column = c.column
	orm_stage* k2 = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_stage_op(k2, ORM_OP_DROP_COLUMN, ORM_PHASE_CONTRACT, c.table, c.column)


# Rename / rebuild table: table duplication. `rebuild` swaps names at the
# end so the original name holds the new shape.
void orm_plan_duplicate_table(orm_planner* p, orm_change_plan* cp, char* new_table, int rebuild):
	orm_change* c = cp.change
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* create = orm_stage_op(e, ORM_OP_CREATE_TABLE, ORM_PHASE_EXPAND, new_table, 0)
	create.model_json = c.model_json
	orm_op* sync = orm_stage_op(e, ORM_OP_SYNC_TRIGGER, ORM_PHASE_EXPAND, new_table, 0)
	sync.source_table = c.table
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_op* copy = orm_stage_op(m, ORM_OP_COPY_TABLE, ORM_PHASE_MIGRATE, new_table, 0)
	copy.source_table = c.table
	copy.non_atomic = 1
	copy.batch_size = orm_plan_batch(c)
	if (rebuild):
		orm_stage* s = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
		orm_op* swap = orm_stage_op(s, ORM_OP_SWAP_TABLES, ORM_PHASE_MIGRATE, new_table, 0)
		swap.source_table = c.table
		orm_op* stop = orm_stage_op(s, ORM_OP_DROP_SYNC_TRIGGER, ORM_PHASE_MIGRATE, new_table, 0)
		stop.source_table = c.table
		# After the swap c.table has the new shape; new_table holds the old rows.
		orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
		orm_stage_op(k, ORM_OP_DROP_TABLE, ORM_PHASE_CONTRACT, new_table, 0)
		return
	# (deploy: code uses new_table; the trigger keeps both in sync meanwhile)
	orm_stage* k1 = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_op* stop2 = orm_stage_op(k1, ORM_OP_DROP_SYNC_TRIGGER, ORM_PHASE_CONTRACT, new_table, 0)
	stop2.source_table = c.table
	orm_stage* k2 = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_stage_op(k2, ORM_OP_DROP_TABLE, ORM_PHASE_CONTRACT, c.table, 0)


void orm_plan_add_index(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* op = orm_stage_op(e, ORM_OP_ADD_INDEX, ORM_PHASE_EXPAND, c.table, c.column)
	op.name = c.name
	if (op.name == 0): op.name = orm_planner_cat(p, c.table, c"_", c.column, c"_idx")
	op.field_json = orm_plan_index_json(p, c, 0)
	if (orm_plan_pg(p) && c.force == 0): op.non_atomic = 1
	if (orm_plan_pg(p) && c.force): op.unsafe = 1


void orm_plan_add_constraint(orm_planner* p, orm_change_plan* cp, char* suffix):
	orm_change* c = cp.change
	char* name = c.name
	if (name == 0): name = orm_planner_cat(p, c.table, c"_", c.column, suffix)
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* add = orm_stage_op(e, ORM_OP_ADD_CONSTRAINT, ORM_PHASE_EXPAND, c.table, c.column)
	add.name = name
	add.sql = c.sql
	if (orm_plan_pg(p) == 0): return
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_op* v = orm_stage_op(m, ORM_OP_VALIDATE_CONSTRAINT, ORM_PHASE_MIGRATE, c.table, c.column)
	v.name = name


void orm_plan_add_unique(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	char* base = c.name
	if (base == 0): base = orm_planner_cat(p, c.table, c"_", c.column, c"_uniq")
	char* index = orm_planner_cat(p, base, c"_idx", 0, 0)
	orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_op* op = orm_stage_op(e, ORM_OP_ADD_INDEX, ORM_PHASE_EXPAND, c.table, c.column)
	op.name = index
	op.field_json = orm_plan_index_json(p, c, 1)
	if (orm_plan_pg(p) == 0):
		op.name = base
		return
	op.non_atomic = 1
	orm_stage* m = orm_plan_stage(cp, ORM_PHASE_MIGRATE)
	orm_op* add = orm_stage_op(m, ORM_OP_ADD_CONSTRAINT, ORM_PHASE_MIGRATE, c.table, c.column)
	add.name = base
	add.sql = orm_planner_cat(p, c"UNIQUE USING INDEX ", index, 0, 0)


void orm_plan_drop_table(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	if (c.force):
		orm_stage* f = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
		f.requires_first = 0
		orm_op* d = orm_stage_op(f, ORM_OP_DROP_TABLE, ORM_PHASE_CONTRACT, c.table, 0)
		d.unsafe = 1
		return
	# Expand: no database change; the model is deprecated in code.
	orm_plan_stage(cp, ORM_PHASE_EXPAND)
	orm_stage* k = orm_plan_stage(cp, ORM_PHASE_CONTRACT)
	orm_stage_op(k, ORM_OP_DROP_TABLE, ORM_PHASE_CONTRACT, c.table, 0)


# Fills cp.stages for one change. Returns 0 with p.error on a bad change.
int orm_plan_change(orm_planner* p, orm_change_plan* cp):
	orm_change* c = cp.change
	int k = c.kind
	if (c.table == 0):
		p.error = c"change without a table"
		return 0
	int needs_column = k != ORM_CHANGE_RENAME_TABLE && k != ORM_CHANGE_REBUILD_TABLE && k != ORM_CHANGE_CREATE_TABLE && k != ORM_CHANGE_DROP_TABLE
	if (needs_column && c.column == 0):
		p.error = orm_planner_cat(p, c"change on ", c.table, c" without a column", 0)
		return 0
	if (k == ORM_CHANGE_ADD_COLUMN): orm_plan_add_column(p, cp)
	else if (k == ORM_CHANGE_DROP_COLUMN): orm_plan_drop_column(p, cp)
	else if (k == ORM_CHANGE_RENAME_COLUMN):
		if (c.new_name == 0):
			p.error = orm_planner_cat(p, c"rename_column ", c.table, c" without new_name", 0)
			return 0
		orm_plan_duplicate_column(p, cp, c.new_name)
	else if (k == ORM_CHANGE_ALTER_TYPE):
		char* target = c.new_name
		if (target == 0): target = orm_planner_cat(p, c.column, c"_new", 0, 0)
		orm_plan_duplicate_column(p, cp, target)
	else if (k == ORM_CHANGE_ALTER_NULL): orm_plan_alter_null(p, cp)
	else if (k == ORM_CHANGE_ADD_INDEX): orm_plan_add_index(p, cp)
	else if (k == ORM_CHANGE_ADD_FK): orm_plan_add_constraint(p, cp, c"_fk")
	else if (k == ORM_CHANGE_ADD_CHECK): orm_plan_add_constraint(p, cp, c"_check")
	else if (k == ORM_CHANGE_ADD_UNIQUE): orm_plan_add_unique(p, cp)
	else if (k == ORM_CHANGE_RENAME_TABLE):
		if (c.new_name == 0):
			p.error = orm_planner_cat(p, c"rename_table ", c.table, c" without new_name", 0)
			return 0
		if (c.force):
			orm_stage* f = orm_plan_stage(cp, ORM_PHASE_EXPAND)
			orm_op* r = orm_stage_op(f, ORM_OP_RENAME_TABLE, ORM_PHASE_EXPAND, c.new_name, 0)
			r.source_table = c.table
			r.unsafe = 1
		else: orm_plan_duplicate_table(p, cp, c.new_name, 0)
	else if (k == ORM_CHANGE_REBUILD_TABLE):
		char* shadow = c.new_name
		if (shadow == 0): shadow = orm_planner_cat(p, c.table, c"__new", 0, 0)
		orm_plan_duplicate_table(p, cp, shadow, 1)
	else if (k == ORM_CHANGE_CREATE_TABLE):
		orm_stage* e = orm_plan_stage(cp, ORM_PHASE_EXPAND)
		orm_op* op = orm_stage_op(e, ORM_OP_CREATE_TABLE, ORM_PHASE_EXPAND, c.table, 0)
		op.model_json = c.model_json
	else if (k == ORM_CHANGE_DROP_TABLE): orm_plan_drop_table(p, cp)
	else:
		p.error = c"unknown change kind"
		return 0
	return 1


char* orm_plan_label(orm_planner* p, orm_change* c):
	if (c.kind == ORM_CHANGE_RENAME_TABLE && c.new_name != 0): return orm_planner_cat(p, c.table, c"_to_", c.new_name, 0)
	if (c.column != 0): return orm_planner_cat(p, c.table, c"_", c.column, 0)
	return c.table


# Plans every change. Stage k of every change ships before stage k + 1 of
# any change, so independent changes share deploys; within a stage changes
# keep their input order. Each migration depends on the one before it;
# contract migrations name their change's first migration in
# requires_applied. Returns 0 (p.error set) on an invalid change.
list[orm_migration*] orm_plan(orm_planner* p, list[orm_change*] changes):
	list[orm_change_plan*] plans = new list[orm_change_plan*]
	int depth = 0
	int ok = 1
	for orm_change* c in changes:
		orm_change_plan* cp = new orm_change_plan()
		cp.change = c
		cp.stages = new list[orm_stage*]
		cp.label = orm_plan_label(p, c)
		plans.push(cp)
		if (ok && orm_plan_change(p, cp) == 0): ok = 0
		if (cp.stages.length > depth): depth = cp.stages.length
	list[orm_migration*] out = 0
	if (ok):
		out = new list[orm_migration*]
		int number = p.next_number
		char* prev = p.previous
		for s in range(depth):
			for orm_change_plan* cp in plans:
				if (s >= cp.stages.length): continue
				orm_stage* st = cp.stages[s]
				char* num = itoa(number)
				char* padded = zfill(num, 4)
				free(num)
				orm_planner_own(p, padded)
				char* name = orm_planner_cat(p, padded, c"_", orm_phase_name(st.phase), c"_")
				name = orm_planner_cat(p, name, cp.label, 0, 0)
				number = number + 1
				orm_migration* m = orm_migration_new(p.app, name)
				if (prev != 0):
					if (p.app != 0): m.dependencies.push(orm_planner_cat(p, p.app, c".", prev, 0))
					else: m.dependencies.push(prev)
				for orm_op* op in st.ops: orm_migration_add(m, op)
				if (s == 0): cp.first_name = name
				else if (st.requires_first): m.requires_applied = cp.first_name
				out.push(m)
				prev = name
	for orm_change_plan* cp in plans:
		for orm_stage* st in cp.stages:
			st.ops.free()
			free(cast(void*, st))
		cp.stages.free()
		free(cast(void*, cp))
	plans.free()
	if (ok): p.next_number = p.next_number + out.length
	return out


# Frees the plan's migrations and ops, and every string the planner made.
# Strings that came from the orm_change inputs are not freed.
void orm_planner_free(orm_planner* p, list[orm_migration*] plan):
	if (plan != 0):
		for orm_migration* m in plan:
			for orm_op* op in m.ops: free(cast(void*, op))
			m.ops.free()
			m.dependencies.free()
			free(cast(void*, m))
		plan.free()
	for void* s in p.owned: free(s)
	p.owned.free()
	free(cast(void*, p))


void orm_describe_op(string_builder* b, orm_op* op):
	string_append(b, c"  ")
	string_append(b, orm_phase_name(op.phase))
	string_append(b, c" ")
	string_append(b, orm_op_kind_name(op.kind))
	if (op.table != 0):
		string_append(b, c" ")
		string_append(b, op.table)
		if (op.column != 0):
			string_append(b, c".")
			string_append(b, op.column)
	if (op.source_table != 0 || op.source_column != 0):
		string_append(b, c" <- ")
		if (op.source_table != 0): string_append(b, op.source_table)
		else: string_append(b, op.table)
		if (op.source_column != 0):
			string_append(b, c".")
			string_append(b, op.source_column)
	if (op.name != 0):
		string_append(b, c" name=")
		string_append(b, op.name)
	if (op.sql != 0 && op.kind != ORM_OP_BACKFILL):
		string_append(b, c" sql=\"")
		string_append(b, op.sql)
		string_append(b, c"\"")
	if (op.field_json != 0):
		if (orm_mjson_is_true(op.field_json, c"null")): string_append(b, c" null")
		if (orm_mjson_literal_is(op.field_json, c"null", c"false")): string_append(b, c" not-null")
		if (orm_mjson_is_true(op.field_json, c"deprecated")): string_append(b, c" deprecated")
		if (orm_mjson_is_true(op.field_json, c"unique")): string_append(b, c" unique")
	if (op.kind == ORM_OP_COPY_COLUMN || op.kind == ORM_OP_COPY_TABLE || op.kind == ORM_OP_BACKFILL):
		string_append(b, c" batch=")
		string_append_int(b, op.batch_size)
	if (op.non_atomic): string_append(b, c" non_atomic")
	if (op.unsafe): string_append(b, c" unsafe")
	string_append(b, c"\n")


# Text rendering of a plan, one block per migration:
#   0007_expand_book_price (atomic)
#     expand ADD_COLUMN book.price null
#   0009_contract_book_price (atomic) requires 0007_expand_book_price
#     contract DROP_COLUMN book.price_old
# An expand migration with no ops prints "  (no database change)".
char* orm_plan_describe(list[orm_migration*] plan):
	string_builder* b = string_new()
	for orm_migration* m in plan:
		string_append(b, m.name)
		if (m.atomic): string_append(b, c" (atomic)")
		else: string_append(b, c" (non-atomic)")
		if (m.requires_applied != 0):
			string_append(b, c" requires ")
			string_append(b, m.requires_applied)
		string_append(b, c"\n")
		if (m.ops.length == 0): string_append(b, c"  (no database change)\n")
		for orm_op* op in m.ops: orm_describe_op(b, op)
	char* out = b.data
	free(cast(void*, b))
	return out
