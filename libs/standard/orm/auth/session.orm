# w-orm sessions and API tokens (issue #754, unit U3.2;
# docs/projects/orm/u3_2.md). session_orm.w, session_orm_api.w and
# session_schema.json next to this file are generated from it by
# bin/orm_gen and committed; orm_session_gen_test regenerates them and
# fails on any difference.
#
# Only SHA-256 hex digests of the raw tokens are stored. The generator
# has no cross-file references yet, so user_id is a plain indexed int
# holding auth_user.id (0 = an anonymous session) rather than an FK to
# auth.orm's User.
app session

model Session:
	string session_key max_length=64 unique
	int user_id default=0 indexed
	text session_data
	datetime expire_date indexed
	datetime created
	table=auth_session

model ApiToken:
	int user_id indexed
	string name max_length=100
	string token_key max_length=8 indexed
	string digest max_length=64 unique
	datetime created
	datetime expiry null
	datetime last_used null
	unique_together user_id name
	table=auth_api_token
