void test_full_case_strings():
	expect_mapped(c"STRASSE", unicode_upper(c"stra\xc3\x9fe"))
	expect_mapped(c"strasse", unicode_casefold(c"STRA\xc3\x9fE"))
	expect_mapped(c"ss", unicode_casefold(c"\xe1\xba\x9e"))
	expect_mapped(c"\xca\xbcN", unicode_upper(c"\xc5\x89"))
	expect_mapped(c"FFI", unicode_upper(c"\xef\xac\x83"))
	expect_mapped(c"i\xcc\x87", unicode_lower(c"\xc4\xb0"))
	expect_mapped(c"\xce\x99\xcc\x88\xcc\x81", unicode_upper(c"\xce\x90"))
	expect_mapped(c"\xe1\xbc\x80\xce\xb9", unicode_casefold(c"\xe1\xbe\x80"))
