#
# The table-driven rows at the end of this file were generated once with
# CPython's unicodedata module (Unicode 15.1.0) and the Unicode 15.0.0
# NormalizationTest.txt, then embedded here:
#   property_rows      cp;category;bidirectional;combining;decimal;digit;
#                      numeric;mirrored;upper;lower;title;casefold;
#                      decomposition -- Python values for codepoints whose
#                      data did not change between 15.0 and 15.1 (the
#                      15.1 additions such as U+2EBF0..U+2EE5D and the
#                      Unihan numeric changes are left out). Case columns
#                      come from str.upper/lower/title/casefold of one
#                      character, "-" where Python's full mapping is
#                      longer than one codepoint; numeric is a reduced
#                      fraction, "-" when it does not fit in 31 bits.
#   normalization_rows c1;c2;c3;c4;c5 rows of NormalizationTest-15.0.0.txt:
#                      all of Part 0, Hangul syllables, singletons,
#                      composition exclusions, non-starter decompositions
#                      and compatibility forms from Part 1 plus a random
#                      sample of it, every 14th row of Part 2 (canonical
#                      ordering) and every other row of Part 3.
import lib.testing
