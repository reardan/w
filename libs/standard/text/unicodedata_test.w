	expect_mapped(c"", unicode_upper(c""))
	# No Final_Sigma context rule (Python gives "\u03b1\u03c2" here).
	expect_mapped(c"\xce\xb1\xcf\x83", unicode_lower(c"\xce\x91\xce\xa3"))
	# Malformed UTF-8 reads as U+FFFD.
	expect_mapped(c"\xef\xbf\xbdA", unicode_upper(c"\xffa"))


