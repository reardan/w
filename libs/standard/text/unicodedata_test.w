# ---- helpers ---------------------------------------------------------

# Field index of a ';'-separated row as a new string.
char* row_field(char* row, int index):
	int start = 0
	int i = 0
	int field = 0
	while (1):
		if ((row[i] == ';') || (row[i] == 0)):
			if (field == index): return str_copy_range(row, start, i)
			if (row[i] == 0): return strclone(c"")
			field = field + 1
			start = i + 1
		i = i + 1


int hex_value(char* text):
	int value = 0
	int i = 0
	while (text[i] != 0):
		int c = text[i]
		if ((c >= '0') && (c <= '9')): value = value * 16 + c - '0'
		else if ((c >= 'A') && (c <= 'F')): value = value * 16 + c - 'A' + 10
		i = i + 1
	return value


int put_utf8(char* out, int cp):
	if (cp < 128):
		out[0] = cp
		return 1
	if (cp < 2048):
		out[0] = 192 | (cp >> 6)
		out[1] = 128 | (cp & 63)
		return 2
	if (cp < 65536):
		out[0] = 224 | (cp >> 12)
		out[1] = 128 | ((cp >> 6) & 63)
		out[2] = 128 | (cp & 63)
		return 3
	out[0] = 240 | (cp >> 18)
	out[1] = 128 | ((cp >> 12) & 63)
	out[2] = 128 | ((cp >> 6) & 63)
	out[3] = 128 | (cp & 63)
	return 4


# "0044 0307" -> the UTF-8 string of those codepoints (caller frees).
char* hex_text(char* seq):
	char* out = cast(char*, malloc(strlen(seq) + 8))
	int n = 0
	int i = 0
	while (seq[i] != 0):
		while (seq[i] == ' '): i = i + 1
		if (seq[i] == 0): break
		int value = 0
		while ((seq[i] != ' ') && (seq[i] != 0)):
			int c = seq[i]
			if (c <= '9'): value = value * 16 + c - '0'
			else: value = value * 16 + c - 'A' + 10
			i = i + 1
		n = n + put_utf8(&out[n], value)
	out[n] = 0
	return out


# One-codepoint UTF-8 string (caller frees).
char* cp_text(int cp):
	char* out = cast(char*, malloc(5))
	int n = put_utf8(out, cp)
	out[n] = 0
	return out


void expect_row(char* row, char* want, char* got):
	if (strcmp(want, got) != 0):
		print2(c"row: ")
		println2(row)
	assert_strings_equal(want, got)


void expect_row_int(char* row, int want, int got):
	if (want != got):
		print2(c"row: ")
		println2(row)
	assert_equal(want, got)


void expect_normalize(char* row, char* form, char* want, char* input):
	char* got = unicode_normalize(form, input)
	if (strcmp(want, got) != 0):
		print2(c"form ")
		print2(form)
		print2(c" row: ")
		println2(row)
	assert_strings_equal(want, got)
	free(got)


void expect_normalize_case(char* form, char* want, char* input):
	char* got = unicode_normalize(form, input)
	assert_strings_equal(want, got)
	free(got)
	assert_equal(1, unicode_is_normalized(form, want))


void expect_mapped(char* want, char* got):
	assert_strings_equal(want, got)
	free(got)


void expect_decomposition(char* want, int cp):
	char* got = unicode_decomposition(cp)
	assert_strings_equal(want, got)
	free(got)


