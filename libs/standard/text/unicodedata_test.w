void test_normalize_bytes_with_nul():
	char* input = c"e\xcc\x81\x00A\xcc\x8a"
	int length = 0
	char* out = unicode_normalize_bytes(unicode_nfc, input, 7, &length)
	assert_equal(5, length)
	assert_bytes_equal(c"\xc3\xa9\x00\xc3\x85", out, 5)
	free(out)
	assert1(unicode_normalize_bytes(7, input, 7, &length) == 0)


