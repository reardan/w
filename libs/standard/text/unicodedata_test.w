# Defined at the end of the file.
list[char*] property_rows();
list[char*] normalization_rows();


void check_property_row(char* row):
	char* f = row_field(row, 0)
	int cp = hex_value(f)
	free(f)
	f = row_field(row, 1)
	expect_row(row, f, unicode_category_str(cp))
	free(f)
	f = row_field(row, 2)
	expect_row(row, f, unicode_bidirectional_str(cp))
	free(f)
	f = row_field(row, 3)
	expect_row_int(row, atoi(f), unicode_combining(cp))
	free(f)
	f = row_field(row, 4)
	expect_row_int(row, atoi(f), unicode_decimal(cp))
	free(f)
	f = row_field(row, 5)
	expect_row_int(row, atoi(f), unicode_digit(cp))
	free(f)
	f = row_field(row, 6)
	int num = 0
	int den = 0
	if (f[0] == 0): expect_row_int(row, 0, unicode_is_numeric(cp))
	else if (f[0] != '-'):
		expect_row_int(row, 1, unicode_numeric_fraction(cp, &num, &den))
		int slash = index_of(f, c"/")
		char* top = str_copy_range(f, 0, slash)
		expect_row_int(row, atoi(top), num)
		expect_row_int(row, atoi(&f[slash + 1]), den)
		free(top)
	free(f)
	f = row_field(row, 7)
	expect_row_int(row, atoi(f), unicode_mirrored(cp))
	free(f)
	for k in range(4):
		f = row_field(row, 8 + k)
		if (f[0] != '-'):
			int got = unicode_to_upper(cp)
			if (k == 1): got = unicode_to_lower(cp)
			if (k == 2): got = unicode_to_title(cp)
			if (k == 3): got = unicode_casefold_simple(cp)
			expect_row_int(row, hex_value(f), got)
		free(f)
	f = row_field(row, 12)
	char* d = unicode_decomposition(cp)
	expect_row(row, f, d)
	free(d)
	free(f)


void test_property_rows():
	list[char*] rows = property_rows()
	assert1(rows.length > 1000)
	for row in rows: check_property_row(row)
	rows.free()


# NormalizationTest.txt invariants:
#   c2 == NFC(c1) == NFC(c2) == NFC(c3),   c4 == NFC(c4) == NFC(c5)
#   c3 == NFD(c1) == NFD(c2) == NFD(c3),   c5 == NFD(c4) == NFD(c5)
#   c4 == NFKC(c1..c5),                    c5 == NFKD(c1..c5)
void check_normalization_row(char* row):
	list[char*] c = new list[char*]
	for k in range(5):
		char* f = row_field(row, k)
		c.push(hex_text(f))
		free(f)
	for k in range(3): expect_normalize(row, c"NFC", c[1], c[k])
	for k in range(3, 5): expect_normalize(row, c"NFC", c[3], c[k])
	for k in range(3): expect_normalize(row, c"NFD", c[2], c[k])
	for k in range(3, 5): expect_normalize(row, c"NFD", c[4], c[k])
	for k in range(5): expect_normalize(row, c"NFKC", c[3], c[k])
	for k in range(5): expect_normalize(row, c"NFKD", c[4], c[k])
	expect_row_int(row, 1, unicode_is_normalized(c"NFC", c[1]))
	expect_row_int(row, 1, unicode_is_normalized(c"NFD", c[2]))
	expect_row_int(row, 1, unicode_is_normalized(c"NFKC", c[3]))
	expect_row_int(row, 1, unicode_is_normalized(c"NFKD", c[4]))
	expect_row_int(row, strcmp(c[0], c[2]) == 0, unicode_is_normalized(c"NFD", c[0]))
	for s in c: free(s)
	c.free()


void test_normalization_rows():
	list[char*] rows = normalization_rows()
	assert1(rows.length > 300)
	for row in rows: check_normalization_row(row)
	rows.free()


