void test_normalize_forms():
	assert_equal(unicode_nfc, unicode_form(c"NFC"))
	assert_equal(unicode_nfkd, unicode_form(c"NFKD"))
	assert_equal(-1, unicode_form(c"nfc"))
	assert1(unicode_normalize(c"NFX", c"a") == 0)
	assert_equal(-1, unicode_is_normalized(c"NFX", c"a"))
	assert_equal(0, unicode_is_normalized(c"NFC", c"e\xcc\x81"))
	assert_equal(1, unicode_is_normalized(c"NFD", c"e\xcc\x81"))
