# wbuild: step="bin/textwrap_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
import lib.testing
import libs.standard.text.textwrap


# Assert got equals want, then free got.
void tw_expect(char* want, char* got):
	assert_strings_equal(want, got)
	free(got)


# Assert got holds exactly the strings of want, then free both (want's
# strings are literals; only the list itself is freed).
void tw_expect_lines(list[char*] want, list[char*] got):
	assert_equal(want.length, got.length)
	int i = 0
	while (i < want.length && i < got.length):
		assert_strings_equal(want[i], got[i])
		i = i + 1
	want.free()
	textwrap_free_lines(got)


void test_options_defaults():
	textwrap_options o
	textwrap_options_init(&o)
	assert_equal(70, o.width)
	assert_equal(8, o.tabsize)
	assert_equal(1, o.break_long_words)
	assert_equal(0, o.max_lines)
	assert_strings_equal(c" [...]", o.placeholder)
	assert_equal(0, cast(int, textwrap_options_error(&o)))


void test_invalid_width():
	textwrap_options o
	textwrap_options_init(&o, 0)
	assert_strings_equal(c"invalid width (must be > 0)", textwrap_options_error(&o))
	list[char*] lines = textwrap_wrap_with(c"some text", &o)
	assert_equal(0, lines.length)
	textwrap_free_lines(lines)
	tw_expect(c"", textwrap_fill(c"some text", -3))


void test_placeholder_too_large():
	textwrap_options o
	textwrap_options_init(&o, 6)
	o.max_lines = 1
	o.initial_indent = c"> "
	o.placeholder = c" [...]"
	# Python: len("> ") + len("[...]") = 7 > 6 raises ValueError
	assert_strings_equal(c"placeholder too large for max width", textwrap_options_error(&o))
	tw_expect(c"", textwrap_fill_with(c"a b c d e f g", &o))
	# with max_lines > 1 the subsequent indent is the one checked
	o.max_lines = 2
	o.subsequent_indent = c""
	assert_equal(0, cast(int, textwrap_options_error(&o)))
	tw_expect(c"", textwrap_shorten(c"too long for it", 4))


void test_shorten_with_options():
	textwrap_options o
	textwrap_options_init(&o, 15)
	o.max_lines = 5
	o.placeholder = c"..."
	# textwrap.shorten("one two three four", 15, placeholder="...")
	tw_expect(c"one two...", textwrap_shorten_with(c"one two three four", &o))
	assert_equal(5, o.max_lines)


int tw_starts_with_hash(char* line):
	return line[0] == '#'


void test_indent_predicate():
	# textwrap.indent("# a\nb\n# c\n", "  ", lambda s: s.startswith("#"))
	tw_expect(c"  # a\nb\n  # c\n", textwrap_indent(c"# a\nb\n# c\n", c"  ", tw_starts_with_hash))


void test_isspace_set():
	assert_equal(1, textwrap_isspace(c" \t\n\x0b\x0c\r\x1c\x1d\x1e\x1f"))
	assert_equal(1, textwrap_isspace(c"\u0085        　"))
	assert_equal(0, textwrap_isspace(c""))
	assert_equal(0, textwrap_isspace(c" x "))
	assert_equal(0, textwrap_isspace(c"​"))
	assert_equal(0, textwrap_isspace(c"é"))
	# a blank-only (Unicode whitespace) line is not indented, as in Python
	tw_expect(c"> a\n　\n", textwrap_indent(c"a\n　\n", c"> "))
