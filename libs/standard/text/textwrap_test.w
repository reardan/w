	# textwrap.wrap('The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs!', 20, **{})
	list[char*] want = list[char*]{c"The quick brown fox", c"jumps over the lazy", c"dog. Pack my box", c"with five dozen", c"liquor jugs!"}
