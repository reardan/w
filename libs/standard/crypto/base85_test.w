# wbuild: name=crypto_base85_test x64
# wbuild: step="bin/crypto_base85_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
# Vectors were generated with Python 3.13's base64 module (b85encode /
# b85decode / a85encode / a85decode); inputs are hex, outputs verbatim.
import lib.testing
import lib.hex
import libs.standard.crypto.base85


char* b85_test_unhex(char* h, int* n):
	char* data = hex_decode(h, strlen(h), n)
	asserts(c"bad hex in test vector", data != 0)
	return data


# Decoding a pad=True encoding yields the zero-filled 4-byte multiple.
void assert_padded_roundtrip(char* data, int n, char* back, int back_len, int pad):
	asserts(c"decode of a valid encoding failed", back != 0)
	int want = n
	if (pad != 0): want = ((n + 3) / 4) * 4
	assert_equal(want, back_len)
	assert_bytes_equal(data, back, n)
	for i in range(want - n): assert_equal(0, back[n + i])
	assert_equal(0, back[want])


void check_base85_vector(char* input_hex, char* plain, char* padded):
	int n = 0
	char* data = b85_test_unhex(input_hex, &n)
	for pad in range(2):
		char* want = plain
		if (pad != 0): want = padded
		char* got = base85_encode(data, n, pad)
		assert_strings_equal(want, got)
		free(got)
		int back_len = -1
		char* back = base85_decode(want, strlen(want), &back_len)
		assert_padded_roundtrip(data, n, back, back_len, pad)
		free(back)
	free(data)


void check_ascii85_vector(char* input_hex, int foldspaces, int wrapcol, int pad, int adobe, char* want):
	int n = 0
	char* data = b85_test_unhex(input_hex, &n)
	char* got = ascii85_encode(data, n, foldspaces, wrapcol, pad, adobe)
	assert_strings_equal(want, got)
	free(got)
	int back_len = -1
	char* back = ascii85_decode(want, strlen(want), foldspaces, adobe, &back_len)
	assert_padded_roundtrip(data, n, back, back_len, pad)
	free(back)
	free(data)


void check_decode_result(char* got, int got_len, int ok, char* want_hex):
	if (ok == 0):
		asserts(c"decoder accepted invalid input", got == 0)
		assert_equal(0, got_len)
		return
	asserts(c"decoder rejected valid input", got != 0)
	int n = 0
	char* want = b85_test_unhex(want_hex, &n)
	assert_equal(n, got_len)
	assert_bytes_equal(want, got, n)
	free(want)
	free(got)


void check_base85_decode(char* text, int ok, char* want_hex):
	int got_len = -1
	char* got = base85_decode(text, strlen(text), &got_len)
	check_decode_result(got, got_len, ok, want_hex)


void check_ascii85_decode(char* text, int foldspaces, int adobe, int ok, char* want_hex):
	int got_len = -1
	char* got = ascii85_decode(text, strlen(text), foldspaces, adobe, &got_len)
	check_decode_result(got, got_len, ok, want_hex)


void check_ascii85_decode_ignoring(char* text, char* ignorechars, int ok, char* want_hex):
	int got_len = -1
	char* got = ascii85_decode_ignoring(text, strlen(text), 0, 0, ignorechars, &got_len)
	check_decode_result(got, got_len, ok, want_hex)


