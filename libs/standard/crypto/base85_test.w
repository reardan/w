# Every byte value (and every 4-byte boundary) round-trips.
void test_base85_binary_roundtrip():
	int n = 256
	char* data = cast(char*, malloc(n))
	for i in range(n): data[i] = (255 - i) & 255
	for cut in range(4):
		int len = n - cut
		char* enc = base85_encode(data, len, 0)
		int back_len = 0
		char* back = base85_decode(enc, strlen(enc), &back_len)
		assert_padded_roundtrip(data, len, back, back_len, 0)
		free(back)
		free(enc)
		enc = ascii85_encode(data, len, 1, 0, 0, 1)
		back = ascii85_decode(enc, strlen(enc), 1, 1, &back_len)
		assert_padded_roundtrip(data, len, back, back_len, 0)
		free(back)
		free(enc)
	free(data)


void test_base85_negative_length():
	int got_len = 3
	char* got = base85_decode(c"", -1, &got_len)
	asserts(c"negative length accepted", got == 0)
	assert_equal(0, got_len)
	got_len = 3
	got = ascii85_decode(c"", -1, 0, 0, &got_len)
	asserts(c"negative length accepted", got == 0)
	assert_equal(0, got_len)
