# wbuild: x64
# wbuild: step="bin/mimetypes_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
#
# Expectations below the helpers are generated by CPython 3.13 from
# mimetypes.MimeTypes() with mimetypes.inited = True (no system
# mime.types files), so they pin the embedded default tables.
import lib.testing
import libs.standard.web.mimetypes


void check_guess(char* url, int strict, char* want_type, char* want_encoding):
	MimeGuess* guess = mimetypes_guess_type(url, strict)
	if ((strcmp(assert_text(want_type), assert_text(guess.type)) != 0) || (strcmp(assert_text(want_encoding), assert_text(guess.encoding)) != 0)):
		print2(c"guess_type mismatch for '")
		print2(url)
		println2(c"'")
	assert_strings_equal(want_type, guess.type)
	assert_strings_equal(want_encoding, guess.encoding)
	mime_guess_free(guess)


void check_extensions(char* type, int strict, char* want_first, char* want_all):
	char* first = mimetypes_guess_extension(type, strict)
	list[char*] all = mimetypes_guess_all_extensions(type, strict)
	char* joined = join(all, c",")
	if ((strcmp(assert_text(want_first), assert_text(first)) != 0) || (strcmp(want_all, joined) != 0)):
		print2(c"guess_extension mismatch for '")
		print2(type)
		println2(c"'")
	assert_strings_equal(want_first, first)
	assert_strings_equal(want_all, joined)
	if (first != 0): free(first)
	free(joined)
	mimetypes_free_extensions(all)


void test_mimetypes_defaults():
	MimeGuess* guess = mimetypes_guess_type(c"site/style.css")
	assert_strings_equal(c"text/css", guess.type)
	assert_strings_equal(0, guess.encoding)
	mime_guess_free(guess)
	guess = mimetypes_guess_file_type(c"backup.tgz")
	assert_strings_equal(c"application/x-tar", guess.type)
	assert_strings_equal(c"gzip", guess.encoding)
	mime_guess_free(guess)
	# guess_file_type never parses URLs: "?" stays part of the name.
	guess = mimetypes_guess_file_type(c"http://x/a.html?q=1")
	assert_strings_equal(0, guess.type)
	mime_guess_free(guess)
	guess = mimetypes_guess_file_type(c"photo.jpg", 0)
	assert_strings_equal(c"image/jpeg", guess.type)
	mime_guess_free(guess)
	char* ext = mimetypes_guess_extension(c"image/jpg")
	assert_strings_equal(0, ext)
	ext = mimetypes_guess_extension(c"image/jpg", 0)
	assert_strings_equal(c".jpg", ext)
	free(ext)
	mime_guess_free(0)
	mimetypes_free_extensions(0)


