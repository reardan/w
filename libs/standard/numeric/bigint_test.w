	bi_check(bigint_parse(c"-0b1011", 0), c"-11")
	bi_check(bigint_parse(c"0o777", 0), c"511")
	bi_check(bigint_parse(c"  +1_000_000 \n", 10), c"1000000")
	bi_check(bigint_parse(c"zz", 36), c"1295")
	bi_check(bigint_parse(c"ZZ", 36), c"1295")
	bi_check(bigint_parse(c"0b1", 16), c"177")
	bi_check(bigint_parse(c"0xff", 16), c"255")
