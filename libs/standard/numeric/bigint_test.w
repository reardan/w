# Expected values below were produced by CPython 3 (int, divmod, pow,
# math.isqrt/gcd/lcm/factorial, hex/oct/bin, int(s, base)).
import lib.testing
import libs.standard.numeric.bigint


# Asserts str(x) == want and frees x.
void bi_check(bigint* x, char* want):
	assert1(x != 0)
	char* got = bigint_to_string(x)
	assert_strings_equal(want, got)
	free(got)
	bigint_free(x)


bigint* bi(char* s):
	bigint* x = bigint_parse(s, 0)
	assert1(x != 0)
	return x


# Asserts that s has the given length, prefix and suffix, then frees s.
void bi_check_shape(char* s, int len, char* prefix, char* suffix):
	assert_equal(len, strlen(s))
	int pl = strlen(prefix)
	int sl = strlen(suffix)
	int i = 0
	while (i < pl):
		assert_equal(prefix[i], s[i])
		i = i + 1
	i = 0
	while (i < sl):
		assert_equal(suffix[i], s[len - sl + i])
		i = i + 1
	free(s)


void bi_check_binop(char* a, char* b, int op, char* want):
	bigint* x = bi(a)
	bigint* y = bi(b)
	bigint* r = 0
	if (op == 0): r = bigint_add(x, y)
	else if (op == 1): r = bigint_sub(x, y)
	else if (op == 2): r = bigint_mul(x, y)
	else if (op == 3): r = bigint_and(x, y)
	else if (op == 4): r = bigint_or(x, y)
	else if (op == 5): r = bigint_xor(x, y)
	else if (op == 6): r = bigint_gcd(x, y)
	else if (op == 7): r = bigint_lcm(x, y)
	bi_check(r, want)
	bigint_free(x)
	bigint_free(y)


void bi_check_divmod(char* a, char* b, char* wq, char* wr):
	bigint* x = bi(a)
	bigint* y = bi(b)
	bigint* q = 0
	bigint* r = 0
	assert_equal(1, bigint_divmod(x, y, &q, &r))
	bi_check(q, wq)
	bi_check(r, wr)
	bigint_free(x)
	bigint_free(y)


void test_from_int_and_small_values():
	bi_check(bigint_from_int(0), c"0")
	bi_check(bigint_from_int(1), c"1")
	bi_check(bigint_from_int(0 - 1), c"-1")
	bi_check(bigint_from_int(32767), c"32767")
	bi_check(bigint_from_int(32768), c"32768")
	bi_check(bigint_from_int(0 - 123456789), c"-123456789")


void test_int_round_trip_and_overflow():
	int wbits = __word_size__ * 8
	int max = ~(1 << (wbits - 1))
	int min = 1 << (wbits - 1)
	bigint* a = bigint_from_int(max)
	bigint* b = bigint_from_int(min)
	if (wbits == 32):
		bi_check(bigint_copy(a), c"2147483647")
		bi_check(bigint_copy(b), c"-2147483648")
	else:
		bi_check(bigint_copy(a), c"9223372036854775807")
		bi_check(bigint_copy(b), c"-9223372036854775808")
	int ok = 0
	assert_equal(max, bigint_to_int(a, &ok))
	assert_equal(1, ok)
	assert_equal(min, bigint_to_int(b, &ok))
	assert_equal(1, ok)
	bigint* a1 = bigint_add_int(a, 1)
	bigint* b1 = bigint_add_int(b, 0 - 1)
	assert_equal(0, bigint_fits_int(a1))
	assert_equal(0, bigint_fits_int(b1))
	assert_equal(0, bigint_to_int(a1, &ok))
	assert_equal(0, ok)
	bigint_to_int(b1, &ok)
	assert_equal(0, ok)
	# -(max + 1) == min fits, max + 1 does not.
	bigint* na1 = bigint_neg(a1)
	assert_equal(min, bigint_to_int(na1, &ok))
	assert_equal(1, ok)
	bigint* small = bigint_from_int(0 - 98765)
	assert_equal(0 - 98765, bigint_to_int(small, 0))
	bigint_free(a)
	bigint_free(b)
	bigint_free(a1)
	bigint_free(b1)
	bigint_free(na1)
	bigint_free(small)


void test_pow_and_factorial():
	bigint* two = bigint_from_int(2)
	bi_check(bigint_pow(two, 200), c"1606938044258990275541962092341162602522202993782792835301376")
	bi_check(bigint_pow(two, 0), c"1")
	assert1(bigint_pow(two, 0 - 1) == 0)
	bigint* zero = bigint_zero()
	bi_check(bigint_pow(zero, 0), c"1")
	bi_check(bigint_pow(zero, 5), c"0")
	bigint* m3 = bigint_from_int(0 - 3)
	bi_check(bigint_pow(m3, 3), c"-27")
	bi_check(bigint_pow(m3, 4), c"81")
	bi_check(bigint_factorial(100), c"93326215443944152681699238856266700490715968264381621468592963895217599993229915608941463976156518286253697920827223758251185210916864000000000000000000000000")
	bi_check(bigint_factorial(0), c"1")
	assert1(bigint_factorial(0 - 1) == 0)
	bigint* f = bigint_factorial(1000)
	bi_check_shape(bigint_to_string(f), 2568, c"402387260077093773543702433923", c"000000")
	bigint_free(f)
	bigint* m = bi(c"0x1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
	bi_check(bigint_copy(m), c"6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057151")
	bigint* p = bigint_pow(two, 521)
	bigint* p1 = bigint_add_int(p, 0 - 1)
	assert1(bigint_eq(p1, m))
	bigint_free(p)
	bigint_free(p1)
	bigint_free(m)
	bigint_free(two)
	bigint_free(zero)
	bigint_free(m3)


void test_divmod_floor_semantics():
	bi_check_divmod(c"7", c"2", c"3", c"1")
	bi_check_divmod(c"-7", c"2", c"-4", c"1")
	bi_check_divmod(c"7", c"-2", c"-4", c"-1")
	bi_check_divmod(c"-7", c"-2", c"3", c"-1")
	bi_check_divmod(c"0", c"-5", c"0", c"0")
	bi_check_divmod(c"-1000000000000000000000000000000", c"7", c"-142857142857142857142857142858", c"6")
	bi_check_divmod(c"1000000000000000000000000000005", c"-1000000000000", c"-1000000000000000001", c"-999999999995")
	bi_check_divmod(c"-1267650600228229401496703205376", c"12157665459056928801", c"-104267600100", c"6301373860137274724")
	bi_check_divmod(c"12157665459056928801", c"-1267650600228229401496703205376", c"-1", c"-1267650600216071736037646276575")
	bigint* x = bi(c"-3")
	bigint* z = bigint_zero()
	bigint* q = 0
	assert_equal(0, bigint_divmod(x, z, &q, 0))
	assert1(q == 0)
	assert1(bigint_floordiv(x, z) == 0)
	assert1(bigint_mod(x, z) == 0)
	bigint* big = bigint_pow(x, 95)
	bigint* seven = bigint_from_int(7)
	bi_check(bigint_floordiv(big, seven), c"-302985021006473445641658512501834963375724587")
	bigint* pos = bigint_neg(big)
	bigint* mk = bigint_from_int(0 - 1000)
	bi_check(bigint_mod(pos, mk), c"-893")
	bigint* tq = 0
	bigint* tr = 0
	bigint* m7 = bigint_from_int(0 - 7)
	bigint* two = bigint_from_int(2)
	assert_equal(1, bigint_divmod_trunc(m7, two, &tq, &tr))
	bi_check(tq, c"-3")
	bi_check(tr, c"-1")
	bigint_free(m7)
	bigint_free(two)
	bigint_free(x)
	bigint_free(z)
	bigint_free(big)
	bigint_free(seven)
	bigint_free(pos)
	bigint_free(mk)


void test_large_mul_and_div_against_python():
	bigint* three = bigint_from_int(3)
	bigint* seven = bigint_from_int(7)
	bigint* a = bigint_pow(three, 2000)
	bigint* b = bigint_pow(seven, 1500)
	bigint* p = bigint_mul(a, b)
	bi_check_shape(bigint_to_string(p), 2222, c"775477962763177541610126920949", c"301089688734807550982031340001")
	bigint* ten = bigint_from_int(10)
	bigint* d0 = bigint_pow(ten, 500)
	bigint* d = bigint_add_int(d0, 12345)
	bigint* q = 0
	bigint* r = 0
	bigint_divmod(p, d, &q, &r)
	bi_check_shape(bigint_to_string(q), 1722, c"775477962763177541610126920949", c"")
	bi_check_shape(bigint_to_string(r), 500, c"296412122200046088901402018687", c"24801282250078733916")
	# q*d + r == p
	bigint* back0 = bigint_mul(q, d)
	bigint* back = bigint_add(back0, r)
	assert1(bigint_eq(back, p))
	bigint_free(back0)
	bigint_free(back)
	bigint_free(q)
	bigint_free(r)
	bigint_free(d0)
	bigint_free(d)
	bigint_free(ten)
	bigint_free(p)
	bigint_free(a)
	bigint_free(b)
	bigint_free(three)
	bigint_free(seven)


void test_karatsuba_matches_schoolbook():
	bigint* three = bigint_from_int(0 - 3)
	bigint* five = bigint_from_int(5)
	int e = 50
	while (e < 4000):
		bigint* a = bigint_pow(three, e)
		bigint* b = bigint_pow(five, e / 3 + 7)
		bigint_set_karatsuba_threshold(100000)
		bigint* s = bigint_mul(a, b)
		bigint* s2 = bigint_mul(a, a)
		bigint_set_karatsuba_threshold(2)
		bigint* k = bigint_mul(a, b)
		bigint* k2 = bigint_mul(a, a)
		bigint_set_karatsuba_threshold(0)
		bigint* dflt = bigint_mul(b, a)
		assert1(bigint_eq(s, k))
		assert1(bigint_eq(s2, k2))
		assert1(bigint_eq(s, dflt))
		bigint_free(a)
		bigint_free(b)
		bigint_free(s)
		bigint_free(s2)
		bigint_free(k)
		bigint_free(k2)
		bigint_free(dflt)
		e = e * 3
	bigint_free(three)
	bigint_free(five)


void test_powmod():
	bigint* three = bigint_from_int(3)
	bigint* m = bigint_from_int(1000000007)
	bi_check(bigint_powmod_int(three, 1000, m), c"56888193")
	bigint* m7 = bigint_from_int(0 - 7)
	bigint* mm = bigint_from_int(0 - 1000003)
	bi_check(bigint_powmod_int(m7, 13, mm), c"-719743")
	bigint* seven = bigint_from_int(7)
	bi_check(bigint_powmod_int(three, 0 - 1, seven), c"5")
	bi_check(bigint_powmod_int(three, 0 - 1, m7), c"-2")
	bi_check(bigint_modinv(three, seven), c"5")
	bigint* six = bigint_from_int(6)
	bigint* nine = bigint_from_int(9)
	assert1(bigint_powmod_int(six, 0 - 1, nine) == 0)
	assert1(bigint_modinv(six, nine) == 0)
	bigint* zero = bigint_zero()
	assert1(bigint_powmod_int(three, 2, zero) == 0)
	bigint* one = bigint_from_int(1)
	bi_check(bigint_powmod_int(three, 0, one), c"0")
	bi_check(bigint_powmod_int(three, 0, seven), c"1")
	bigint* base = bi(c"0x7fffffffffffffffffffffffffffffff")
	bigint* mod = bi(c"10000000000000000000000000000000000000019")
	bi_check(bigint_powmod_int(base, 65537, mod), c"6671090319122223785807366124434012648315")
	bigint* b2 = bi(c"12345678901234567890")
	bigint* e2 = bi(c"0x1_0000_0000_0000_0001")
	bi_check(bigint_powmod(b2, e2, base), c"94059903157473917928716883819682562657")
	bigint_free(b2)
	bigint_free(e2)
	bigint_free(base)
	bigint_free(mod)
	bigint_free(one)
	bigint_free(zero)
	bigint_free(six)
	bigint_free(nine)
	bigint_free(seven)
	bigint_free(m7)
	bigint_free(mm)
	bigint_free(three)
	bigint_free(m)


void test_isqrt_gcd_lcm():
	bigint* a = bi(c"100000000000000000000000000000000000000000")
	bi_check(bigint_isqrt(a), c"316227766016837933199")
	bigint* ten = bigint_from_int(10)
	bigint* big = bigint_pow(ten, 401)
	bi_check(bigint_isqrt(big), c"316227766016837933199889354443271853371955513932521682685750485279259443863923822134424810837930029518734728415284005514854885603045388001469051959670015390334492165717925994065915015347411333948412408")
	bigint* two = bigint_from_int(2)
	bigint* p = bigint_pow(two, 200)
	bigint* p1 = bigint_add_int(p, 0 - 1)
	bi_check(bigint_isqrt(p1), c"1267650600228229401496703205375")
	bi_check(bigint_isqrt(p), c"1267650600228229401496703205376")
	bigint* z = bigint_zero()
	bi_check(bigint_isqrt(z), c"0")
	bigint* one = bigint_from_int(1)
	bi_check(bigint_isqrt(one), c"1")
	bigint* neg = bigint_from_int(0 - 4)
	assert1(bigint_isqrt(neg) == 0)
	bigint* f50 = bigint_factorial(50)
	bigint* g = bi(c"0x8000000000000000000000000")
	bigint* g3 = bigint_mul_int(g, 2187)
	bi_check(bigint_gcd(f50, g3), c"307792887033102336")
	bigint* nf = bigint_neg(f50)
	bi_check(bigint_gcd(nf, g3), c"307792887033102336")
	bi_check(bigint_gcd(z, z), c"0")
	bi_check(bigint_gcd(z, neg), c"4")
	bi_check_binop(c"1180591620717411303424", c"97261323672455430408", 7, c"14353237968448109868972222216943775514624")
	bi_check_binop(c"0", c"5", 7, c"0")
	bi_check_binop(c"-4", c"6", 7, c"12")
	bigint_free(a)
	bigint_free(ten)
	bigint_free(big)
	bigint_free(two)
	bigint_free(p)
	bigint_free(p1)
	bigint_free(z)
	bigint_free(one)
	bigint_free(neg)
	bigint_free(f50)
	bigint_free(g)
	bigint_free(g3)
	bigint_free(nf)


void test_add_sub_signs():
	bi_check_binop(c"5", c"-5", 0, c"0")
	bi_check_binop(c"-5", c"3", 0, c"-2")
	bi_check_binop(c"3", c"-5", 0, c"-2")
	bi_check_binop(c"-3", c"-5", 0, c"-8")
	bi_check_binop(c"0x7fff", c"1", 0, c"32768")
	bi_check_binop(c"1267650600228229401496703205376", c"1", 1, c"1267650600228229401496703205375")
	bi_check_binop(c"1", c"1267650600228229401496703205376", 1, c"-1267650600228229401496703205375")
	bi_check_binop(c"-1", c"-1", 1, c"0")
	bi_check_binop(c"-12345678901234567890", c"98765432109876543210", 2, c"-1219326311370217952237463801111263526900")
	bi_check_binop(c"0", c"-98765432109876543210", 2, c"0")
	bigint* x = bi(c"-42")
	bigint* y = bi(c"42")
	assert_equal(0 - 1, bigint_cmp(x, y))
	assert_equal(1, bigint_cmp(y, x))
	assert_equal(0, bigint_cmp_int(x, 0 - 42))
	assert_equal(1, bigint_cmp_int(x, 0 - 43))
	assert_equal(0 - 1, bigint_sign(x))
	bi_check(bigint_abs(x), c"42")
	bigint* big = bi(c"-1000000000000000000000")
	assert_equal(0 - 1, bigint_cmp(big, x))
	assert_equal(70, bigint_bit_length(big))
	assert_equal(0, bigint_is_odd(big))
	bigint_free(x)
	bigint_free(y)
	bigint_free(big)


void test_bitwise_and_shifts():
	char* x = c"-1237940039285380274899111879"   # -(2**90) + 12345
	char* y = c"37778931862956174055247"          # 2**75 - 987654321
	bi_check_binop(x, y, 3, c"4105")
	bi_check_binop(x, y, 4, c"-1237902260353517318725060737")
	bi_check_binop(x, y, 5, c"-1237902260353517318725064842")
	bi_check_binop(c"1237940039285380274899111879", y, 3, c"37778931862956174051143")
	bi_check_binop(x, c"-37778931862956174055247", 3, c"-1237940039285380274899115983")
	bi_check_binop(c"-1", c"-1", 3, c"-1")
	bi_check_binop(c"-1", c"0", 4, c"-1")
	bi_check_binop(c"12", c"10", 5, c"6")
	bigint* a = bi(x)
	bi_check(bigint_not(a), c"1237940039285380274899111878")
	bi_check(bigint_shr(a, 17), c"-9444732965739290427392")
	bi_check(bigint_shr(a, 200), c"-1")
	bi_check(bigint_shl(a, 33), c"-10633823966279326983230350439500218368")
	assert1(bigint_shl(a, 0 - 1) == 0)
	assert1(bigint_shr(a, 0 - 1) == 0)
	bigint* b = bi(y)
	bi_check(bigint_shr(b, 200), c"0")
	bi_check(bigint_shr(b, 0), y)
	bi_check(bigint_shr(b, 30), c"35184372088831")
	bigint* m8 = bigint_from_int(0 - 8)
	bi_check(bigint_shr(m8, 3), c"-1")
	bi_check(bigint_shr(m8, 4), c"-1")
	bigint* m9 = bigint_from_int(0 - 9)
	bi_check(bigint_shr(m9, 3), c"-2")
	bigint_free(a)
	bigint_free(b)
	bigint_free(m8)
	bigint_free(m9)


