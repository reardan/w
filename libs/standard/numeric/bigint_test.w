	assert1(bigint_parse(c"0x__1", 0) == 0)
	assert1(bigint_parse(c"012", 0) == 0)
	assert1(bigint_parse(c"12a", 10) == 0)
	assert1(bigint_parse(c"0x1f", 10) == 0)
	assert1(bigint_parse(c"2", 2) == 0)
	assert1(bigint_parse(c"1", 37) == 0)
	assert1(bigint_parse(c"1", 1) == 0)
	assert1(bigint_parse(c"1 2", 10) == 0)


void test_format():
	bigint* a = bi(c"-0xfffffffffffffffffffffffff")
	char* s = bigint_to_hex(a)
	assert_strings_equal(c"-0xfffffffffffffffffffffffff", s)
	free(s)
	bi_check(bigint_copy(a), c"-1267650600228229401496703205375")
	bigint_free(a)
	a = bi(c"-1152921504606846976")    # -(8**20)
	s = bigint_to_oct(a)
	assert_strings_equal(c"-0o100000000000000000000", s)
	free(s)
	bigint_free(a)
	a = bigint_from_int(0 - 5)
	s = bigint_to_bin(a)
	assert_strings_equal(c"-0b101", s)
	free(s)
	bigint_free(a)
	a = bigint_zero()
	s = bigint_to_hex(a)
	assert_strings_equal(c"0x0", s)
	free(s)
	s = bigint_to_string_base(a, 7)
	assert_strings_equal(c"0", s)
	free(s)
	assert1(bigint_to_string_base(a, 1) == 0)
	bigint_free(a)
	a = bigint_from_int(1295)
	s = bigint_to_string_base(a, 36)
	assert_strings_equal(c"zz", s)
	free(s)
	bigint_free(a)
	# Chunk boundaries: values whose lower decimal chunks are all zero.
	bi_check(bi(c"100000000000000000000000000000000000000000000000000"), c"100000000000000000000000000000000000000000000000000")
	bi_check(bi(c"100000000000000000000000000000000000000000000000001"), c"100000000000000000000000000000000000000000000000001")


void test_round_trips_all_bases():
	bigint* f = bigint_factorial(321)
	bigint* nf = bigint_neg(f)
	int base = 2
	while (base <= 36):
		char* s = bigint_to_string_base(nf, base)
		bigint* back = bigint_parse(s, base)
		assert1(back != 0)
		assert1(bigint_eq(back, nf))
		bigint_free(back)
		free(s)
		base = base + 1
	char* h = bigint_to_hex(f)
	bigint* hb = bigint_parse(h, 0)
	assert1(bigint_eq(hb, f))
	bigint_free(hb)
	free(h)
	bigint_free(f)
	bigint_free(nf)


void test_bytes():
	char* data = c"\x01\x00\xff\x80"
	bigint* a = bigint_from_bytes_be(data, 4)
	bi_check(bigint_copy(a), c"16842624")
	char* out = cast(char*, malloc(6))
	assert_equal(1, bigint_to_bytes_be(a, out, 6))
	assert_equal(0, out[0])
	assert_equal(0, out[1])
	assert_equal(1, out[2])
	assert_equal(0, out[3])
	assert_equal(255, out[4] & 255)
	assert_equal(128, out[5] & 255)
	assert_equal(0, bigint_to_bytes_be(a, out, 3))
	bigint* n = bigint_neg(a)
	assert_equal(0, bigint_to_bytes_be(n, out, 6))
	free(out)
	bigint_free(a)
	bigint_free(n)
	bi_check(bigint_from_bytes_be(data, 0), c"0")
