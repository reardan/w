# wbuild: x64
# wbuild: step="bin/decimal_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
# Expected values in the *_table / ops / rounding tests were produced by
# CPython 3's decimal module (the C libmpdec implementation) with
# Context(prec, rounding, Emin, Emax, clamp, traps=[]): result strings
# from str() and the context flags raised by each single operation.
import lib.testing
import libs.standard.numeric.decimal


void dec_ctx_set(decimal_context* ctx, int prec, int rounding, int emin, int emax, int clamp):
	ctx.prec = prec
	ctx.rounding = rounding
	ctx.emin = emin
	ctx.emax = emax
	ctx.clamp = clamp
	ctx.flags = 0


decimal* dec(char* s):
	decimal* d = decimal_parse(s)
	assert1(d != 0)
	return d


# Asserts str(d) == want and frees d.
void dec_check(decimal* d, char* want):
	assert1(d != 0)
	char* got = decimal_to_string(d)
	assert_strings_equal(want, got)
	free(got)
	decimal_free(d)


void dec_check_parse(char* s, char* want_sci, char* want_eng):
	decimal* d = dec(s)
	char* e = decimal_to_eng_string(d)
	assert_strings_equal(want_eng, e)
	free(e)
	dec_check(d, want_sci)


# Runs one context operation (codes as in gen_decimal.py: 0..11 binary,
# 20..27 unary) on fresh flags and checks the result string and flags.
void dec_row(decimal_context* ctx, int op, char* a, char* b, char* want, int want_flags):
	ctx.flags = 0
	if (op == 27):
		dec_check(decimal_context_create(ctx, a), want)
		assert_equal(want_flags, ctx.flags)
		return
	decimal* x = dec(a)
	decimal* r = 0
	if (op >= 20):
		if (op == 20): r = decimal_plus(x, ctx)
		else if (op == 21): r = decimal_minus(x, ctx)
		else if (op == 22): r = decimal_abs(x, ctx)
		else if (op == 23): r = decimal_sqrt(x, ctx)
		else if (op == 24): r = decimal_normalize(x, ctx)
		else if (op == 25): r = decimal_to_integral_value(x, 0 - 1, ctx)
		else if (op == 26): r = decimal_to_integral_exact(x, 0 - 1, ctx)
		dec_check(r, want)
		assert_equal(want_flags, ctx.flags)
		decimal_free(x)
		return
	decimal* y = dec(b)
	if (op == 11):
		decimal* qd = 0
		decimal* rd = 0
		decimal_divmod(x, y, &qd, &rd, ctx)
		char* qs = decimal_to_string(qd)
		char* rs = decimal_to_string(rd)
		char* both = strjoin(qs, c",")
		char* all = strjoin(both, rs)
		assert_strings_equal(want, all)
		free(qs)
		free(rs)
		free(both)
		free(all)
		decimal_free(qd)
		decimal_free(rd)
	else:
		if (op == 0): r = decimal_add(x, y, ctx)
		else if (op == 1): r = decimal_sub(x, y, ctx)
		else if (op == 2): r = decimal_mul(x, y, ctx)
		else if (op == 3): r = decimal_div(x, y, ctx)
		else if (op == 4): r = decimal_divide_int(x, y, ctx)
		else if (op == 5): r = decimal_remainder(x, y, ctx)
		else if (op == 6): r = decimal_remainder_near(x, y, ctx)
		else if (op == 7): r = decimal_compare(x, y, ctx)
		else if (op == 8): r = decimal_max(x, y, ctx)
		else if (op == 9): r = decimal_min(x, y, ctx)
		else if (op == 10): r = decimal_quantize(x, y, ctx)
		dec_check(r, want)
	if (want_flags != ctx.flags):
		print_string(c"flags mismatch: ", a)
		print_string(c" op ", b)
		print_int(c"", op)
	assert_equal(want_flags, ctx.flags)
	decimal_free(x)
	decimal_free(y)


void dec_check_big(bigint* v, char* want):
	assert1(v != 0)
	char* got = bigint_to_string(v)
	assert_strings_equal(want, got)
	free(got)
	bigint_free(v)


void dec_check_ints(char* a, char* want_int, char* want_round, char* want_floor, char* want_ceil, char* want_ratio):
	decimal* d = dec(a)
	dec_check_big(decimal_to_bigint(d), want_int)
	dec_check_big(decimal_to_bigint_rounded(d, DECIMAL_ROUND_HALF_EVEN), want_round)
	dec_check_big(decimal_to_bigint_rounded(d, DECIMAL_ROUND_FLOOR), want_floor)
	dec_check_big(decimal_to_bigint_rounded(d, DECIMAL_ROUND_CEILING), want_ceil)
	bigint* n = 0
	bigint* den = 0
	assert_equal(1, decimal_as_integer_ratio(d, &n, &den))
	char* ns = bigint_to_string(n)
	char* ds = bigint_to_string(den)
	char* t = strjoin(ns, c"/")
	char* all = strjoin(t, ds)
	assert_strings_equal(want_ratio, all)
	free(ns)
	free(ds)
	free(t)
	free(all)
	bigint_free(n)
	bigint_free(den)
	decimal_free(d)


void dec_check_order(char* a, char* b, int want_total, int want_cmp, int want_same_quantum):
	decimal* x = dec(a)
	decimal* y = dec(b)
	assert_equal(want_total, decimal_compare_total(x, y))
	assert_equal(want_cmp, decimal_cmp(x, y))
	assert_equal(want_cmp == 0, decimal_eq(x, y))
	assert_equal(want_same_quantum, decimal_same_quantum(x, y))
	decimal_free(x)
	decimal_free(y)


void test_construction_and_predicates():
	dec_check(decimal_from_int(0), c"0")
	dec_check(decimal_from_int(0 - 1234567), c"-1234567")
	bigint* b = bigint_from_string(c"-123456789012345678901234567890")
	dec_check(decimal_from_bigint(b), c"-123456789012345678901234567890")
	dec_check(decimal_from_bigint_scaled(b, 0 - 5), c"-1234567890123456789012345.67890")
	dec_check(decimal_from_bigint_scaled(b, 3), c"-1.23456789012345678901234567890E+32")
	bigint_free(b)
	dec_check(decimal_nan(), c"NaN")
	dec_check(decimal_infinity(1), c"-Infinity")
	decimal* d = dec(c"-12.50")
	assert_equal(1, decimal_is_signed(d))
	assert_equal(1, decimal_is_finite(d))
	assert_equal(0, decimal_is_zero(d))
	assert_equal(1, decimal_adjusted(d))
	assert_equal(0 - 2, decimal_exponent(d))
	dec_check(decimal_copy_abs(d), c"12.50")
	dec_check(decimal_copy_negate(d), c"12.50")
	dec_check(decimal_copy(d), c"-12.50")
	decimal_context* ctx = decimal_context_new()
	assert_equal(1, decimal_is_normal(d, ctx))
	assert_equal(0, decimal_is_subnormal(d, ctx))
	decimal* tiny = dec(c"1E-1000000")
	assert_equal(0, decimal_is_normal(tiny, ctx))
	assert_equal(1, decimal_is_subnormal(tiny, ctx))
	dec_check(decimal_round_digits(d, 1, ctx), c"-12.5")
	dec_check(decimal_round_digits(d, 0 - 1, ctx), c"-1E+1")
	decimal* half = dec(c"2.5")
	decimal* one = dec(c"1")
	dec_check(decimal_quantize_with(half, one, DECIMAL_ROUND_HALF_UP, ctx), c"3")
	dec_check(decimal_quantize_with(half, one, DECIMAL_ROUND_HALF_EVEN, ctx), c"2")
	decimal_free(one)
	decimal_free(half)
	decimal_free(tiny)
	decimal_free(d)
	decimal* n = dec(c"-sNaN12")
	assert_equal(1, decimal_is_nan(n))
	assert_equal(1, decimal_is_snan(n))
	assert_equal(0, decimal_is_qnan(n))
	assert1(decimal_to_bigint(n) == 0)
	bigint* x = 0
	bigint* y = 0
	assert_equal(0, decimal_as_integer_ratio(n, &x, &y))
	decimal_free(n)
	decimal* inf = dec(c"Inf")
	assert_equal(1, decimal_is_infinite(inf))
	assert1(decimal_to_bigint(inf) == 0)
	decimal_free(inf)
	decimal_context* c2 = decimal_context_copy(ctx)
	assert_equal(28, c2.prec)
	assert_equal(DECIMAL_ROUND_HALF_EVEN, c2.rounding)
	c2.flags = DECIMAL_INEXACT
	decimal_context_clear_flags(c2)
	assert_equal(0, c2.flags)
	decimal_context_free(c2)
	decimal_context_free(ctx)


