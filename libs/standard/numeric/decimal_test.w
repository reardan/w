void test_binary_ops_prec28():
	decimal_context* ctx = decimal_context_new()
	dec_ctx_set(ctx, 28, DECIMAL_ROUND_HALF_EVEN, -999999, 999999, 0)
	dec_row(ctx, 0, c"0", c"0", c"0", 0)
	dec_row(ctx, 0, c"0", c"-0", c"0", 0)
	dec_row(ctx, 0, c"0", c"-1", c"-1", 0)
