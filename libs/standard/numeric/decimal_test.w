void test_integer_conversions_table():
	dec_check_ints(c"0", c"0", c"0", c"0", c"0", c"0/1")
	dec_check_ints(c"-0", c"0", c"0", c"0", c"0", c"0/1")
	dec_check_ints(c"1.5", c"1", c"2", c"1", c"2", c"3/2")
	dec_check_ints(c"2.5", c"2", c"2", c"2", c"3", c"5/2")
	dec_check_ints(c"-2.5", c"-2", c"-2", c"-3", c"-2", c"-5/2")
	dec_check_ints(c"-1.5", c"-1", c"-2", c"-2", c"-1", c"-3/2")
	dec_check_ints(c"3.7", c"3", c"4", c"3", c"4", c"37/10")
	dec_check_ints(c"-3.7", c"-3", c"-4", c"-4", c"-3", c"-37/10")
	dec_check_ints(c"123.456", c"123", c"123", c"123", c"124", c"15432/125")
	dec_check_ints(c"1E+3", c"1000", c"1000", c"1000", c"1000", c"1000/1")
	dec_check_ints(c"-1.2E+5", c"-120000", c"-120000", c"-120000", c"-120000", c"-120000/1")
	dec_check_ints(c"0.0001", c"0", c"0", c"0", c"1", c"1/10000")
	dec_check_ints(c"-0.0001", c"0", c"0", c"-1", c"0", c"-1/10000")
	dec_check_ints(c"99999999999999999999.5", c"99999999999999999999", c"100000000000000000000", c"99999999999999999999", c"100000000000000000000", c"199999999999999999999/2")
	dec_check_ints(c"12345678901234567890123.4567", c"12345678901234567890123", c"12345678901234567890123", c"12345678901234567890123", c"12345678901234567890124", c"123456789012345678901234567/10000")
	dec_check_ints(c"1E+25", c"10000000000000000000000000", c"10000000000000000000000000", c"10000000000000000000000000", c"10000000000000000000000000", c"10000000000000000000000000/1")

void test_compare_total_and_cmp_table():
	dec_check_order(c"-NaN2", c"-NaN2", 0, 2, 1)
	dec_check_order(c"-NaN2", c"-NaN", -1, 2, 1)
	dec_check_order(c"-NaN2", c"-sNaN", -1, 2, 1)
	dec_check_order(c"-NaN2", c"-Infinity", -1, 2, 0)
	dec_check_order(c"-NaN2", c"-1", -1, 2, 0)
	dec_check_order(c"-NaN2", c"-1.0", -1, 2, 0)
	dec_check_order(c"-NaN2", c"-0", -1, 2, 0)
