void test_create_decimal_table():
	decimal_context* ctx = decimal_context_new()
	dec_ctx_set(ctx, 5, DECIMAL_ROUND_HALF_EVEN, -999999, 999999, 0)
	dec_row(ctx, 27, c"123.456789", c"", c"123.46", 24)
	dec_row(ctx, 27, c"-0.000012345678", c"", c"-0.000012346", 24)
	dec_row(ctx, 27, c"1e1000000", c"", c"Infinity", 88)
	dec_row(ctx, 27, c"1e-1000010", c"", c"0E-1000003", 185)
	dec_row(ctx, 27, c"NaN123456", c"", c"NaN", 2)
