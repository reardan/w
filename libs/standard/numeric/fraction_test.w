# wbuild: x64
# wbuild: step="bin/fraction_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
# Expected values in the *_table tests were produced by CPython 3's
# fractions.Fraction (str, + - * / // %, **, math.floor/ceil/trunc,
# round, limit_denominator, comparisons).
import lib.testing
import libs.standard.numeric.fraction


# Asserts str(f) == want and frees f.
void fr_check(fraction* f, char* want):
	assert1(f != 0)
	char* got = fraction_to_string(f)
	assert_strings_equal(want, got)
	free(got)
	fraction_free(f)


void fr_check_big(bigint* v, char* want):
	assert1(v != 0)
	char* got = bigint_to_string(v)
	assert_strings_equal(want, got)
	free(got)
	bigint_free(v)


fraction* fr(char* s):
	fraction* f = fraction_parse(s)
	assert1(f != 0)
	return f


# want_div/floordiv/mod are "" when b is zero (Python raises).
void fr_check_arith(char* a, char* b, char* want_add, char* want_sub, char* want_mul, char* want_div, char* want_floordiv, char* want_mod):
	fraction* x = fr(a)
	fraction* y = fr(b)
	fr_check(fraction_add(x, y), want_add)
	fr_check(fraction_sub(x, y), want_sub)
	fr_check(fraction_mul(x, y), want_mul)
	if (strlen(want_div) == 0):
		assert1(fraction_div(x, y) == 0)
		assert1(fraction_floordiv(x, y) == 0)
		assert1(fraction_mod(x, y) == 0)
		bigint* q = 0
		fraction* r = 0
		assert_equal(0, fraction_divmod(x, y, &q, &r))
		assert1(q == 0)
		assert1(r == 0)
	else:
		fr_check(fraction_div(x, y), want_div)
		fr_check_big(fraction_floordiv(x, y), want_floordiv)
		fr_check(fraction_mod(x, y), want_mod)
		bigint* q2 = 0
		fraction* r2 = 0
		assert_equal(1, fraction_divmod(x, y, &q2, &r2))
		fr_check_big(q2, want_floordiv)
		fr_check(r2, want_mod)
	fraction_free(x)
	fraction_free(y)


void fr_check_pow(char* a, int e, char* want):
	fraction* x = fr(a)
	fr_check(fraction_pow(x, e), want)
	fraction_free(x)


void fr_check_pow_null(char* a, int e):
	fraction* x = fr(a)
	assert1(fraction_pow(x, e) == 0)
	fraction_free(x)


void fr_check_round(char* a, char* want_floor, char* want_ceil, char* want_round, char* want_trunc):
	fraction* x = fr(a)
	fr_check_big(fraction_floor(x), want_floor)
	fr_check_big(fraction_ceil(x), want_ceil)
	fr_check_big(fraction_round(x), want_round)
	fr_check_big(fraction_trunc(x), want_trunc)
	fraction_free(x)


void fr_check_round_digits(char* a, int n, char* want):
	fraction* x = fr(a)
	fr_check(fraction_round_digits(x, n), want)
	fraction_free(x)


void fr_check_limit(char* a, int m, char* want):
	fraction* x = fr(a)
	fr_check(fraction_limit_denominator(x, m), want)
	fraction_free(x)


void fr_check_cmp(char* a, char* b, int want):
	fraction* x = fr(a)
	fraction* y = fr(b)
	assert_equal(want, fraction_cmp(x, y))
	assert_equal(want == 0, fraction_eq(x, y))
	fraction_free(x)
	fraction_free(y)


void test_construction():
	fr_check(fraction_from_int(0), c"0")
	fr_check(fraction_from_int(0 - 42), c"-42")
	fr_check(fraction_from_ints(6, 0 - 4), c"-3/2")
	fr_check(fraction_from_ints(0 - 6, 0 - 4), c"3/2")
	fr_check(fraction_from_ints(0, 0 - 9), c"0")
	assert1(fraction_from_ints(1, 0) == 0)
	bigint* n = bigint_from_string(c"-123456789012345678901234567890")
	bigint* d = bigint_from_string(c"987654321098765432109876543210")
	fr_check(fraction_from_bigints(n, d), c"-13717421/109739369")
	fr_check(fraction_from_bigint(n), c"-123456789012345678901234567890")
	bigint* z = bigint_zero()
	assert1(fraction_from_bigints(n, z) == 0)
	bigint_free(n)
	bigint_free(d)
	bigint_free(z)
	fraction* f = fr(c"-10/4")
	fr_check_big(bigint_copy(fraction_numerator(f)), c"-5")
	fr_check_big(bigint_copy(fraction_denominator(f)), c"2")
	assert_equal(0 - 1, fraction_sign(f))
	assert_equal(0, fraction_is_zero(f))
	assert_equal(0, fraction_is_integer(f))
	fr_check(fraction_neg(f), c"5/2")
	fr_check(fraction_abs(f), c"5/2")
	fr_check(fraction_copy(f), c"-5/2")
	fraction_free(f)
	fraction* w = fr(c"8/4")
	assert_equal(1, fraction_is_integer(w))
	fraction_free(w)
	fraction* o = fraction_from_int(1)
	assert1(fraction_limit_denominator(o, 0) == 0)
	fraction_free(o)


void test_parse_table():
	fr_check(fraction_parse(c"3/4"), c"3/4")
	fr_check(fraction_parse(c" -3 / 4 "), c"-3/4")
	fr_check(fraction_parse(c"1.25"), c"5/4")
	fr_check(fraction_parse(c"-2e3"), c"-2000")
	fr_check(fraction_parse(c"1_000/3"), c"1000/3")
	fr_check(fraction_parse(c".5"), c"1/2")
	fr_check(fraction_parse(c"5."), c"5")
	fr_check(fraction_parse(c"1e-3"), c"1/1000")
	fr_check(fraction_parse(c"2.5E+1"), c"25")
	fr_check(fraction_parse(c"-0"), c"0")
	fr_check(fraction_parse(c"  7  "), c"7")
	fr_check(fraction_parse(c"+12/18"), c"2/3")
	fr_check(fraction_parse(c"0/5"), c"0")
	assert1(fraction_parse(c"-6/-4") == 0)
	fr_check(fraction_parse(c"100/25"), c"4")
	fr_check(fraction_parse(c"123.456e2"), c"61728/5")
	fr_check(fraction_parse(c"1.5e-10"), c"3/20000000000")
	fr_check(fraction_parse(c"-.000125"), c"-1/8000")
	fr_check(fraction_parse(c"0001.2500"), c"5/4")
	fr_check(fraction_parse(c"12345678901234567890/98765432109876543210"), c"13717421/109739369")
	fr_check(fraction_parse(c"3.14159265358979323846264338327950288"), c"19634954084936207740391521145496893/6250000000000000000000000000000000")
	fr_check(fraction_parse(c"1_2.3_4e-1_0"), c"617/500000000000")
	assert1(fraction_parse(c"1/0") == 0)
	assert1(fraction_parse(c"3/-4") == 0)
	assert1(fraction_parse(c"1.5/2") == 0)
	assert1(fraction_parse(c"") == 0)
	assert1(fraction_parse(c"/") == 0)
	assert1(fraction_parse(c"1_/2") == 0)
	assert1(fraction_parse(c"0x10") == 0)
	assert1(fraction_parse(c".e1") == 0)
	assert1(fraction_parse(c"1e") == 0)
	assert1(fraction_parse(c"1__0") == 0)
	assert1(fraction_parse(c"_1") == 0)
	assert1(fraction_parse(c"1/") == 0)
	assert1(fraction_parse(c"/3") == 0)
	assert1(fraction_parse(c"1 2") == 0)
	assert1(fraction_parse(c"e5") == 0)
	assert1(fraction_parse(c".") == 0)
	assert1(fraction_parse(c"1.2.3") == 0)
	assert1(fraction_parse(c"--1") == 0)
	assert1(fraction_parse(c"+-1") == 0)
	assert1(fraction_parse(c"1/2/3") == 0)
	fr_check(fraction_parse(c"1.e5"), c"100000")
	assert1(fraction_parse(c"1e+5x") == 0)

