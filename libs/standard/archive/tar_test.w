void test_write_read_round_trip():
	tar_writer* w = tar_writer_new()
	assert_equal(0, tar_add_dir(w, c"top", -1, 1700000000))
	assert_equal(0, tar_add_file(w, c"top/a.txt", c"alpha", 5, -1, 1700000001))
	assert_equal(0, tar_add_file(w, c"top/empty", c"", 0, 384, 5))
	char* block = tt_repeat('x', 512)
	char* block1 = tt_repeat('y', 513)
	assert_equal(0, tar_add_file(w, c"top/block", block, 512, 493, 6))
	assert_equal(0, tar_add_file(w, c"top/block1", block1, 513, 420, 7))
	char* long_name = tt_name_of(c"top/", 'n', 150, c".txt")
	assert_equal(0, tar_add_file(w, long_name, c"L", 1, -1, 8))
	char* long_target = tt_name_of(c"", 't', 140, c"")
	assert_equal(0, tar_add_symlink(w, c"top/sym", long_target, 9))
	assert_equal(0, tar_add_hardlink(w, c"top/hard", c"top/a.txt", 10))
	tar_entry* e = tar_entry_new(c"top/ids", TAR_KIND_FILE)
	e.uid = 3000000
	e.gid = 77
	e.mtime = 0 - 12345
	tar_entry_set_string(&e.uname, c"a-user-name-that-is-longer-than-32-bytes")
	tar_entry_set_string(&e.gname, c"staff")
	e.data = c"ids"
	e.size = 3
	assert_equal(0, tar_writer_add(w, e))
	tar_entry_free(e)
	int length = 0
	char* data = tar_writer_finish(w, &length)
	assert_equal(0, length % 10240)

	tar_reader* r = tar_reader_new(data, length)
	list[tar_entry*] es = tt_read_all(r)
	assert_equal(0, tar_reader_error(r))
	assert_equal(9, es.length)
	tt_check_entry(es[0], c"top", TAR_KIND_DIR, 493, c"")
	assert_equal(1700000000, es[0].mtime)
	tt_check_entry(es[1], c"top/a.txt", TAR_KIND_FILE, 420, c"")
	tt_check_data(es[1], c"alpha")
	assert_equal(1700000001, es[1].mtime)
	tt_check_entry(es[2], c"top/empty", TAR_KIND_FILE, 384, c"")
	assert_equal(0, es[2].size)
	tt_check_entry(es[3], c"top/block", TAR_KIND_FILE, 493, c"")
	tt_check_data(es[3], block)
	tt_check_data(es[4], block1)
	tt_check_entry(es[5], long_name, TAR_KIND_FILE, 420, c"")
	tt_check_data(es[5], c"L")
	tt_check_entry(es[6], c"top/sym", TAR_KIND_SYMLINK, 511, long_target)
	tt_check_entry(es[7], c"top/hard", TAR_KIND_HARDLINK, 420, c"top/a.txt")
	tt_check_entry(es[8], c"top/ids", TAR_KIND_FILE, 420, c"")
	tt_check_owner(es[8], 3000000, 77, c"a-user-name-that-is-longer-than-32-bytes", c"staff", 0 - 12345)
	tt_check_data(es[8], c"ids")
	tar_entries_free(es)
	tar_reader_free(r)
	free(data)
	free(block)
	free(block1)
	free(long_name)
	free(long_target)


