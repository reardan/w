void test_special_and_unknown_types():
	int length = 0
	char* data = tt_one_file_archive(&length)
	data[156] = '6'
	tt_fix_checksum(data)
	tar_reader* r = tar_reader_new(data, length)
	tar_entry* e = tar_next(r)
	assert_equal(TAR_KIND_OTHER, e.kind)
	assert_equal('6', e.typeflag)
	tar_entry_free(e)
	# FIFO has no data: the next block (the file data "data") is read as a
	# header and fails its checksum.
	assert1(tar_next(r) == 0)
	assert_equal(TAR_ERR_BAD_CHECKSUM, tar_reader_error(r))
	tar_reader_free(r)
	data[156] = 'V'
	tt_fix_checksum(data)
	assert_equal(0, tt_read_status(data, length))
	char* dest = tt_temp_dir(c"special")
	assert_equal(TAR_ERR_SPECIAL_FILE, tar_extract_bytes(data, length, dest))
	assert_equal(0, path_exists(dest))
	free(dest)
	free(data)


