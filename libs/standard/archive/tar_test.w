void test_gnu_ustar_fixture():
	int length = 0
	char* data = fixture_gnu_ustar(&length)
	tar_reader* r = tar_reader_new(data, length)
	list[tar_entry*] es = tt_read_all(r)
	assert_equal(0, tar_reader_error(r))
	assert_equal(8, es.length)
	tt_check_entry(es[0], c"dir", TAR_KIND_DIR, 493, c"")
	assert_equal('5', es[0].typeflag)
	tt_check_entry(es[1], c"dir/hard.txt", TAR_KIND_FILE, 420, c"")
	tt_check_data(es[1], c"hello tar\n")
	tt_check_owner(es[1], 1000, 1000, c"user", c"group", 1704164645)
	tt_check_entry(es[2], c"dir/hello.txt", TAR_KIND_HARDLINK, 420, c"dir/hard.txt")
	assert_equal(0, cast(int, es[2].data))
	tt_check_entry(es[3], c"dir/link", TAR_KIND_SYMLINK, 511, c"hello.txt")
	tt_check_entry(es[4], c"dir/run.sh", TAR_KIND_FILE, 493, c"")
	tt_check_data(es[4], c"#!/bin/sh\necho hi\n")
	char* a60 = tt_name_of(c"dir/sub/", 'a', 60, c"")
	tt_check_entry(es[6], a60, TAR_KIND_DIR, 493, c"")
	# 133 bytes: stored through the ustar prefix field.
	char* b60 = tt_name_of(a60, 'b', 0, c"/")
	char* long_name = tt_name_of(b60, 'b', 60, c".txt")
	assert_equal(133, strlen(long_name))
	tt_check_entry(es[7], long_name, TAR_KIND_FILE, 420, c"")
	tt_check_data(es[7], c"long name\n")
	free(a60)
	free(b60)
	free(long_name)
	tar_entries_free(es)
	tar_reader_free(r)
	free(data)


