void test_extract_gnu_fixture():
	int length = 0
	char* data = fixture_gnu_ustar(&length)
	char* dest = tt_temp_dir(c"extract")
	assert_equal(0, tar_extract_bytes(data, length, dest))
	char* text = tt_read_text(dest, c"dir/hard.txt")
	assert_strings_equal(c"hello tar\n", text)
	free(text)
	text = tt_read_text(dest, c"dir/hello.txt")
	assert_strings_equal(c"hello tar\n", text)
	free(text)
	text = tt_read_text(dest, c"dir/link")
	assert_strings_equal(c"hello tar\n", text)
	free(text)
	char* target = tt_link_at(dest, c"dir/link")
	assert_strings_equal(c"hello.txt", target)
	free(target)
	assert_equal(493, tt_file_mode_at(dest, c"dir/run.sh") & 4095)
	assert_equal(420, tt_file_mode_at(dest, c"dir/hard.txt") & 4095)
	assert_equal(FILE_S_IFLNK, tt_file_mode_at(dest, c"dir/link") & FILE_S_IFMT)
	file_stat st
	char* full = path_join(dest, c"dir/run.sh")
	assert_equal(0, file_stat_path(full, &st))
	assert_equal(1704164645, st.mtime)
	free(full)
	full = path_join(dest, c"dir")
	assert_equal(0, file_stat_path(full, &st))
	assert_equal(1704164645, st.mtime)
	free(full)
	# Extracting again over the existing tree replaces files and links.
	assert_equal(0, tar_extract_bytes(data, length, dest))
	assert_equal(0, dir_remove_all(dest))
	free(dest)
	free(data)


void test_extract_all_safe_from_gz_file():
	char* dest = tt_temp_dir(c"gzdest")
	char* archive = tt_temp_dir(c"archive.tar.gz")
	tar_writer* w = tar_writer_new()
	tar_add_file(w, c"./a/b/c.txt", c"deep", 4, 4095, 0)
	tar_add_file(w, c"./x.txt", c"x", 1, 128, 0)
	tar_add_file(w, c"./ro.txt", c"r", 1, 146, 0)
	tar_add_dir(w, c"./", -1, 0)
	assert_equal(0, tar_write_file(w, archive, 1))
	assert_equal(0, tar_extract_all_safe(archive, dest))
	char* text = tt_read_text(dest, c"a/b/c.txt")
	assert_strings_equal(c"deep", text)
	free(text)
	# Data-filter modes: 07777 -> 0755, 0200 -> 0600, 0222 -> 0600.
	assert_equal(493, tt_file_mode_at(dest, c"a/b/c.txt") & 4095)
	assert_equal(384, tt_file_mode_at(dest, c"x.txt") & 4095)
	assert_equal(384, tt_file_mode_at(dest, c"ro.txt") & 4095)
	assert_equal(0, dir_remove_all(dest))
	unlink(archive)
	assert_equal(TAR_ERR_IO, tar_extract_all_safe(archive, dest))
	free(dest)
	free(archive)
	tt_drop_codec_caches()


# Each case: one safe member first, then the unsafe one; nothing may be
# written.
void tt_refuse(char* tag, int kind, char* name, char* linkname, int want):
	tar_writer* w = tar_writer_new()
	tar_add_file(w, c"safe.txt", c"ok", 2, -1, 0)
	tar_entry* e = tar_entry_new(name, kind)
	if (linkname != 0): tar_entry_set_string(&e.linkname, linkname)
	assert_equal(0, tar_writer_add(w, e))
	tar_entry_free(e)
	int length = 0
	char* data = tar_writer_finish(w, &length)
	char* dest = tt_temp_dir(tag)
	assert_equal(want, tar_extract_bytes(data, length, dest))
	assert_equal(0, path_exists(dest))
	free(dest)
	free(data)


