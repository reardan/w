# Helpers


int tt_hex_nibble(int c):
	if ((c >= '0') && (c <= '9')): return c - '0'
	return c - 'a' + 10


# Fixture text: hex byte pairs, with "Z<n>;" standing for n zero bytes;
# the result is zero-padded to total bytes. Frees s.
char* fixture_decode(string_builder* s, int total, int* length):
	char* out = cast(char*, malloc(total))
	mem_fill(out, 0, total)
	int pos = 0
	int i = 0
	while (i < s.length):
		int c = s.data[i]
		if (c == 'Z'):
			int n = 0
			i = i + 1
			while (s.data[i] != ';'):
				n = n * 10 + (s.data[i] - '0')
				i = i + 1
			i = i + 1
			pos = pos + n
		else:
			out[pos] = tt_hex_nibble(c) * 16 + tt_hex_nibble(s.data[i + 1])
			pos = pos + 1
			i = i + 2
	assert1(pos <= total)
	string_free(s)
	*length = total
	return out


char* tt_repeat(int c, int n):
	char* s = cast(char*, malloc(n + 1))
	mem_fill(s, cast(char, c), n)
	s[n] = 0
	return s


# prefix + n copies of c + suffix, malloc'd.
char* tt_name_of(char* prefix, int c, int n, char* suffix):
	string_builder* b = string_new()
	string_append(b, prefix)
	char* r = tt_repeat(c, n)
	string_append(b, r)
	free(r)
	string_append(b, suffix)
	char* s = b.data
	free(b)
	return s


list[tar_entry*] tt_read_all(tar_reader* r):
	list[tar_entry*] entries = new list[tar_entry*]
	tar_entry* e = tar_next(r)
	while (e != 0):
		entries.push(e)
		e = tar_next(r)
	return entries


# Reads data fully and returns tar_reader_error.
int tt_read_status(char* data, int length):
	tar_reader* r = tar_reader_new(data, length)
	list[tar_entry*] entries = tt_read_all(r)
	int status = tar_reader_error(r)
	tar_entries_free(entries)
	tar_reader_free(r)
	return status


void tt_check_entry(tar_entry* e, char* name, int kind, int mode, char* linkname):
	assert_strings_equal(name, e.name)
	assert_equal(kind, e.kind)
	assert_equal(mode, e.mode)
	assert_strings_equal(linkname, e.linkname)


void tt_check_data(tar_entry* e, char* text):
	assert_equal(strlen(text), e.size)
	assert_bytes_equal(text, e.data, e.size)


void tt_check_owner(tar_entry* e, int uid, int gid, char* uname, char* gname, int mtime):
	assert_equal(uid, e.uid)
	assert_equal(gid, e.gid)
	assert_strings_equal(uname, e.uname)
	assert_strings_equal(gname, e.gname)
	assert_equal(mtime, e.mtime)


# The gzip/deflate/crc32 modules build lookup tables lazily and keep them
# for the life of the process; drop them so the leak check sees a test
# that used gzip return to its starting heap.
void tt_free_cache(int** slot):
	if (*slot != 0): free(*slot)
	*slot = 0


void tt_drop_codec_caches():
	tt_free_cache(&crc32_table_cache)
	tt_free_cache(&dfl_fixed_litlen_lengths_cache)
	tt_free_cache(&dfl_fixed_litlen_codes_cache)
	tt_free_cache(&dfl_fixed_dist_lengths_cache)
	tt_free_cache(&dfl_fixed_dist_codes_cache)
	tt_free_cache(&inf_length_base_cache)
	tt_free_cache(&inf_length_extra_cache)
	tt_free_cache(&inf_dist_base_cache)
	tt_free_cache(&inf_dist_extra_cache)
	tt_free_cache(&inf_clc_order_cache)


# Recomputes a hand-patched header's checksum.
void tt_fix_checksum(char* h):
	tar_finish_header(h)


char* tt_temp_dir(char* tag):
	string_builder* s = string_new()
	string_append(s, c"bin/tar_test_")
	string_append_int(s, getpid())
	string_append_char(s, '_')
	string_append(s, tag)
	char* path = s.data
	free(s)
	dir_remove_all(path)
	return path


char* tt_read_text(char* dir, char* rel):
	char* full = path_join(dir, rel)
	char* data = 0
	int length = 0
	int status = tar_read_file(full, &data, &length)
	free(full)
	if (status != 0): return 0
	return data


int tt_file_mode_at(char* dir, char* rel):
	char* full = path_join(dir, rel)
	file_stat st
	int err = file_lstat_path(full, &st)
	free(full)
	if (err != 0): return -1
	return st.mode


char* tt_link_at(char* dir, char* rel):
	char* full = path_join(dir, rel)
	char* buf = cast(char*, malloc(512))
	int n = readlink(full, buf, 511)
	free(full)
	if (n < 0): n = 0
	buf[n] = 0
	return buf


