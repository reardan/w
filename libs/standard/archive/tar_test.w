# ---------------------------------------------------------------------------
# Malformed input


void test_truncated_archives_fail_cleanly():
	int length = 0
	char* data = fixture_py_pax(&length)
	# Find the end of the last member (the first all-zero block).
	int end = 0
	while (tar_block_is_zero(data + end) == 0): end = end + 512
	# Every prefix either reads cleanly (a cut on a member boundary, or
	# inside the final block's padding, which tarfile.py tolerates too)
	# or fails with TAR_ERR_TRUNCATED; a cut inside a header always fails.
	int cut = 0
	int truncated = 0
	while (cut < end):
		char* copy = mem_dup(data, cut)
		int status = tt_read_status(copy, cut)
		if (status != 0):
			assert_equal(TAR_ERR_TRUNCATED, status)
			truncated = truncated + 1
		free(copy)
		cut = cut + 1
	assert1(truncated > end / 2)
	assert_equal(TAR_ERR_TRUNCATED, tt_read_status(data, 512 + 100))
	assert_equal(TAR_ERR_TRUNCATED, tt_read_status(data, end - 1))
	free(data)


void test_gz_truncation_and_corruption():
	int length = 0
	char* data = fixture_py_gz(&length)
	# A 0- or 1-byte prefix is not recognisably gzip (empty / truncated tar).
	for cut in range(length):
		if (cut >= 2): assert1(tt_read_status(data, cut) != 0)
	data[length - 3] = data[length - 3] ^ 1
	assert_equal(GZIP_ERR_BAD_SIZE, tt_read_status(data, length))
	assert_strings_equal(c"gzip: decompressed size does not match the ISIZE trailer", tar_error_string(GZIP_ERR_BAD_SIZE))
	free(data)
	tt_drop_codec_caches()


char* tt_one_file_archive(int* length):
	tar_writer* w = tar_writer_new()
	tar_add_file(w, c"f", c"data", 4, -1, 0)
	return tar_writer_finish(w, length)


void test_bad_checksum():
	int length = 0
	char* data = tt_one_file_archive(&length)
	data[0] = 'g'
	assert_equal(TAR_ERR_BAD_CHECKSUM, tt_read_status(data, length))
	tt_fix_checksum(data)
	assert_equal(0, tt_read_status(data, length))
	# The historical signed-sum checksum is accepted too.
	data[400] = 200
	int sum = 0
	for i in range(512):
		int b = data[i] & 255
		if ((i >= 148) && (i < 156)): b = ' '
		if (b >= 128): b = b - 256
		sum = sum + b
	tar_put_octal(data, 148, 7, sum)
	assert_equal(0, tt_read_status(data, length))
	free(data)


void test_bad_numeric_field():
	int length = 0
	char* data = tt_one_file_archive(&length)
	data[100] = '9'
	tt_fix_checksum(data)
	assert_equal(TAR_ERR_BAD_HEADER, tt_read_status(data, length))
	# Space-padded numbers parse (old tars wrote them).
	mem_copy(data + 100, c"   644 \x00", 8)
	tt_fix_checksum(data)
	tar_reader* r = tar_reader_new(data, length)
	tar_entry* e = tar_next(r)
	assert_equal(420, e.mode)
	tar_entry_free(e)
	tar_reader_free(r)
	# Base-256 negative size.
	mem_fill(data + 124, cast(char, 255), 12)
	tt_fix_checksum(data)
	assert_equal(TAR_ERR_BAD_HEADER, tt_read_status(data, length))
	# Base-256 size larger than any word.
	mem_fill(data + 124, cast(char, 127), 12)
	data[124] = cast(char, 128)
	tt_fix_checksum(data)
	assert_equal(TAR_ERR_TOO_LARGE, tt_read_status(data, length))
	free(data)


# An 11-digit octal size (8 GiB) does not fit a 32-bit word: x86 says
# TOO_LARGE; x64 parses it and finds the data missing.
void test_large_size_field():
	int length = 0
	char* data = tt_one_file_archive(&length)
	mem_copy(data + 124, c"77777777777\x00", 12)
	tt_fix_checksum(data)
	int status = tt_read_status(data, length)
	if (__word_size__ == 4): assert_equal(TAR_ERR_TOO_LARGE, status)
	else: assert_equal(TAR_ERR_TRUNCATED, status)
	int value = 0
	status = tar_parse_number(c"77777777777", 12, &value)
	if (__word_size__ == 4): assert_equal(TAR_ERR_TOO_LARGE, status)
	else:
		assert_equal(0, status)
		assert1(value > 2147483647)
	free(data)


# Builds "x" pax header with the given records + one member, then reads.
int tt_pax_status(char* records):
	tar_writer* w = tar_writer_new()
	int n = strlen(records)
	char* ph = tar_new_header(c"././@PaxHeader", 'x', 420, n, 0)
	tar_finish_header(ph)
	string_append_bytes(w.out, ph, 512)
	tar_append_padded(w.out, records, n)
	free(ph)
	tar_add_file(w, c"member", c"abc", 3, -1, 0)
	int length = 0
	char* data = tar_writer_finish(w, &length)
	int status = tt_read_status(data, length)
	free(data)
	return status


void test_pax_records():
	assert_equal(0, tt_pax_status(c"12 uid=1234\n"))
	assert_equal(0, tt_pax_status(c"23 comment=ignored key\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"99 uid=1234\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"13 uid=1234\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"uid=1\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"7 uid1\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"12 uid=12a4\n"))
	assert_equal(TAR_ERR_BAD_PAX, tt_pax_status(c"12 size=-12\n"))
	# The pax size overrides the header and must be backed by data.
	assert_equal(TAR_ERR_TRUNCATED, tt_pax_status(c"16 size=1000000\n"))
	int status = tt_pax_status(c"23 size=99999999999999\n")
	if (__word_size__ == 4): assert_equal(TAR_ERR_TOO_LARGE, status)
	else: assert_equal(TAR_ERR_TRUNCATED, status)
	assert_equal(TAR_ERR_TOO_LARGE, tt_pax_status(c"36 size=999999999999999999999999999\n"))


