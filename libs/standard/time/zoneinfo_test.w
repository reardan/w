# wbuild: x64
# wbuild: deps=tests/data/tz/
# wbuild: step="bin/zoneinfo_test" env="W_TEST_LEAKS=1" expect_stdout="0 failed, 0 skipped [leak check]"
# Zone fixtures live in tests/data/tz/ (real TZif files copied from
# tzdata 2026c plus hand-built ones from tests/data/tz/make_fixtures.w);
# the test runs from the repo root and never reads the host's
# /usr/share/zoneinfo. The zcases_* expectations are generated by
# tests/data/tz/gen_cases.py from Python's zoneinfo on the same files.
import lib.testing
import libs.standard.time.zoneinfo


char* zt_dir():
	return c"tests/data/tz"


zoneinfo* zt_load(char* key):
	zoneinfo* z = zoneinfo_load_from(key, zt_dir())
	asserts(c"zoneinfo fixture failed to load", z != 0)
	assert_strings_equal(key, zoneinfo_key(z))
	return z


void zt_report(char* what, zoneinfo* z, int year, int month, int day, int hour, int minute, int second):
	print(what)
	print(zoneinfo_key(z))
	print_int(c" year ", year)
	print_int(c" month ", month)
	print_int(c" day ", day)
	print_int(c" hour ", hour)
	print_int(c" minute ", minute)
	print_int(c" second ", second)


# fromutc of a UTC wall time: the local fields, offset, fold, and the
# dst/abbreviation Python reports for the (fold-tagged) result.
void zt_utc(zoneinfo* z, int year, int month, int day, int hour, int minute, int second, int ly, int lmo, int ld, int lh, int lmi, int ls, int offset, int dst, char* abbr, int fold):
	datetime utc = datetime_with_offset(datetime_new(year, month, day, hour, minute, second, 0), 0)
	int got_fold = 0 - 1
	datetime got = zoneinfo_fromutc(z, utc, &got_fold)
	zoneinfo_period p = zoneinfo_lookup_local(z, got, got_fold)
	int ok = (got.d.year == ly) && (got.d.month == lmo) && (got.d.day == ld)
	ok = ok && (got.t.hour == lh) && (got.t.minute == lmi) && (got.t.second == ls)
	ok = ok && (got.has_offset == 1) && (got.utc_offset == offset) && (got_fold == fold)
	ok = ok && (p.dst == dst) && (strcmp(p.abbr, abbr) == 0)
	if (!ok):
		zt_report(c"fromutc mismatch for UTC", z, year, month, day, hour, minute, second)
		print_int(c" got offset ", got.utc_offset)
		print_int(c" got fold ", got_fold)
		print_int(c" got hour ", got.t.hour)
		print_int(c" got dst ", p.dst)
		print(p.abbr)
	assert1(ok)
	int ts = 0
	if (datetime_to_unix_checked(utc, &ts)):
		assert_equal(offset, zoneinfo_offset_at(z, ts))
		assert_equal(offset, datetime_from_unix_zone(ts, z).utc_offset)


# utcoffset/dst/tzname of a naive local wall time with a fold.
void zt_local(zoneinfo* z, int year, int month, int day, int hour, int minute, int second, int fold, int offset, int dst, char* abbr):
	datetime local = datetime_new(year, month, day, hour, minute, second, 0)
	zoneinfo_period p = zoneinfo_lookup_local(z, local, fold)
	int ok = (p.utc_offset == offset) && (p.dst == dst) && (strcmp(p.abbr, abbr) == 0)
	if (!ok):
		zt_report(c"local lookup mismatch", z, year, month, day, hour, minute, second)
		print_int(c" fold ", fold)
		print_int(c" got offset ", p.utc_offset)
		print_int(c" got dst ", p.dst)
		print(p.abbr)
	assert1(ok)


# ---- hand-written tests -------------------------------------------------------

void test_tz_string_rules():
	zoneinfo* z = zoneinfo_from_tz_string(c"EST5EDT,M3.2.0,M11.1.0")
	assert_strings_equal(c"EST5EDT,M3.2.0,M11.1.0", zoneinfo_key(z))
	datetime july = datetime_new(2024, 7, 1, 12, 0, 0, 0)
	assert_equal(0 - 14400, zoneinfo_utcoffset(z, july, 0))
	assert_equal(3600, zoneinfo_dst(z, july, 0))
	assert_strings_equal(c"EDT", zoneinfo_tzname(z, july, 0))
	datetime jan = datetime_new(2024, 1, 1, 12, 0, 0, 0)
	assert_equal(0 - 18000, zoneinfo_utcoffset(z, jan, 0))
	assert_equal(0, zoneinfo_dst(z, jan, 0))
	assert_strings_equal(c"EST", zoneinfo_tzname(z, jan, 0))
	# Year 9999 works on every word size (rules are per-year seconds).
	assert_equal(0 - 14400, zoneinfo_utcoffset(z, datetime_new(9999, 7, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)

	z = zoneinfo_from_tz_string(c"<+0530>-5:30")
	assert_equal(19800, zoneinfo_utcoffset(z, july, 0))
	assert_strings_equal(c"+0530", zoneinfo_tzname(z, july, 1))
	zoneinfo_free(z)

	# Explicit DST offset, transition times with seconds and negative times.
	z = zoneinfo_from_tz_string(c"AAA3BBB1:30,M3.2.0/2:30:15,M11.1.0/-1")
	assert_equal(0 - 5400, zoneinfo_utcoffset(z, july, 0))
	assert_equal(5400, zoneinfo_dst(z, july, 0))
	# 2024-03-10 02:30:14 is before the switch, 02:30:15 in the gap.
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 3, 10, 2, 30, 14, 0), 1))
	assert_equal(0 - 5400, zoneinfo_utcoffset(z, datetime_new(2024, 3, 10, 2, 30, 15, 0), 1))
	# End at -1:00 on Sunday Nov 3 is 23:00 on Saturday Nov 2.
	assert_equal(0 - 5400, zoneinfo_utcoffset(z, datetime_new(2024, 11, 2, 21, 29, 59, 0), 0))
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 11, 2, 23, 0, 0, 0), 0))
	zoneinfo_free(z)

	# v3 extension: transition hours up to 167.
	z = zoneinfo_from_tz_string(c"XXX3YYY,M3.2.0/167,M11.1.0")
	assert1(z != 0)
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 3, 16, 12, 0, 0, 0), 0))
	assert_equal(0 - 7200, zoneinfo_utcoffset(z, datetime_new(2024, 3, 17, 0, 0, 0, 0), 0))
	zoneinfo_free(z)


void test_tz_string_day_rules():
	# n counts from 0 (59 is Feb 29 in leap years, else Mar 1); J61 is
	# always Mar 2.
	zoneinfo* z = zoneinfo_from_tz_string(c"AAA3BBB,59/0,J61/0")
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2023, 2, 28, 12, 0, 0, 0), 0))
	assert_equal(0 - 7200, zoneinfo_utcoffset(z, datetime_new(2023, 3, 1, 12, 0, 0, 0), 0))
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2023, 3, 2, 12, 0, 0, 0), 0))
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 2, 28, 12, 0, 0, 0), 0))
	assert_equal(0 - 7200, zoneinfo_utcoffset(z, datetime_new(2024, 2, 29, 12, 0, 0, 0), 0))
	assert_equal(0 - 7200, zoneinfo_utcoffset(z, datetime_new(2024, 3, 1, 12, 0, 0, 0), 0))
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 3, 2, 12, 0, 0, 0), 0))
	zoneinfo_free(z)
	z = zoneinfo_from_tz_string(c"AAA3BBB,0/0,J1/12")
	assert_equal(0 - 7200, zoneinfo_utcoffset(z, datetime_new(2024, 1, 1, 6, 0, 0, 0), 0))
	assert_equal(0 - 10800, zoneinfo_utcoffset(z, datetime_new(2024, 1, 1, 13, 0, 0, 0), 0))
	zoneinfo_free(z)


void zt_reject(char* tz):
	zoneinfo* z = zoneinfo_from_tz_string(tz)
	if (z != 0):
		print(tz)
		zoneinfo_free(z)
	assert1(z == 0)


