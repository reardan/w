void test_utc_zone():
	zoneinfo* z = zoneinfo_utc()
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	datetime dt = datetime_new(2024, 7, 1, 12, 0, 0, 0)
	assert_equal(0, zoneinfo_utcoffset(z, dt, 0))
	assert_strings_equal(c"UTC", zoneinfo_tzname(z, dt, 0))
	assert_equal(ZONEINFO_LOCAL_UNIQUE, zoneinfo_local_kind(z, dt))
	zoneinfo_free(z)


void test_key_validation():
	assert_equal(1, zoneinfo_key_is_valid(c"UTC"))
	assert_equal(1, zoneinfo_key_is_valid(c"America/New_York"))
	assert_equal(1, zoneinfo_key_is_valid(c"Etc/GMT+5"))
	assert_equal(0, zoneinfo_key_is_valid(0))
	assert_equal(0, zoneinfo_key_is_valid(c""))
	assert_equal(0, zoneinfo_key_is_valid(c"/etc/localtime"))
	assert_equal(0, zoneinfo_key_is_valid(c"../UTC"))
	assert_equal(0, zoneinfo_key_is_valid(c"America/../UTC"))
	assert_equal(0, zoneinfo_key_is_valid(c"./UTC"))
	assert_equal(0, zoneinfo_key_is_valid(c"America//New_York"))
	assert_equal(0, zoneinfo_key_is_valid(c"America/"))
	assert_equal(0, zoneinfo_key_is_valid(c"America\\New_York"))


void test_load_from_directory():
	zoneinfo* z = zt_load(c"America/New_York")
	zoneinfo_free(z)
	assert1(zoneinfo_load_from(c"America/Nowhere", zt_dir()) == 0)
	# A directory and an invalid key are not zones.
	assert1(zoneinfo_load_from(c"America", zt_dir()) == 0)
	assert1(zoneinfo_load_from(c"../tz/UTC", zt_dir()) == 0)
	assert1(zoneinfo_load_from(c"UTC", 0) == 0)
	# The generator script is not TZif.
	assert1(zoneinfo_load_from(c"make_fixtures.w", zt_dir()) == 0)
	z = zoneinfo_from_file(c"tests/data/tz/Asia/Kolkata", 0)
	assert1(zoneinfo_key(z) == 0)
	assert_equal(19800, zoneinfo_utcoffset(z, datetime_new(2024, 1, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)


void test_from_bytes_rejects_damaged_files():
	int length = 0
	char* data = zoneinfo_read_file(c"tests/data/tz/Australia/Lord_Howe", &length)
	assert1(data != 0)
	zoneinfo* z = zoneinfo_from_bytes(data, length, c"x")
	assert1(z != 0)
	zoneinfo_free(z)
	# Every proper prefix is rejected (v2 files end with "\n<TZ>\n").
	int n = 0
	while (n < length):
		z = zoneinfo_from_bytes(data, n, 0)
		if (z != 0):
			print_int(c"accepted truncated length ", n)
			zoneinfo_free(z)
		assert1(z == 0)
		n = n + 3
	# Bad magic and bad version byte.
	data[0] = 'X'
	assert1(zoneinfo_from_bytes(data, length, 0) == 0)
	data[0] = 'T'
	data[4] = 'x'
	assert1(zoneinfo_from_bytes(data, length, 0) == 0)
	data[4] = '2'
	# A bad footer.
	data[length - 3] = ','
	assert1(zoneinfo_from_bytes(data, length, 0) == 0)
	free(data)
	assert1(zoneinfo_from_file(c"tests/data/tz/missing", 0) == 0)


void test_local_zone_resolution():
	zoneinfo* z = zoneinfo_local_from(0, 0, c"tests/data/tz/Europe/London")
	assert_strings_equal(c"localtime", zoneinfo_key(z))
	assert_equal(3600, zoneinfo_utcoffset(z, datetime_new(2024, 7, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)
	z = zoneinfo_local_from(0, 0, c"tests/data/tz/missing")
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c"", zt_dir(), c"tests/data/tz/Europe/London")
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c":", zt_dir(), 0)
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c":America/New_York", zt_dir(), 0)
	assert_strings_equal(c"America/New_York", zoneinfo_key(z))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c"Asia/Kolkata", zt_dir(), 0)
	assert_equal(19800, zoneinfo_utcoffset(z, datetime_new(2024, 7, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)
	# Not a key in the directory: read as a POSIX TZ string.
	z = zoneinfo_local_from(c"EST5EDT,M3.2.0,M11.1.0", zt_dir(), 0)
	assert_equal(0 - 14400, zoneinfo_utcoffset(z, datetime_new(2024, 7, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c"JST-9", zt_dir(), 0)
	assert_strings_equal(c"JST", zoneinfo_tzname(z, datetime_new(2024, 7, 1, 0, 0, 0, 0), 0))
	zoneinfo_free(z)
	# Neither a key, a file nor a TZ string: UTC.
	z = zoneinfo_local_from(c"Nowhere/Zone", zt_dir(), 0)
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	zoneinfo_free(z)
	z = zoneinfo_local_from(c"/nonexistent/zone/file", zt_dir(), 0)
	assert_strings_equal(c"UTC", zoneinfo_key(z))
	zoneinfo_free(z)


void test_local_now_smoke():
	zoneinfo* z = zoneinfo_local()
	assert1(z != 0)
	zoneinfo_free(z)
	datetime now = datetime_now_local()
	assert_equal(1, now.has_offset)
	assert1(now.d.year >= 2020)
	datetime utc = datetime_now_utc()
	zoneinfo* u = zoneinfo_utc()
	datetime same = datetime_now_zone(u)
	assert_equal(0, same.utc_offset)
	assert1(duration_total_seconds(datetime_diff(same, utc)) < 60)
	zoneinfo_free(u)


void test_fold_and_gap_new_york():
	zoneinfo* z = zt_load(c"America/New_York")
	# Fall back: 01:30 happens twice.
	datetime amb = datetime_new(2024, 11, 3, 1, 30, 0, 0)
	assert_equal(ZONEINFO_LOCAL_AMBIGUOUS, zoneinfo_local_kind(z, amb))
	assert_equal(0 - 14400, zoneinfo_utcoffset(z, amb, 0))
	assert_equal(0 - 18000, zoneinfo_utcoffset(z, amb, 1))
	assert_strings_equal(c"EDT", zoneinfo_tzname(z, amb, 0))
	assert_strings_equal(c"EST", zoneinfo_tzname(z, amb, 1))
	datetime first = datetime_to_utc(zoneinfo_localize(z, amb, 0))
	datetime second = datetime_to_utc(zoneinfo_localize(z, amb, 1))
	assert_equal(5, first.t.hour)
	assert_equal(6, second.t.hour)
	int fold = 0 - 1
	datetime back = zoneinfo_fromutc(z, second, &fold)
	assert_equal(1, fold)
	assert_equal(1, back.t.hour)
	assert_equal(30, back.t.minute)
	back = zoneinfo_fromutc(z, first, &fold)
	assert_equal(0, fold)
	# Spring forward: 02:30 never happens; fold 0 reads it with the
	# offset before the jump (07:30Z, shown as 03:30 EDT), fold 1 after.
	datetime gap = datetime_new(2024, 3, 10, 2, 30, 0, 0)
	assert_equal(ZONEINFO_LOCAL_NONEXISTENT, zoneinfo_local_kind(z, gap))
	datetime g0 = datetime_to_utc(zoneinfo_localize(z, gap, 0))
	datetime g1 = datetime_to_utc(zoneinfo_localize(z, gap, 1))
	assert_equal(7, g0.t.hour)
	assert_equal(6, g1.t.hour)
	back = zoneinfo_fromutc(z, g0, &fold)
	assert_equal(3, back.t.hour)
	assert_equal(0, fold)
	assert_equal(ZONEINFO_LOCAL_UNIQUE, zoneinfo_local_kind(z, datetime_new(2024, 7, 1, 2, 30, 0, 0)))
	# Round trip every 10 minutes across both transition days: fromutc
	# then localize with the reported fold gives back the instant.
	int day = 0
	while (day < 2):
		datetime start = datetime_with_offset(datetime_new(2024, 3, 10, 0, 0, 0, 0), 0)
		if (day == 1): start = datetime_with_offset(datetime_new(2024, 11, 3, 0, 0, 0, 0), 0)
		int step = 0
		while (step < 24 * 6):
			datetime u = datetime_add(start, duration_from_seconds(step * 600))
			datetime local = zoneinfo_fromutc(z, u, &fold)
			datetime again = zoneinfo_localize(z, local, fold)
			assert_equal(0, datetime_compare(u, again))
			assert_equal(local.utc_offset, again.utc_offset)
			step = step + 1
		day = day + 1
	zoneinfo_free(z)


void test_fromutc_inputs_and_timestamps():
	zoneinfo* z = zt_load(c"America/New_York")
	# An aware input at another offset; nanoseconds pass through.
	datetime tokyo = datetime_with_offset(datetime_new(2023, 11, 15, 7, 13, 20, 123456789), 32400)
	int fold = 0
	datetime local = zoneinfo_fromutc(z, tokyo, &fold)
	assert_equal(2023, local.d.year)
	assert_equal(11, local.d.month)
	assert_equal(14, local.d.day)
	assert_equal(17, local.t.hour)
	assert_equal(123456789, local.t.nanosecond)
	assert_equal(0 - 18000, local.utc_offset)
	# A naive input is read as UTC.
	datetime naive = zoneinfo_fromutc(z, datetime_new(2023, 11, 14, 22, 13, 20, 0), 0)
	assert_equal(17, naive.t.hour)
	datetime from_ts = datetime_from_unix_zone(1700000000, z)
	assert_equal(17, from_ts.t.hour)
	assert_equal(13, from_ts.t.minute)
	assert_equal(20, from_ts.t.second)
	assert_equal(0 - 18000, zoneinfo_offset_at(z, 1700000000))
	assert_equal(0 - 14400, zoneinfo_offset_at(z, 1690000000))
	assert_equal(1700000000, datetime_to_unix(from_ts))
	zoneinfo_free(z)


