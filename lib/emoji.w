# Emoji presentation (UTS #51) for font selection (issue #827).
#
# emoji_is_presentation(cp) is the Emoji_Presentation property: characters
# shown as emoji by default. emoji_presentation_utf8 decides a whole
# grapheme: VS15 (U+FE0E) asks for text, VS16 (U+FE0F) or any character
# with Emoji_Presentation (a base emoji, a skin-tone modifier, a regional
# indicator) asks for emoji, and anything else has no preference.
#
# The table is Unicode 15.0's emoji-data.txt (matching tools/unicode),
# its Emoji_Presentation ranges merged: 81 entries of a 3-byte big-endian
# first and last codepoint each.
import lib.lib
import lib.utf8


const int EMOJI_PRESENTATION_NONE = 0
const int EMOJI_PRESENTATION_EMOJI = 1
const int EMOJI_PRESENTATION_TEXT = 2


