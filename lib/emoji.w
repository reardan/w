int emoji_u24(char* table, int at):
	return ((table[at] & 255) << 16) | ((table[at + 1] & 255) << 8) | (table[at + 2] & 255)


# Whether cp has the Emoji_Presentation property.
int emoji_is_presentation(int cp):
	if ((cp < 0x231a) || (cp > 0x1faf8)): return 0
	char* table = emoji_presentation_ranges()
	int lo = 0
	int hi = 80
	while (lo <= hi):
		int mid = (lo + hi) >> 1
		if (cp < emoji_u24(table, mid * 6)): hi = mid - 1
		else if (cp > emoji_u24(table, mid * 6 + 3)): lo = mid + 1
		else: return 1
	return 0


# The presentation the grapheme text[start, end) asks for.
int emoji_presentation_utf8(char* text, int start, int end):
	int emoji = 0
	int at = start
	while (at < end):
		int cp = 0
		int n = utf8_scan(text + at, end - at, &cp)
		if (n <= 0): n = 1
		at = at + n
		if (cp == 0xfe0e): return EMOJI_PRESENTATION_TEXT
		if ((cp == 0xfe0f) || emoji_is_presentation(cp)): emoji = 1
	if (emoji): return EMOJI_PRESENTATION_EMOJI
	return EMOJI_PRESENTATION_NONE
