# wbuild: binary=javascript_unicode
# Regenerate JavaScript identifier tables from the vendored Unicode subset.
import tools.host_tools

void jsu_function(string_builder* out, char* prop, list[int] ranges):
	string_builder* raw = string_new()
	int lo = -1
	int hi = -1
	for i in range(ranges.length / 2 + 1):
		int next_lo = -1
		int next_hi = -1
		if (i < ranges.length / 2):
			next_lo = ranges[i * 2]
			next_hi = ranges[i * 2 + 1]
		if (lo >= 0 && next_lo != hi + 1):
			for j in range(3): string_append_char(raw, (lo >> (j * 8)) & 255)
			for j in range(3): string_append_char(raw, (hi >> (j * 8)) & 255)
			lo = -1
		if (lo < 0): lo = next_lo
		hi = next_hi
	string_append(out, c"int js_unicode_")
	string_append(out, prop)
	string_append(out, c"(int codepoint):\n\tchar* data = c\"")
	string_append(out, ht_literal(raw.data, raw.length, 1))
	string_append(out, c"\"\n\treturn js_unicode_contains(data, ")
	string_append_int(out, raw.length / 6)
	string_append(out, c", codepoint)\n")
	string_free(raw)

int main(int argc, int argv):
	args_init(argc, argv)
	ht_require(argc == 1 || (argc == 2 && strcmp(args_get(1), c"--check") == 0), c"usage: javascript_unicode [--check]")
	list[int] starts = new list[int]
	list[int] continues = new list[int]
	list[char*] lines = file_read_lines(c"libs/extras/javascript/unicode_12_1.ranges")
	ht_require(lines != 0, c"cannot read Unicode ranges")
	for char* line in lines:
		if (line[0] == 0 || line[0] == '#'): continue
		list[char*] fields = ht_split(line, ';')
		ht_require(fields.length == 2, c"invalid Unicode range")
		list[char*] span = ht_split(fields[0], '.')
		ht_require(span.length == 3, c"invalid Unicode span")
		list[int] target = starts
		if (strcmp(fields[1], c"ID_Continue") == 0): target = continues
		else: ht_require(strcmp(fields[1], c"ID_Start") == 0, c"unknown Unicode property")
		target.push(from_hex(span[0]))
		target.push(from_hex(span[2]))
	string_builder* out = string_from(c"# Generated by tools/javascript_unicode.w; Unicode 12.1.0.\n# Copyright Unicode, Inc.; see UNICODE-LICENSE.txt and unicode_12_1.ranges.\nimport lib.lib\n\n\nint js_unicode_u24(char* data, int offset):\n\treturn (data[offset] & 255) | ((data[offset + 1] & 255) << 8) | ((data[offset + 2] & 255) << 16)\n\n\nint js_unicode_contains(char* data, int count, int codepoint):\n\tint lo = 0\n\tint hi = count\n\twhile (lo < hi):\n\t\tint mid = lo + (hi - lo) / 2\n\t\tint first = js_unicode_u24(data, mid * 6)\n\t\tint last = js_unicode_u24(data, mid * 6 + 3)\n\t\tif (codepoint < first): hi = mid\n\t\telse if (codepoint > last): lo = mid + 1\n\t\telse: return 1\n\treturn 0\n\n\n")
	jsu_function(out, c"id_start", starts)
	string_append(out, c"\n\n")
	jsu_function(out, c"id_continue", continues)
	ht_generated(c"libs/extras/javascript/unicode.w", out, argc == 2)
	return 0
