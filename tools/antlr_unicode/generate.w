# wbuild: binary=antlr_unicode tag=tests
# Java 17 remains the independent Unicode/case reference; orchestration is W.
import tools.host_tools
import libs.standard.cli.argparse

int main(int argc, int argv):
	arg_parser* parser = argparse_new(c"antlr_unicode")
	argparse_add_positional(parser, c"jar", c"checksum-pinned ANTLR 4.13.2 jar")
	argparse_arg_default(argparse_add_option(parser, c"--output", c"FILE", c"generated W module"), c"libs/extras/grammars/antlr_to_pg/unicode_data.w")
	arg_namespace* args = argparse_parse_or_exit(parser, argc, argv)
	char* jar = tempfile_abspath(argparse_get(args, c"jar"))
	string_builder* jar_data = ht_read(jar)
	ht_require(strcmp(ht_digest(jar_data.data, jar_data.length), c"eae2dfa119a64327444672aff63e9ec35a20180dc5b8090b7a6ab85125df4d76") == 0, c"ANTLR jar SHA-256 mismatch")
	ht_require(ht_contains(ht_checked(ht_command(c"java -version")).stderr_text, c"version \"17."), c"case mapping reference requires Java 17")
	char* directory = ht_temp()
	list[char*] command = ht_command(c"javac -cp")
	command.push(jar)
	command.push(c"-d")
	command.push(directory)
	command.push(c"tools/antlr_unicode/UnicodeDump.java")
	ht_checked(command)
	command = ht_command(c"java -cp")
	command.push(strjoin(strjoin(directory, c":"), jar))
	command.push(c"UnicodeDump")
	process_result* result = ht_checked(command)
	char* digest = ht_digest(result.stdout_text, result.stdout_length)
	ht_require(strcmp(digest, c"866e7aa3a82fa98b5ce14e0b635fb3b25e1d8a51b3e4589026fe5929dcba550d") == 0, c"reference Unicode/case data checksum mismatch")
	list[char*] properties = new list[char*]
	list[char*] aliases = new list[char*]
	list[char*] cases = new list[char*]
	for char* line in ht_split(result.stdout_text, 10):
		if (line[0] == 0): continue
		list[char*] fields = ht_split(line, 9)
		ht_require(fields.length >= 3, c"invalid Unicode reference record")
		string_builder* assignment = string_new()
		if (strcmp(fields[0], c"P") == 0):
			string_append(assignment, c"\tg_at_unicode_properties[c\"")
			string_append(assignment, fields[1])
			string_append(assignment, c"\"] = c\"")
			for i in range(2, fields.length):
				if (i > 2): string_append_char(assignment, ',')
				string_append(assignment, fields[i])
			string_append(assignment, c"\"")
			properties.push(assignment.data)
		else if (strcmp(fields[0], c"A") == 0):
			string_append(assignment, c"\tg_at_unicode_properties[c\"")
			string_append(assignment, fields[1])
			string_append(assignment, c"\"] = g_at_unicode_properties[c\"")
			string_append(assignment, fields[2])
			string_append(assignment, c"\"]")
			aliases.push(assignment.data)
		else if (strcmp(fields[0], c"C") == 0):
			ht_require(fields.length == 4, c"invalid Unicode case record")
			string_append(assignment, c"\tg_at_unicode_lower[")
			string_append(assignment, fields[1])
			string_append(assignment, c"] = ")
			string_append(assignment, fields[2])
			string_append(assignment, c"\n\tg_at_unicode_upper[")
			string_append(assignment, fields[1])
			string_append(assignment, c"] = ")
			string_append(assignment, fields[3])
			cases.push(assignment.data)
	list[char*] assignments = new list[char*]
	for char* line in properties: assignments.push(line)
	for char* line in aliases: assignments.push(line)
	for char* line in cases: assignments.push(line)
	string_builder* out = string_from(c"# Generated by tools/antlr_unicode/generate.w; do not edit.\n# Reference: ANTLR 4.13.2 UnicodeData and Java 17 Character mappings.\n# See tools/antlr_unicode/README.md for provenance and licenses.\nimport lib.lib\n\nmap[char*, char*] g_at_unicode_properties\nmap[int, int] g_at_unicode_lower\nmap[int, int] g_at_unicode_upper\n\n")
	for i in range(assignments.length):
		if (i % 100 == 0):
			string_append(out, c"void at_unicode_data_part_")
			string_append_int(out, i / 100)
			string_append(out, c"():\n")
		string_append(out, assignments[i])
		string_append_char(out, 10)
		if (i % 100 == 99 || i == assignments.length - 1): string_append(out, c"\n\n")
	string_append(out, c"void at_unicode_data_init():\n\tif (g_at_unicode_properties != 0): return\n\tg_at_unicode_properties = new map[char*, char*]\n\tg_at_unicode_lower = new map[int, int]\n\tg_at_unicode_upper = new map[int, int]\n")
	for i in range((assignments.length + 99) / 100):
		string_append(out, c"\tat_unicode_data_part_")
		string_append_int(out, i)
		string_append(out, c"()\n")
	ht_write(argparse_get(args, c"output"), out.data, out.length)
	ht_cleanup()
	println(strjoin(strjoin(strjoin(strjoin(strjoin(strjoin(itoa(properties.length), c" properties, "), itoa(aliases.length)), c" aliases, "), itoa(cases.length)), c" case mappings; source SHA256 "), digest))
	return 0
