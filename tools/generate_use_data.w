# wbuild: target=use_data tag=generated dep=wv2 input=tools/unicode/use_categories.txt input=tools/generate_use_data.w output=lib/ttf_use_data.w
# wbuild: step="bin/wv2 tools/generate_use_data.w -o bin/generate_use_data"
# wbuild: step="bin/generate_use_data"
# Emits lib/ttf_use_data.w, the Universal Shaping Engine category table
# behind lib/ttf_use.w (issue #825), from the committed
# tools/unicode/use_categories.txt: HarfBuzz 15.0.0's USE categories as
# "XXXX..YYYY; CAT" ranges (extracted by tools/use_categories_hb.py).
# Unlisted codepoints are O (Other).
#
# The table is a byte-string literal of 4-byte entries (24-bit
# big-endian start, 1-byte category): an entry's category covers every
# codepoint up to the next entry's start. Categories keep HarfBuzz's
# numbers (hb-ot-shaper-use-machine.rl), which lib/ttf_use.w names
# ttf_use_*.
#
# Run from the repo root: ./wbuild use_data
import lib.lib
import lib.stream
import structures.string


const int gen_max_cp = 1114111


void gen_fail(char* message, char* detail):
	wstream* err = stderr_writer()
	stream_write_cstr(err, c"generate_use_data: ")
	stream_write_cstr(err, message)
	if (detail != 0):
		stream_write_cstr(err, c": ")
		stream_write_cstr(err, detail)
	stream_write_line(err, c"")
	stream_flush(err)
	exit(1)


# HarfBuzz's USE category names and numbers, as name=number pairs.
char* gen_use_names():
	return c"O=0 B=1 N=4 GB=5 CGJ=6 SUB=11 H=12 HN=13 ZWNJ=14 WJ=16 R=18 VPre=22 VMPre=23 FAbv=24 FBlw=25 FPst=26 MAbv=27 MBlw=28 MPst=29 MPre=30 CMAbv=31 CMBlw=32 VAbv=33 VBlw=34 VPst=35 VMAbv=37 VMBlw=38 VMPst=39 SMAbv=41 SMBlw=42 CS=43 IS=44 FMAbv=45 FMBlw=46 FMPst=47 Sk=48 G=49 J=50 SB=51 SE=52 HVM=53 HM=54 HR=55 RK=56"


# The number of category name, or -1.
int gen_use_category(char* name):
	char* names = gen_use_names()
	int i = 0
	while (names[i] != 0):
		int j = 0
		while ((name[j] != 0) && (names[i + j] == name[j])): j = j + 1
		if ((name[j] == 0) && (names[i + j] == '=')):
			int value = 0
			int k = i + j + 1
			while ((names[k] >= '0') && (names[k] <= '9')):
				value = value * 10 + names[k] - '0'
				k = k + 1
			return value
		while ((names[i] != ' ') && (names[i] != 0)): i = i + 1
		if (names[i] == ' '): i = i + 1
	return -1


int gen_hex_digit(int c):
	if ((c >= '0') && (c <= '9')): return c - '0'
	if ((c >= 'A') && (c <= 'F')): return c - 'A' + 10
	if ((c >= 'a') && (c <= 'f')): return c - 'a' + 10
	return -1


# The hex number at text[at[0]], advancing at past it.
int gen_hex(char* text, int* at):
	int value = 0
	int digits = 0
	while (gen_hex_digit(text[at[0]]) >= 0):
		value = value * 16 + gen_hex_digit(text[at[0]])
		at[0] = at[0] + 1
		digits = digits + 1
	if (digits == 0): gen_fail(c"expected a hex codepoint", text)
	return value


# One "XXXX..YYYY; CAT" line into table; comments and blank lines are skipped.
void gen_line(char* line, char* table):
	if ((line[0] == '#') || (line[0] == 0)): return
	int at = 0
	int first = gen_hex(line, &at)
	int last = first
	if ((line[at] == '.') && (line[at + 1] == '.')):
		at = at + 2
		last = gen_hex(line, &at)
	if (line[at] != ';'): gen_fail(c"expected ';'", line)
	at = at + 1
	while (line[at] == ' '): at = at + 1
	int value = gen_use_category(&line[at])
	if (value < 0): gen_fail(c"unknown USE category", line)
	if ((first > last) || (last > gen_max_cp)): gen_fail(c"bad codepoint range", line)
	for cp in range(first, last + 1): table[cp] = value


void gen_hex_byte(string_builder* out, int value):
	char* digits = c"0123456789abcdef"
	string_append_char(out, 92)
	string_append_char(out, 'x')
	string_append_char(out, digits[(value >> 4) & 15])
	string_append_char(out, digits[value & 15])


int main(int argc, int argv):
	char* input = c"tools/unicode/use_categories.txt"
	wstream* src = stream_open_read(input)
	if (src == 0): gen_fail(c"cannot open (run from the repo root)", input)
	char* table = cast(char*, malloc(gen_max_cp + 1))
	for cp in range(gen_max_cp + 1): table[cp] = 0
	string_builder* line = string_new()
	while (stream_read_line(src, line)): gen_line(line.data, table)
	stream_close(src)
	string_builder* literal = string_new()
	int count = 0
	for cp in range(gen_max_cp + 1):
		if ((cp == 0) || (table[cp] != table[cp - 1])):
			gen_hex_byte(literal, cp >> 16)
			gen_hex_byte(literal, cp >> 8)
			gen_hex_byte(literal, cp)
			gen_hex_byte(literal, table[cp])
			count = count + 1
	char* path = c"lib/ttf_use_data.w"
	wstream* out = stream_open_write(path)
	if (out == 0): gen_fail(c"cannot write", path)
	stream_write_line(out, c"# Generated by tools/generate_use_data.w from tools/unicode/use_categories.txt")
	stream_write_line(out, c"# (HarfBuzz 15.0.0's Universal Shaping Engine categories).")
	stream_write_line(out, c"# A build output, never committed: any ./wbuild run regenerates it (issue #323).")
	stream_write_line(out, c"# A range table of 4-byte entries (24-bit big-endian start, category byte);")
	stream_write_line(out, c"# the categories are lib/ttf_use.w's ttf_use_* numbers.")
	stream_write_line(out, c"")
	stream_write_line(out, c"")
	stream_write_line(out, c"int ttd_use_count():")
	stream_write_cstr(out, c"\treturn ")
	stream_write_int(out, count)
	stream_write_line(out, c"")
	stream_write_line(out, c"")
	stream_write_line(out, c"")
	stream_write_line(out, c"char* ttd_use():")
	stream_write_cstr(out, c"\treturn c\"")
	stream_write(out, literal.data, literal.length)
	stream_write_line(out, c"\"")
	stream_close(out)
	print(f"generated {path}\n")
	return 0
