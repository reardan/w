# wbuild: binary=html_entities
# Regenerate pinned WHATWG HTML entities, validating source and scalar values.
import tools.host_tools
import lib.utf8

int main(int argc, int argv):
	args_init(argc, argv)
	ht_require(argc == 1 || (argc == 2 && strcmp(args_get(1), c"--check") == 0), c"usage: html_entities [--check]")
	char* pin = c"d741d877ac77c4194c4ad526b5b4a19aef8dfe411ab840a466891cdbb9f362e6"
	string_builder* raw = ht_read(c"libs/extras/html/entities.json")
	ht_require(strcmp(ht_digest(raw.data, raw.length), pin) == 0, c"HTML entities.json checksum mismatch; review provenance before updating the pin")
	json_value* entries = json_parse(raw.data)
	ht_require(entries != 0 && entries.type == json_type_object(), c"invalid HTML entities JSON")
	list[char*] names = entries.object_values.keys()
	# Insertion sort uses unsigned ASCII ordering, as the source generator did.
	for i in range(1, names.length):
		char* name = names[i]
		int j = i
		while (j > 0 && bytes_compare(names[j - 1], strlen(names[j - 1]), name, strlen(name)) > 0):
			names[j] = names[j - 1]
			j = j - 1
		names[j] = name
	string_builder* records = string_new()
	string_builder* offsets = string_new()
	int max_name = 0
	for char* name in names:
		int size = strlen(name)
		ht_require(size > 1 && name[0] == '&', c"invalid entity name")
		for i in range(1, size):
			int ch = name[i]
			ht_require((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || (ch == ';' && i == size - 1 && i > 1), c"invalid entity name")
		json_value* entry = json_object_get(entries, name)
		json_value* text = json_object_get(entry, c"characters")
		json_value* points = json_object_get(entry, c"codepoints")
		ht_require(text != 0 && text.type == json_type_string() && points != 0 && points.type == json_type_array(), c"invalid entity value")
		int count = json_array_length(points)
		ht_require(count >= 1 && count <= 2, c"invalid entity scalar count")
		int pos = 0
		int length = strlen(text.string_value)
		for i in range(count):
			int cp = 0
			int n = utf8_scan(text.string_value + pos, length - pos, &cp)
			json_value* point = json_array_get(points, i)
			ht_require(n > 0 && cp != 0 && point.type == json_type_int() && point.int_value == cp, c"invalid entity scalar value")
			pos = pos + n
		ht_require(pos == length, c"entity codepoints disagree with characters")
		string_append_char(offsets, records.length & 255)
		string_append_char(offsets, records.length >> 8)
		string_append_bytes(records, name + 1, size)
		string_append_bytes(records, text.string_value, length + 1)
		if (size - 1 > max_name): max_name = size - 1
	ht_require(records.length <= 65535, c"HTML entity data exceeds its 16-bit offset format")
	string_builder* out = string_from(c"# Generated by tools/html_entities.w; do not edit.\n# Copyright WHATWG (Apple, Google, Mozilla, Microsoft).\n# BSD-3-Clause for source-code incorporation; see WHATWG-LICENSE.txt.\n# entities.json SHA-256: ")
	string_append(out, pin)
	string_append(out, c"\nimport lib.lib\n\nconst int HTML_ENTITY_COUNT = ")
	string_append_int(out, names.length)
	string_append(out, c"\nconst int HTML_ENTITY_MAX_NAME = ")
	string_append_int(out, max_name)
	string_append(out, c"\n\n# Borrowed immutable name-NUL / UTF-8-value-NUL records, sorted by name.\n# Bytewise little-endian offsets work on every target without alignment assumptions.\nchar* html_entity_entry(int index):\n\tif ((index < 0) || (index >= HTML_ENTITY_COUNT)): return 0\n\tchar* offsets = c\"")
	string_append(out, ht_literal(offsets.data, offsets.length, 0))
	string_append(out, c"\"\n\tchar* records = c\"")
	string_append(out, ht_literal(records.data, records.length, 0))
	string_append(out, c"\"\n\tint offset = (offsets[index * 2] & 255) | ((offsets[index * 2 + 1] & 255) << 8)\n\treturn records + offset\n")
	ht_generated(c"libs/extras/html/entities.w", out, argc == 2)
	return 0
