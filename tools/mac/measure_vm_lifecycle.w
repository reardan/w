# wbuild: binary=measure_vm_lifecycle arch=x64 tag=tests
import tools.mac.vm_harness
import tools.mac.vm_evidence

json_value* ml_records
int ml_sample
void ml_record(char* operation, int start):
	json_value* row = vj_one(c"operation", operation)
	vj_i(row, c"sample", ml_sample)
	vj_f(row, c"milliseconds", cast(float, vm_ns() - start) / 1000000.0)
	json_array_push(ml_records, row)

int main(int argc, int argv):
	arg_parser* parser = argparse_new(c"measure_vm_lifecycle")
	for char* name in ht_command(c"--worker --daemon --guest --output"): argparse_arg_required(argparse_add_option(parser, name, c"PATH", c"artifact path"))
	argparse_arg_default(argparse_add_int(parser, c"--samples", c"N", c"samples per operation"), c"5")
	arg_namespace* args = argparse_parse_or_exit(parser, argc, argv)
	int samples = argparse_get_int(args, c"samples")
	ht_require(samples >= 5 && samples <= 100, c"--samples must be 5..100")
	vm_native()
	char* worker = ht_resolve(argparse_get(args, c"worker"))
	char* daemon = ht_resolve(argparse_get(args, c"daemon"))
	char* guest = ht_resolve(argparse_get(args, c"guest"))
	char* output = argparse_get(args, c"output")
	ht_mkdir(path_dirname(output))
	ml_records = json_array()
	char* work = ht_temp()
	for sample in range(samples):
		ml_sample = sample
		char* path = path_join(work, strjoin(strjoin(c"sample-", itoa(sample)), c".sock"))
		int start = vm_ns()
		hm_sample* process = vm_start(daemon, worker, path, 1, 1)
		json_value* capabilities = vm_ok(path, c"capabilities")
		ht_require(strcmp(ht_text(capabilities, c"host_backend"), c"hypervisor.framework") == 0, c"native HV backend required")
		ml_record(c"daemon_process_start", start)
		start = vm_ns()
		char* cold = ht_text(vm_ok(path, c"vm_spawn", vm_image(guest)), c"session")
		vm_state(path, cold)
		ml_record(c"cold_image_spawn_ready", start)
		vm_execute(path, cold, c"hello", 7, c"hello from an ARM64 cell", 5000)
		vm_ok(path, c"vm_destroy", vj_one(c"session", cold))
		start = vm_ns()
		char* template_id = ht_text(vm_ok(path, c"template_create", vm_image(guest)), c"template")
		ml_record(c"template_capture", start)
		start = vm_ns()
		char* clone = ht_text(vm_ok(path, c"vm_spawn", vm_template(template_id)), c"session")
		vm_state(path, clone)
		ml_record(c"template_clone_spawn_ready", start)
		start = vm_ns()
		vm_execute(path, clone, c"hello", 7, c"hello from an ARM64 cell", 5000)
		ml_record(c"clone_first_command", start)
		vm_execute(path, clone, c"alloc", 0, c"cell allocator containers FP OK", 5000)
		start = vm_ns()
		vm_ok(path, c"vm_restore", vj_one(c"session", clone))
		vm_state(path, clone)
		ml_record(c"restore_after_dirty_ready", start)
		start = vm_ns()
		vm_execute(path, clone, c"hello", 7, c"hello from an ARM64 cell", 5000)
		ml_record(c"restored_first_command", start)
		vm_ok(path, c"vm_destroy", vj_one(c"session", clone))
		vm_ok(path, c"template_destroy", vj_one(c"template", template_id))
		json_value* stats = vm_ok(path, c"stats")
		ht_require(ht_number(stats, c"sessions") == 0 && ht_number(stats, c"templates") == 0 && ht_number(stats, c"active") == 0, c"lifecycle leaked daemon resources")
		vm_ok(path, c"stop")
		hm_finish(process, 5000)
		char* log_path = path_join(path_dirname(output), strjoin(strjoin(c"lifecycle-daemon-", itoa(sample)), c".log"))
		char* log = strjoin(ht_read(process.stdout_path).data, ht_read(process.stderr_path).data)
		ht_write(log_path, log, strlen(log))
		ht_require(process.status == 0 && !process.timed_out, c"daemon failed to stop")
		println(strjoin(c"PASS native lifecycle measurement sample ", itoa(sample + 1)))
	json_value* semantics = vm_lifecycle_semantics()
	json_value* summary = json_object()
	for char* name in semantics.object_values.keys():
		list[int] values = new list[int]
		for json_value* row in ml_records.array_values:
			if (strcmp(ht_text(row, c"operation"), name) == 0): values.push(cast(int, ht_field(row, c"milliseconds").float_value * 1000000.0))
		ht_require(values.length == samples, c"incomplete lifecycle samples")
		json_value* stats = vm_quantiles(values)
		vj_f(stats, c"min_ms", cast(float, values[0]) / 1000000.0)
		vj_f(stats, c"max_ms", cast(float, values[values.length - 1]) / 1000000.0)
		json_object_set(summary, name, stats)
	json_value* report = vm_lifecycle_base()
	vj_s(report, c"source_revision", vm_command(c"git rev-parse HEAD"))
	json_object_set(report, c"source_identity", source_identity())
	vj_s(report, c"worktree_status", vm_command(c"git status --short"))
	json_value* host = ht_field(report, c"host")
	vj_s(host, c"os", vm_command(c"sw_vers"))
	vj_s(host, c"model", vm_command(c"sysctl -n hw.model"))
	vj_s(host, c"chip", vm_command(c"sysctl -n machdep.cpu.brand_string"))
	vj_i(host, c"ram_bytes", atoi(vm_command(c"sysctl -n hw.memsize")))
	json_value* guest_info = ht_field(report, c"guest")
	file_stat st
	ht_require(file_stat_path(guest, &st) == 0, c"cannot stat guest")
	vj_i(guest_info, c"image_bytes", st.size)
	vj_s(guest_info, c"sha256", vsi_digest(guest))
	vj_s(report, c"worker_sha256", vsi_digest(worker))
	vj_s(report, c"daemon_sha256", vsi_digest(daemon))
	json_value* conditions = ht_field(report, c"conditions")
	vj_i(conditions, c"samples_per_operation", samples)
	vj_s(conditions, c"timer", c"W CLOCK_MONOTONIC nanoseconds, end-to-end RPC; ready status polled every 10ms")
	json_object_set(report, c"semantics", semantics)
	json_object_set(report, c"runs", ml_records)
	json_object_set(report, c"summary", summary)
	vj_write(output, report)
	println(json_stringify(summary))
	println(strjoin(c"Lifecycle evidence: ", output))
	ht_cleanup()
	return 0
