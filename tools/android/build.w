# wbuild: binary=android_build tag=tests
# Build a development APK with the installed SDK/NDK; no Gradle/downloads.
import tools.android.build_lib

void ab_run(list[char*] command):
	process_result* result = ht_run(command, 0, 0, 300000)
	ht_success(result)
	print(result.stdout_text)
	print2(result.stderr_text)

int main(int argc, int argv):
	arg_namespace* args = argparse_parse_or_exit(ab_parser(), argc, argv)
	ht_require(ab_match(c"[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+", argparse_get(args, c"package")), c"Invalid Android package id")
	int minimum = argparse_get_int(args, c"min_sdk")
	ht_require(minimum >= 28, c"W Android apps require --min-sdk 28 or newer")
	ht_require(strcmp(argparse_get(args, c"theme"), c"daynight") != 0 || minimum >= 29, c"--theme daynight requires --min-sdk 29 or newer")
	for char* scheme in argparse_get_list(args, c"scheme"): ht_require(ab_match(c"[a-z][a-z0-9+.-]*", scheme), c"Invalid URI scheme")
	char* sdk = ht_resolve(path_expand_user(argparse_get(args, c"sdk")))
	char* ndk = argparse_get(args, c"ndk")
	if (ndk == 0): ndk = ab_newest(path_join(sdk, c"ndk"), c"*")
	else: ndk = ht_resolve(path_expand_user(ndk))
	char* build = ab_newest(path_join(sdk, c"build-tools"), c"*")
	char* platform = ab_newest(path_join(sdk, c"platforms"), c"android-*")
	list[int] version = ab_version(platform)
	ht_require(version.length != 0 && version[0] >= 35, c"Install Android SDK platform 35 or newer")
	list[char*] hosts = glob_glob(path_join(ndk, c"toolchains/llvm/prebuilt/*"))
	ht_require(hosts.length == 1, c"Expected one NDK host toolchain")
	char* clang = path_join(hosts[0], c"bin/aarch64-linux-android28-clang")
	char* compiler = ht_resolve(argparse_get(args, c"compiler"))
	ht_require(path_exists(compiler), c"Build W with ./wbuild build first, or set --compiler")
	char* out = ht_resolve(argparse_get(args, c"out"))
	char* classes = path_join(out, c"classes")
	char* dex = path_join(out, c"dex")
	char* libs = path_join(out, c"lib/arm64-v8a")
	char* resources = path_join(out, c"res")
	for char* path in ht_argv(classes, dex, libs, resources):
		if (path_exists(path)): ht_require(shutil_rmtree(path) == 0, c"cannot reset APK staging directory")
		ht_mkdir(path)
	list[char*] command = ht_argv(compiler, c"arm64_android", c"--shared", c"--strict")
	char* imports = argparse_get(args, c"import_root")
	if (imports != 0):
		command.push(c"--import-root")
		command.push(ht_resolve(path_expand_user(imports)))
	command.push(argparse_get(args, c"source"))
	command.push(c"-o")
	command.push(path_join(libs, c"libwapp.so"))
	ab_run(command)
	int probes = argparse_get_bool(args, c"probes")
	if (probes):
		ab_run(ht_argv(compiler, c"arm64_android", c"--shared", c"--strict", c"compiler/cli.w", c"-o", path_join(libs, c"libwcompiler.so")))
		ab_run(ht_argv(compiler, c"arm64_android", c"--shared", c"--strict", c"tests/android_elf_fixture.w", c"tests/android_elf_imports.w", c"-o", path_join(libs, c"libandroid_elf.so")))
	command = ht_argv(clang)
	for char* arg in ht_command(c"-shared -fPIC -Wall -Wextra -Werror -Wl,--no-undefined -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384 -Wl,-z,relro,-z,now -Wl,-soname,libwandroid.so tools/android/host.c tools/android/kit.c"): command.push(arg)
	if (probes):
		for char* arg in ht_command(c"-DW_ANDROID_PROBES tests/android_abi_probe.c tools/android/compiler_probe.c"): command.push(arg)
	command.push(c"-ldl")
	command.push(c"-o")
	command.push(path_join(libs, c"libwandroid.so"))
	ab_run(command)
	# Build the validator for the same host as this tool (also works on macOS).
	char* validator = path_join(out, c"check_elf")
	char* host = c"x86"
	if (contains(ht_checked(ht_command(c"uname -s")).stdout_text, c"Darwin")): host = c"arm64_darwin"
	ab_run(ht_argv(compiler, host, c"tools/android/check_elf.w", c"-o", validator))
	command = ht_argv(validator)
	for char* library in glob_glob(path_join(libs, c"*.so")): command.push(library)
	ab_run(command)
	char* jar = path_join(platform, c"android.jar")
	command = ht_command(c"javac -encoding UTF-8 -source 8 -target 8 -Xlint:-options -classpath")
	command.push(jar)
	command.push(c"-d")
	command.push(classes)
	for char* source in glob_glob(c"tools/android/*.java"): command.push(source)
	ab_run(command)
	command = ht_argv(path_join(build, c"d8"), c"--min-api", itoa(minimum), c"--lib", jar, c"--output", dex)
	for char* file in glob_glob(path_join(classes, c"**/*.class")): command.push(file)
	ab_run(command)
	char* unsigned_apk = path_join(out, c"unsigned.apk")
	char* aligned = path_join(out, c"aligned.apk")
	char* apk = path_join(out, argparse_get(args, c"apk_name"))
	char* manifest = path_join(out, c"AndroidManifest.xml")
	ab_manifest(args, manifest, resources)
	char* compiled = 0
	if (glob_glob(path_join(resources, c"*")).length != 0):
		compiled = path_join(out, c"resources.zip")
		ab_run(ht_argv(path_join(build, c"aapt2"), c"compile", c"--dir", resources, c"-o", compiled))
	command = ht_argv(path_join(build, c"aapt2"), c"link", c"-I", jar, c"--manifest", manifest)
	if (compiled != 0): command.push(compiled)
	for char* arg in ht_argv(c"--min-sdk-version", itoa(minimum), c"--target-sdk-version", c"35", c"-o", unsigned_apk): command.push(arg)
	ab_run(command)
	wresult[zip_reader*]* archive = zip_open_read(unsigned_apk)
	ht_require(!result_is_error[zip_reader*](archive), c"aapt2 output is not a ZIP archive")
	zip_reader* reader = result_value[zip_reader*](archive)
	zip_writer* writer = zip_writer_new()
	for zip_entry* entry in reader.entries:
		wresult[zip_data*]* unpacked = zip_read_entry(reader, entry)
		ht_require(!result_is_error[zip_data*](unpacked), c"invalid APK member")
		zip_data* data = result_value[zip_data*](unpacked)
		ht_require(zip_writer_add_ex(writer, entry.name, data.data, data.length, entry.method, entry.dos_date, entry.dos_time, entry.external_attr) == 0, c"cannot copy APK member")
		zip_data_free(data)
	zip_close(reader)
	ab_zip_add(writer, path_join(dex, c"classes.dex"), c"classes.dex", ZIP_DEFLATED)
	for char* library in glob_glob(path_join(libs, c"*.so")): ab_zip_add(writer, library, strjoin(c"lib/arm64-v8a/", path_basename(library)), ZIP_STORED)
	if (probes):
		process_result* dependencies = ht_checked(ht_argv(compiler, c"deps", c"--json", c"arm64_android", c"tests/android_device_program.w"))
		set[char*] sources = new set[char*]
		char* root = ht_resolve(c".")
		for char* line in ht_split(dependencies.stdout_text, 10):
			if (line[0] != '{'): continue
			char* source = ht_resolve(ht_text(json_parse(line), c"file"))
			ht_require(source != 0 && starts_with(source, strjoin(root, c"/")), c"Probe dependency is outside checkout")
			sources.add(source)
		list[char*] names = sources.keys()
		ht_sort(names)
		for char* source in names: ab_zip_add(writer, source, strjoin(c"assets/w-src/", source + strlen(root) + 1), ZIP_DEFLATED)
	zip_data* packed = zip_writer_finish(writer)
	ht_write(unsigned_apk, packed.data, packed.length)
	ab_run(ht_argv(path_join(build, c"zipalign"), c"-P", c"16", c"-f", c"4", unsigned_apk, aligned))
	char* key = ht_resolve(path_expand_user(argparse_get(args, c"keystore")))
	char* password = argparse_get(args, c"keystore_pass")
	char* alias = argparse_get(args, c"key_alias")
	if (!path_exists(key)):
		ht_mkdir(path_dirname(key))
		command = ht_argv(c"keytool", c"-genkeypair", c"-keystore", key, c"-storepass", password, c"-keypass", password, c"-alias", alias)
		for char* arg in ht_argv(c"-dname", c"CN=W Android Development", c"-keyalg", c"RSA", c"-keysize", c"2048", c"-validity", c"10000", c"-noprompt"): command.push(arg)
		ab_run(command)
	char* secret = strjoin(c"pass:", password)
	command = ht_argv(path_join(build, c"apksigner"), c"sign", c"--ks", key, c"--ks-key-alias", alias, c"--ks-pass", secret, c"--key-pass", secret)
	command.push(c"--out")
	command.push(apk)
	command.push(aligned)
	ab_run(command)
	ab_run(ht_argv(path_join(build, c"apksigner"), c"verify", apk))
	ab_run(ht_argv(path_join(build, c"zipalign"), c"-c", c"-P", c"16", c"4", apk))
	println(apk)
	return 0
