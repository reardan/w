stateDiagram-v2
    direction LR
    [*] --> Draft
    state "Preparing order" as Draft
    Draft --> Processing : submit
    state Processing {
        direction TB
        [*] --> Validate
        state Decision <<choice>>
        Validate --> Decision
        Decision --> Accepted : valid
        Decision --> Rejected : invalid
        Accepted --> [*]
        Rejected --> [*]
    }
    Processing --> Shipped : complete
    Shipped --> [*]
    classDef terminal fill:#fee2e2,stroke:#b91c1c
    class Rejected terminal
    Shipped:::done
    classDef done fill:#dcfce7,stroke:#15803d,font-weight:bold
