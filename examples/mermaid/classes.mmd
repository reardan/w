classDiagram
    direction LR
    namespace Domain {
        class Record {
            <<abstract>>
            +int id
            +validate() bool
        }
        class Invoice {
            +decimal total
            +send() bool
        }
        Record <|-- Invoice
    }
    class Customer["Customer account"] {
        +String name
        +pay() bool
    }
    Customer "1" o-- "0..*" Invoice : owns
    class Repository~T~ {
        +List~T~ items$
        +find(int id) T
        +save(T item)* bool
    }
    link Customer "https://example.com/customers" "Customer docs"
