title Native call hierarchy
@Actor Client
@Boundary Service as Order Service
@Database Repository
Client->Service.checkout() {
  order = new Order(cart)
  id = Repository.save(order)
  try {
    Payments.charge(order) { Bank.debit() }
  } catch(declined) {
    Service->Client: Retry payment
  } finally {
    Repository.audit(order)
  }
  if(accepted) {
    Service->Client: Confirmation
  } else {
    Service->Client: Rejected
  }
  return result
}
