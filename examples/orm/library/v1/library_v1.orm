# Release 1 of the example library schema (issue #754, unit U5.2), kept so
# the end-to-end test can run release-1 ("old") code against the database
# while the release-2 migrations roll out. The generated library_v1_orm*.w
# next to this file are committed; orm_example_gen_test checks them.
#
# Old and new code share one test process, so the release-1 module needs
# its own names: app library_v1 and model names ending in V1. table=
# pins every model to the release's real table, and the test checks that
# this snapshot describes exactly the tables the release-1 migrations
# create (the autodetector compares tables and columns, not model names).
# A real deployment would just keep running the release-1 binary.
app library_v1

model AuthorV1:
	string name max_length=200
	string email max_length=254 unique
	text bio null
	datetime created auto_now_add
	index created
	table=library_author

model BookV1:
	enum Status: draft, pub
	string title max_length=300
	fk author -> AuthorV1 on_delete=cascade related_name=books
	Status status default=draft
	decimal price digits=8 places=2
	int pages null
	datetime created auto_now_add
	check price >= 0 name=library_book_price_nonnegative
	history
	table=library_book

model LoanV1:
	fk book -> BookV1 on_delete=cascade related_name=loans
	int borrower_id indexed
	datetime loaned_at auto_now_add
	datetime returned_at null
	history
	table=library_loan
