# Selection expectations for bin/wtest, checked by bin/wtest_map_check
# (tools/wtest_map_check.w). Run: ./wbuild wtest_map_test
#
# Each 'case' block runs 'bin/wtest changed <words>' and asserts
# PROPERTIES of the selection, never the exact set:
#   case <word> [<word>...]   the changed paths for this case; words
#                             pass through verbatim, so a case may lead
#                             with -f/--base-manifest fixture flags
#   expect <target>           selection must include <target>
#   forbid <target>           selection must not include <target>
#   empty                     selection must be empty
#   noorder                   opt this case out of the build.json
#                             known-name/order properties below, so a
#                             -f fixture case can use self-descriptive
#                             target names instead of reusing real
#                             build.json ones (tools/wtest_map_check.w
#                             header)
# Full-line '#' comments only. Three properties hold implicitly for
# every case that does not say 'noorder': each selected name must exist
# in build.json, the selection must be in manifest order with no
# duplicates (bin/wtest's documented output-order contract), and an
# empty selection must print 'wtest: 0 targets selected' to stderr (a
# non-empty one must not, and this one still holds under 'noorder') —
# so the 'empty' cases below also pin the zero-target visibility line.
#
# DESIGN RULE (#251 Direction 1): adding a conventional test target must
# NEVER require editing this file. Only assert targets tied to the
# selection mechanism under test — the residue rules in tools/test_map.w,
# literal step references, closure representatives — and forbids that are
# structurally invariant (the 'tests' fallback when a rule matched,
# never-emitted seed targets, unrelated leaf tests). This file is NOT a
# frozen copy of bin/wtest output; to inspect the actual selection for a
# case while editing:
#   ./wbuild wtest && bin/wtest changed <path...>
# An expect/forbid naming a target missing from build.json fails loudly
# ("unknown target"), so target renames surface here immediately — unless
# the case says 'noorder', in which case expect/forbid may name
# fixture-only targets that were never meant to be in build.json.

# Compiler tree -> the self-host gate (residue rule), never closure
# selection (which would degenerate to the full suite), never the
# 'tests' fallback. 'update' is on the never-emit list.
case grammar/promote.w
expect verify
expect self_host_warning_test
expect parser_generator_w_test
forbid tests
forbid update

# The seed graph is DERIVED from 'bin/wv2 deps w.w', not a prefix
# list: debugger/ is compiled into every compiler stage, so it gets
# the self-host gate too — while KEEPING its closure-selected leaf
# targets (rule b's skip stays keyed to the narrow prefix floor).
case debugger/wdbg.w
expect verify
expect self_host_warning_test
expect wdbg
expect debug_test
expect attach_test
expect parser_generator_w_test
forbid tests

# A lib/ file OUTSIDE w.w's import closure must NOT get the self-host
# gate: the derivation is file-accurate, not directory-sloppy. Its own
# leaf tests and the lib/ residue still select.
case lib/stats.w
expect stats_test
expect stats_64_test
expect metadata_check
expect parser_generator_w_test
forbid verify
forbid self_host_warning_test
forbid tests

# Import-closure selection (rule b) through a library file, plus the
# structures/ -> metadata_check residue. structures/json.w is also in
# the compiler's own import graph ('deps w.w'), so the derived
# seed-graph rule adds the self-host gate.
case structures/json.w
expect verify
expect self_host_warning_test
expect json_test
expect json_64_test
expect json_codec_test
expect wexec_test
expect manifest_check
expect metadata_check
expect parser_generator_w_test
forbid math_test
forbid tests

# Literal step references (rule a): fixture paths named in target argv
# or piped stdin.
case tests/warning_fixture.w
expect warning_test
expect strict_mode_test
expect check_json_test
expect parser_generator_w_test
forbid tests

case tests/import_alias_warning_fixture.w
expect warning_test
expect parser_generator_w_test
forbid tests

# Closure selection through an extras library, plus libs/ ->
# metadata_check residue. generator.w is the parser generator's OWN
# codegen — a pg-tool file, not one of the modules the compiler links
# via its C-import feature — so it is outside 'deps w.w' and must not
# get the self-host gate (the seed graph is file-accurate).
case libs/extras/parser_generator/generator.w
expect parser_generator_test
expect parser_generator_c_test
expect metadata_check
forbid verify
forbid tests

# runtime.w IS in w.w's closure (the compiler's generated C parser
# runs on it), so a seed-graph libs/extras/ edit selects the self-host
# gate alongside its ordinary closure targets.
case libs/extras/parser_generator/runtime.w
expect verify
expect self_host_warning_test
expect parser_generator_test
expect metadata_check
forbid tests

# Doc-only paths select nothing.
case docs/todo.txt
empty

# Editor rules are not code under test.
case .cursor/rules/w-source.mdc
empty

# Skill docs ARE under test: skills_test asserts every compiler flag
# documented in AGENTS.md / README.md / .cursor/skills/*/SKILL.md appears
# in `w --help`, and declares those files as target data, so editing one
# selects the target that would catch the drift.
case .cursor/skills/w-check-diagnostics/SKILL.md
expect skills_test
forbid tests

case AGENTS.md
expect skills_test

case README.md
expect skills_test

# A deleted or unknown .w -> metadata_check + the full suite (closures
# cannot be computed for importers of a missing module).
case unknown/new_file.w
expect metadata_check
expect tests

# The deep-closure case (the worst historical churn surface when it was
# a frozen list): assert one representative per selection family — the
# library's own tests, both word sizes, a distant closure consumer, the
# toolchain, the lib/ residue — never the full set.
case lib/stream.w
expect stream_test
expect stream_64_test
expect dns_test
expect repl_warning_test
expect wexec
expect wexec_test
expect metadata_check
forbid win64_hello_test
forbid tests

case lib/file.w
expect file_test
expect wtest
expect wexec
expect wexec_test
expect metadata_check
forbid win64_hello_test
forbid tests

# Multi-path invocation; wtest_run_test and wexec_test inherit
# tools/wexec.w as a root from their 'wexec' dep target (rule b root
# collection walks dependency targets).
case tools/wexec.w tests/wexec/good.json
expect wexec
expect wexec_test
expect wtest_run_test
forbid tests

# The manifests: wexec_test + the full suite. Only build.base.json (the
# hand-maintained wbuildgen input) also gates manifest_check. Without a
# --base-manifest baseline, build.json never gets the leaf special case.
case build.json
expect wexec_test
expect tests
forbid manifest_check

case build.base.json
expect manifest_check
expect wexec_test
expect tests

# The build.json leaf special case: case words pass through to
# 'bin/wtest changed' verbatim, so -f/--base-manifest point both the
# current and the baseline manifest at tests/wtest/ fixtures (real
# target names in build.json order, as the implicit properties demand).
# A diff that only ADDS one wbuildgen-shaped leaf target (plus its
# 'tests' membership) selects that target + the manifest gates, never
# the umbrella.
case -f tests/wtest/manifest_leaf_add.json --base-manifest tests/wtest/manifest_leaf_base.json build.json
expect manifest_check
expect wexec_test
expect math_test
forbid tests
forbid sha256_test

# REMOVING the leaf keeps just the manifest gates: the removed target
# no longer exists to run, and manifest_check covers the regeneration.
case -f tests/wtest/manifest_leaf_base.json --base-manifest tests/wtest/manifest_leaf_add.json build.json
expect manifest_check
expect wexec_test
forbid math_test
forbid tests

# A leaf REGENERATED IN PLACE (a '# wbuild:' directive edit — here a
# timeout) selects itself plus the manifest gates.
case -f tests/wtest/manifest_leaf_retime.json --base-manifest tests/wtest/manifest_leaf_add.json build.json
expect manifest_check
expect wexec_test
expect math_test
forbid tests

# A byte-identical baseline (formatting-only manifest change) keeps
# just the manifest gates; manifest_check is the formatting arbiter.
case -f tests/wtest/manifest_leaf_add.json --base-manifest tests/wtest/manifest_leaf_add.json build.json
expect manifest_check
expect wexec_test
forbid math_test
forbid tests

# Anything beyond leaf additions/removals — here a hand-written
# target's steps changed — falls back to the full residue.
case -f tests/wtest/manifest_leaf_add.json --base-manifest tests/wtest/manifest_nonleaf_base.json build.json
expect wexec_test
expect tests
forbid manifest_check
forbid math_test

# A build.base.json change keeps the full residue even when the
# build.json diff itself is leaf-only: hand-maintained manifest edits
# are never scoped down.
case -f tests/wtest/manifest_leaf_add.json --base-manifest tests/wtest/manifest_leaf_base.json build.json build.base.json
expect manifest_check
expect wexec_test
expect math_test
expect tests

# A conventional test selects itself + manifest_check (test sources are
# wbuildgen inputs) and never an unrelated sibling test.
case tests/sha256_test.w
expect sha256_test
expect manifest_check
expect parser_generator_w_test
forbid math_test
forbid tests

case tests/math_test.w
expect math_test
expect manifest_check
forbid sha256_test
forbid tests

# The manifest generator toolchain. 'manifest' (the in-place build.json
# rewrite) is never emitted: selecting it alongside manifest_check made
# './wbuild test_changed' race the check's byte-compare against the
# mid-rewrite manifest — manifest_check alone is the drift gate.
case tools/wbuildgen.w
expect wbuildgen
expect wbuildgen_scratch_test
expect manifest_check
forbid manifest
forbid tests

# tests/asm/*.txt are runtime fixtures, not docs (#268): the tests/asm/
# residue rule must see them despite the .txt extension.
case tests/asm/corpus_x86.txt
expect asm_foundations_test
expect asm_x86_disasm_test
expect asm_x86_asm_test
expect asm_arm64_test
expect asm_x64_test
expect asm_seed_gate
expect asm_stubs_test
expect asm_fuzz_x86_test
expect asm_fuzz_x64_test
expect asm_fuzz_arm64_test
forbid tests

# tests/c_import_skip_note_fixture.h is read by c_import at compile
# time (the -v skip-note fixture header), invisible to the import
# graph; its residue rule pins it to its one consumer.
case tests/c_import_skip_note_fixture.h
expect c_import_verbose_note_test
forbid tests

# tests/c_import_error_directive_fixture.h mirrors it for the '#error'
# message-echo fixture: the header is read by the C preprocessor at
# compile time, invisible to the import graph.
case tests/c_import_error_directive_fixture.h
expect c_import_error_directive_test
forbid tests

# The C-import machinery is loaded by the compiler itself, not through
# recorded imports; its residue rule pins the c_import suite, including
# the '#error' diagnostic fixture target.
case libs/extras/c_preprocessor/pp_directives.w
expect c_preprocessor_test
expect c_import_test
expect c_import_error_directive_test
expect metadata_check
forbid tests

# lib/__arch__/ modules select through the per-arch closures of rule
# (b) — the old blanket residue rule is retired. Each arch's module
# selects only targets that compile for that arch: the x86 socket ABI
# never selects an x64 twin or the darwin smoke target, and vice versa.
case lib/__arch__/x86/socket_abi.w
expect net_test
expect http_client_test
expect metadata_check
expect parser_generator_w_test
forbid http_client_64_test
forbid net_darwin
forbid tests

case lib/__arch__/x64/socket_abi.w
expect http_client_64_test
expect net_64_test
expect metadata_check
forbid net_test
forbid http_client_test
forbid net_darwin
forbid tests

case lib/__arch__/arm64_darwin/socket_abi.w
expect net_darwin
expect metadata_check
forbid net_test
forbid http_client_64_test
forbid tests

# arm64 modules select the targets that really compile for arm64,
# instead of the old x86/x64 lib-test proxies that never read them —
# plus the arm64 fixpoint, since the syscall layer is in
# 'bin/wv2 arm64 deps w.w'.
case lib/__arch__/arm64/syscalls.w
expect verify_arm64
expect arm64_smoke_test
expect dynamic_test_arm64
expect metadata_check
forbid verify
forbid lib_test
forbid lib_64_test
forbid tests

# The darwin syscall layer mirrors it: every arm64_darwin root's closure
# contains it, so the native smoke mirror of arm64_smoke_test (#210) and
# the other darwin cross-compiles are selected — never the qemu-path
# arm64 targets or the x86 lib tests.
case lib/__arch__/arm64_darwin/syscalls.w
expect arm64_darwin_smoke_test
expect net_darwin
expect metadata_check
forbid lib_test
forbid arm64_smoke_test
forbid tests

# tools/mac/run_darwin_tests.sh is the Mac-side run leg for the darwin
# cross-compile targets; no manifest argv names the script (unlike
# tools/run_arm64.sh, which the qemu targets invoke directly), so a
# residue rule in tools/test_map.w pins the coupling.
case tools/mac/run_darwin_tests.sh
expect arm64_darwin_smoke_test
expect net_darwin
expect graphics_darwin
expect pac_darwin
forbid tests

# An arch module nothing compiles yet (no win64 target links lib/net.w)
# keeps the always-on gates only; a future win64 net target's closure
# will pick it up automatically.
case lib/__arch__/win64/socket_abi.w
expect metadata_check
expect parser_generator_w_test
forbid net_test
forbid tests

# The wasm syscall layer selects through wasm-arch closures now that
# 'wasm' is a recognized selector word (it used to be invisible to rule
# (b) and fell through to the full 'tests' fallback): every target
# compiling a wasm root is selected, never the x86 lib tests. Being in
# 'bin/wv2 wasm deps w.w' additionally selects the wasm self-host
# fixpoint (the build_wasm/verify_wasm chain's only root is w.w, an
# excluded closure root, so only the arch-verify residue rule can
# reach it) — but never the 32-bit 'verify': the file is not in the
# default-arch seed closure.
case lib/__arch__/wasm/syscalls.w
expect verify_wasm
expect wasm_smoke_test
expect wasm_extern_test
expect metadata_check
forbid verify
forbid lib_test
forbid tests

# graphics/ selects through arch closures too (the second retired
# residue rule): the darwin window backend is visible only to
# arm64_darwin roots, the X11/GL path only to the x64 smoke target.
case graphics/cocoa.w
expect graphics_darwin
expect parser_generator_w_test
forbid graphics_gl_smoke_test
forbid tests

case graphics/gl_linux.w
expect graphics_gl_smoke_test
forbid graphics_darwin
forbid tests

# 'noorder' lets a -f fixture case use self-descriptive target names
# that are not real build.json targets, and not in build.json's
# relative order, instead of being forced to reuse real ones just to
# satisfy the implicit known-name/order properties. Both fixture names
# below are fictional; without 'noorder' this case would fail on the
# very first one ("not a build.json target"), order notwithstanding.
case -f tests/wtest/manifest_custom_names.json custom/marker.dat
noorder
expect alpha_widget_check
expect zeta_gadget_check

# --available drops a target whose step names a runner not present on
# this host and keeps a target with no special runner requirement.
# tools/mac/does_not_exist.sh is a fictional path (never created) so the
# drop is deterministic on every machine, unlike testing the real
# qemu-aarch64-static/wine paths, whose availability legitimately varies
# by host (docs/projects/ai_tooling_next_steps.md, 2026-07-16 entries).
# The fixture's target names are not build.json targets, hence 'noorder'
# (tools/wtest_map_check.w header).
case -f tests/wtest/manifest_unavailable.json --available widget/marker.dat
noorder
expect custom_widget_ok
forbid custom_widget_needs_mac

# An auto-imported runtime file is in EVERY program's closure, so the
# raw selection is essentially the whole manifest (~540 of ~560
# targets). Above the half-of-the-manifest threshold the selection is
# collapsed to the step-less umbrella targets that cover the selected
# members (tests, tests_x64, ...) plus the uncovered leftovers, with a
# one-line stderr summary (asserted by wtest_map_test's build.base.json
# steps) — never hundreds of individual leaf tests. Targets no
# umbrella covers (the arm64/wasm gates) survive individually.
case structures/w_list.w
expect tests
expect tests_x64
expect arm64_smoke_test
expect wasm_smoke_test
forbid math_test
forbid lib_test
forbid stream_test

# The x86 syscall layer is in every x86 program's closure but no x64
# one: the collapse is arch-accurate — the 'tests' umbrella stands in
# for the x86 members, while tests_x64 (mostly unselected members)
# must NOT be pulled in.
case lib/__arch__/x86/syscalls.w
expect tests
forbid tests_x64
forbid http_client_64_test

# The collapse fixture (tests/wtest/manifest_collapse.json): selecting
# all four members of the step-less 'collapse_all' umbrella (4 of 5
# selectable targets, above the half threshold) emits the umbrella
# instead of the members.
case -f tests/wtest/manifest_collapse.json widget/collapse_all.dat
noorder
expect collapse_all
forbid collapse_w1
forbid collapse_w4

# Below the threshold (2 of 5) nothing collapses.
case -f tests/wtest/manifest_collapse.json widget/collapse_two.dat
noorder
expect collapse_w1
expect collapse_w2
forbid collapse_all

# Above the global threshold (3 of 5) but with only a minority of the
# umbrella's members selected (2 of 4), the umbrella must NOT swallow
# the selection: members are emitted as themselves.
case -f tests/wtest/manifest_collapse.json widget/collapse_mixed.dat
noorder
expect collapse_w1
expect collapse_w2
expect collapse_loner
forbid collapse_all

# --runnable-here closure-level needs attribution (tools/test_map.w;
# ai_tooling_next_steps.md 2026-07-29): the needy directives live in
# IMPORTED modules of the manifest_runnable.json fixture roots, never
# in the roots themselves. WHICH needs are absent varies by host (CI
# installs the i386 loader this container lacks; a GPU box has the
# NVIDIA driver), so the dropped direction is asserted
# host-conditionally in tools/wtest_runnable_scratch_test.sh — the
# same lesson as manifest_unavailable.json's fictional tools/mac/
# path. The two cases here pin the host-INDEPENDENT halves. First: a
# changed path that is an imported fixture module selects its
# importing root's target through rule (b) — which also computes the
# fixture closures the filter then scans — and a clean import chain
# (no directive anywhere in dep_plain.w's or plain_imp.w's closure)
# must be KEPT everywhere: closure scanning must not invent needs.
case -f tests/wtest/manifest_runnable.json --runnable-here tests/wtest/runnable_fixture/dep_plain.w
noorder
expect rn_plain_imp
forbid rn_dyn32

# Second: a root with no computable closure (broken_imp.w's second
# import does not exist, so 'bin/wv2 deps' always fails) must fall
# back to the ROOT text — no directives there, so rn_broken_imp is
# kept on every host, even though its resolvable import (dep_dyn.w)
# carries a c_lib directive that a partial closure would attribute.
# The marker path co-selects rn_static and rn_plain_imp, kept
# everywhere for the same host-independent reasons as above.
case -f tests/wtest/manifest_runnable.json --runnable-here tests/wtest/runnable_fixture/broken_imp.w widget/runnable.dat
noorder
expect rn_broken_imp
expect rn_plain_imp
expect rn_static
expect rn_compile_only
