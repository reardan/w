# wbuild: target=gpu_ptx_emit_test tag=tests dep=wv2
# wbuild: step="bin/wv2 x64 tests/gpu_ptx_emit.w -o bin/gpu_ptx_emit"
# wbuild: step="bin/gpu_ptx_emit" expect_stdout=".version 6.0" expect_stdout=".address_size 64" expect_stdout=".visible .entry add(.param .u64 p0, .param .u64 p1, .param .u64 p2, .param .u64 p3)" expect_stdout=".visible .entry scale(" expect_stdout=".visible .entry axpb64(" expect_stdout=".visible .entry bits(" expect_stdout="ld.param.u64 %ax, [p0];" expect_stdout="cvta.local.u64 %sp, %sp;" expect_stdout=".reg .b32 %w0, %w1;" expect_stdout="mov.u32 %w0, %tid.x;" expect_stdout="mov.u32 %w0, %ctaid.x;" expect_stdout="mov.u32 %w0, %nctaid.x;" expect_stdout="setp.lt.s64 %p, %bx, %ax;" expect_stdout="add.f32 %fa, %fa, %fb;" expect_stdout="st.u32 [%bx], %ax;" expect_stdout="mul.f64 %da, %da, %db;" expect_stdout="cvt.rn.f64.s64 %db, %ax;" expect_stdout="shr.u64 %ax, %ax, 32;" expect_stdout="st.u64 [%cx], %bx;" expect_stdout="shf.l.wrap.b32 %w0, %w0, %w0, %w1;" expect_stdout="shf.r.wrap.b32 %w0, %w0, %w0, %w1;" expect_stdout="popc.b32 %w0, %w0;" expect_stdout="clz.b32 %w0, %w0;" expect_stdout="brev.b32 %w0, %w0;" expect_stdout=".visible .entry accum(" expect_stdout="atom.add.u64 %ax, [%bx], %ax;" expect_stdout="atom.min.s64 %ax, [%bx], %ax;" expect_stdout="atom.max.s64 %ax, [%bx], %ax;" expect_stdout="atom.add.f32 %fa, [%bx], %fa;" expect_stdout=".visible .entry transcendental(" expect_stdout="mov.f32 %fb, 0f3FB8AA3B;" expect_stdout="ex2.approx.f32 %fa, %fa;" expect_stdout="lg2.approx.f32 %fa, %fa;" expect_stdout="mov.f32 %fb, 0f3F317218;" expect_stdout=".visible .entry stage(" expect_stdout=".shared .align 4 .b8 __w_shared0[1024];" expect_stdout="cvta.shared.u64 %ax, %ax;" expect_stdout="bar.sync 0;" expect_stdout=".reg .b64 %v<" expect_stdout="mov.u64 %bx, %v0;" expect_stdout=".reg .b64 %l<" expect_stdout="mov.u64 %ax, %l0;" expect_stdout="shl.b64 %l" expect_stdout="shr.s64 %l" expect_stdout="ret;"
