  "paths": {
    "/books": {
      "get": {
        "operationId": "books_list",
        "summary": "List Book objects",
        "tags": [
          "books"
        ],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "Filter on title (exact).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title__icontains",
            "in": "query",
            "description": "Filter on title (icontains).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price__gte",
            "in": "query",
            "description": "Filter on price (gte).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price__lte",
            "in": "query",
            "description": "Filter on price (lte).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price__range",
            "in": "query",
            "description": "Filter on price (range).",
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter on status (exact).",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "pub"
              ]
            }
          },
          {
            "name": "status__in",
            "in": "query",
            "description": "Filter on status (in).",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "draft",
                  "pub"
                ]
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "author",
            "in": "query",
            "description": "Filter on author (exact).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "tags__name",
            "in": "query",
            "description": "Filter on tags__name (exact).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pages__isnull",
            "in": "query",
            "description": "Filter on pages (isnull).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "published_at__gte",
            "in": "query",
            "description": "Filter on published_at (gte).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "ordering",
            "in": "query",
            "description": "Which fields to order the results by; a leading - reverses.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "price",
                  "-price",
                  "title",
                  "-title"
                ]
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search terms; each must match one of: title, author__name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The pagination cursor value.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "tokenAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CursorPaginatedBookList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "books_create",
        "summary": "Create a Book",
        "tags": [
          "books"
        ],
        "requestBody": {
          "content": {
            "application/json": {
