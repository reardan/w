  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "books": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "readOnly": true
          }
        },
        "required": [
          "id",
          "name",
          "created",
          "books"
        ]
      },
      "AuthorRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "author": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pub"
            ]
          },
          "price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,6}(?:\\.\\d{0,2})?$"
          },
          "pages": {
            "type": "integer",
            "nullable": true
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "author_name": {
            "type": "string",
            "maxLength": 200,
            "readOnly": true
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "readOnly": true
          },
          "review_count": {
            "type": "integer",
            "nullable": true,
            "readOnly": true
          },
          "is_long": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "status",
          "price",
          "pages",
          "published_at",
          "author_name",
          "tags",
          "review_count",
          "is_long"
        ]
      },
      "BookRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "author": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pub"
            ]
          },
          "price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,6}(?:\\.\\d{0,2})?$"
          },
          "pages": {
            "type": "integer",
            "nullable": true
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "title",
          "author",
          "price"
        ]
      },
      "CatalogBook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "author": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Author"
              }
            ],
            "readOnly": true
          },
          "price": {
            "type": "string",
            "format": "decimal",
