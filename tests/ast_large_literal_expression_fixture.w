# Asset-sized literals exercise source buffering and decoded AST storage.
char* ast_large_cstr():
	return c""

string ast_large_string():
	return s""

string ast_large_template(int n):
	return f"{n}"

int main():
	char* bytes = ast_large_cstr()
	if (bytes[0] != 'a' || bytes[4095] != '5' || bytes[4096] != 0): return 1
	string text = ast_large_string()
	if (text.length != 4096 || text[4095] != '5'): return 2
	string formatted = ast_large_template(42)
	if (formatted.length != 4098 || formatted[4097] != '2'): return 3
	return 0
