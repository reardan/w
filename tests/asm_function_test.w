# wbuild: x64 arch=arm64
# wbuild: step="bin/wv2 --no-asm tests/asm_function_test.w -o bin/asm_function_portable_test"
# wbuild: step="bin/asm_function_portable_test portable"
/*
Language test for assembly function bodies (docs/projects/asm_functions.md):
an `asm <isa>:` block of string lines opening a function body replaces the
portable W body when it matches the compile target. Covers argument
order under each ISA's naked W calling convention, named labels (forward,
backward, and far enough that x86 Jcc relaxation must keep rel32),
`jmp portable` fall-through into the W body, functions with no block for
the target, `;`-separated lines, c"" lines, trailing comments, calls
through function pointers and before the definition, and `asm` staying
usable as an ordinary identifier.

The x64 and arm64 twins run the other ISAs' blocks; the --no-asm build
(the steps above, passed "portable") runs the same checks against the W
bodies, except that asm_active() then reports 0.
*/
import lib.assert


int sub2(int a, int b);


# The first argument is the deepest stack slot under the W convention.
int sub2(int a, int b):
	asm x86:
		"mov eax,[esp+8]"   # a
		"sub eax,[esp+4]"   # b
		"ret"
	asm x64:
		"mov rax,[rsp+0x10]"
		"sub rax,[rsp+8]"
		"ret"
	asm arm64:
		"ldr x0,[x28,#8]"   # a
		"ldr x1,[x28]"      # b
		"sub x0,x0,x1"
		"ret"
	return a - b


# 1 when the asm block for the target ran, 0 from the portable body.
int asm_active():
	asm x86:
		"mov eax,1; ret"
	asm x64:
		c"mov eax,1"
		c"ret"
	asm arm64:
		"movz x0,#1; ret"
	return 0


# Sum 1..n with a backward loop label and a forward exit label.
int sum_to(int n):
	asm x86:
		"mov ecx,[esp+4]"
		"xor eax,eax"
		"loop:"
		"test ecx,ecx"
		"je done"
		"add eax,ecx"
		"dec ecx"
		"jmp loop"
		"done:"
		"ret"
	asm x64:
		"mov rcx,[rsp+8]"
		"xor eax,eax"
		"loop: test rcx,rcx"
		"je done"
		"add rax,rcx"
		"dec rcx"
		"jmp loop"
		"done: ret"
	asm arm64:
		"ldr x1,[x28]"
		"movz x0,#0"
		"loop:"
		"cbz x1,done"
		"add x0,x0,x1"
		"sub x1,x1,#1"
		"b loop"
		"done:"
		"ret"
	int total = 0
	while (n > 0):
		total = total + n
		n = n - 1
	return total


# Negative arguments take the portable body, entered with the stack as at
# the call, so the W body still sees its argument.
int clamp_negative(int x):
	asm x86:
		"mov eax,[esp+4]"
		"test eax,eax"
		"js portable"
		"ret"
	asm x64:
		"mov rax,[rsp+8]"
		"test rax,rax"
		"js portable"
		"ret"
	asm arm64:
		"ldr x0,[x28]"
		"cmp x0,#0"
		"b.lt portable"
		"ret"
	if (x < 0): return 0 - 100
	return x


