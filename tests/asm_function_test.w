# Only an x86 block: the x64 and arm64 builds compile the W body alone.
int only_x86(int x):
	asm x86:
		"mov eax,[esp+4]"
		"add eax,eax"
		"ret"
	return x + x


# 64-bit registers r8d-r15d in an x64 block; the x86 block saves the
# callee-saved registers it borrows.
int mix3(int a, int b, int c):
	asm x86:
		"push ebx"
		"push esi"
		"mov ebx,[esp+0x14]"   # a
		"mov esi,[esp+0x10]"   # b
		"mov eax,[esp+0xc]"    # c
		"imul ebx,ebx,3"
		"add eax,ebx"
		"sub eax,esi"
		"pop esi"
		"pop ebx"
		"ret"
	asm x64:
		"mov r8d,[rsp+0x18]"
		"mov r9d,[rsp+0x10]"
		"mov eax,[rsp+8]"
		"imul r8d,r8d,3"
		"add eax,r8d"
		"sub eax,r9d"
		"movsxd rax,eax"
		"ret"
	asm arm64:
		"ldr x1,[x28,#16]"
		"ldr x2,[x28,#8]"
		"ldr x0,[x28]"
		"add x3,x1,x1"
		"add x1,x3,x1"
		"add x0,x0,x1"
		"sub x0,x0,x2"
		"ret"
	return a * 3 + c - b


type binary_op = fn(int, int) -> int


int apply2(binary_op* f, int a, int b):
	return f(a, b)


int main(int argc, char** argv):
	int portable = argc > 1
	assert_equal(1 - portable, asm_active())
	assert_equal(7, sub2(10, 3))
	assert_equal(0 - 7, sub2(3, 10))
	assert_equal(5, apply2(sub2, 8, 3))
	assert_equal(0, sum_to(0))
	assert_equal(5050, sum_to(100))
	assert_equal(42, clamp_negative(42))
	assert_equal(0, clamp_negative(0))
	assert_equal(0 - 100, clamp_negative(0 - 5))
	assert_equal(0 - 1, far_branches(0))
	assert_equal(1, far_branches(1))
	assert_equal(300, far_branches(300))
	assert_equal(14, only_x86(7))
	assert_equal(3 * 4 + 6 - 5, mix3(4, 5, 6))
	assert_equal(0 - 3 * 4 + 6 - 5, mix3(0 - 4, 5, 6))
	int asm = 3   # still an ordinary identifier
	asm = asm + 1
	assert_equal(4, asm)
	println(c"asm_function_test: ok")
	return 0
