# wbuild: target=crash_trace_test tag=tests dep=wv2
# wbuild: step="bin/wv2 tests/crash_null_deref_fixture.w -o bin/crash_null_deref_fixture"
# wbuild: step="bin/crash_null_deref_fixture" expect_fail expect_stderr="fatal signal: SIGSEGV (invalid memory reference)" expect_stderr="faulting address 0x00000000" expect_stderr="registers:" expect_stderr="build-id: " expect_stderr="stack trace (most recent call first):" expect_stderr="at crash_deep (" expect_stderr="at crash_mid (" expect_stderr="at main (" expect_stderr="crash_null_deref_fixture.w:" expect_stderr="terminating with the default action for signal 11"
# wbuild: step="bin/wv2 tests/crash_div_zero_fixture.w -o bin/crash_div_zero_fixture"
# wbuild: step="bin/crash_div_zero_fixture" expect_fail expect_stderr="fatal signal: SIGFPE (arithmetic exception)" expect_stderr="stack trace (most recent call first):" expect_stderr="at crash_divide (" expect_stderr="at main (" expect_stderr="crash_div_zero_fixture.w:" expect_stderr="terminating with the default action for signal 8"
# wbuild: step="bin/wv2 tests/crash_deep_chain_fixture.w -o bin/crash_deep_chain_fixture"
