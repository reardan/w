	js_standard_early(c"/[]/; /[^]/;", 0, 1)
	js_standard_early(c"/a{2,3}?b*?c+?d??/;", 0, 1)
	js_standard_early(c"/a{0,}/; /a{2}/; /a{0002,003}/;", 0, 1)
	js_standard_early(c"/a{999999999999999999999,1000000000000000000000}/;", 0, 1)
	js_standard_early(c"/(?=a)+/; /(?=a)?/; /(?!a){2}/;", 0, 1)
	js_standard_early(c"/(?<=a)b/; /(?<!a)b/;", 0, 1)
	js_standard_early(c"/(?<name>a)\\k<name>/u;", 0, 1)
	js_standard_early(c"/\\u{28}*/u; /\\p{L}+/u;", 0, 1)
	js_standard_early(c"/a{bad}/; /]/; /}/;", 0, 1)
	js_standard_early(c"/^$|a||b/; /(?:)/;", 0, 1)
	js_standard_early(c"/\\/*/;", 0, 1)
