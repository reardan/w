	js_standard_early(c"/(a|b(?:c|))*/;", 0, 1)
	js_standard_early(c"/[(){}*+?]+/;", 0, 1)
	js_standard_early(c"/\\(\\)\\[\\]\\{\\}/u;", 0, 1)
