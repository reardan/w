	js_standard_early(c"/*a/;", 0, 0)
	js_standard_early(c"/+a/;", 0, 0)
	js_standard_early(c"/a**/;", 0, 0)
	js_standard_early(c"/a+*/;", 0, 0)
	js_standard_early(c"/^*/;", 0, 0)
	js_standard_early(c"/\\b+/;", 0, 0)
	js_standard_early(c"/a{3,2}/;", 0, 0)
