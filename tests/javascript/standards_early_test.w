	js_standard_early(c"/a{0003,002}/;", 0, 0)
	js_standard_early(c"/a{2,3}*/;", 0, 0)
	js_standard_early(c"/(?=a)+/u;", 0, 0)
	js_standard_early(c"/(?<=a)+/;", 0, 0)
	js_standard_early(c"/(?<!a)?/;", 0, 0)
	js_standard_early(c"/a{bad}/u;", 0, 0)
