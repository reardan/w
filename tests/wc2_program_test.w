# wbuild: x64 tool=tools/wc2.w
import tests.wc2_support
import tools.wc2.dump
import tools.wc2.load


void wc2_test_program(char* source, int expected):
	char* input = wc2_emit_test_path(c".w")
	char* output = wc2_emit_test_path(c".elf")
	char* reference = wc2_emit_test_path(c".reference")
	wc2_module* m = wc2_parse(source, input)
	wc2_load_imports(m)
	char* before = wc2_dump(m)
	asm_buffer* image = wc2_emit(m)
	if (image == 0): pg_diagnostics_print(m.diagnostics)
	assert1(image != 0)
	char* after = wc2_dump(m)
	assert_strings_equal(before, after)
	free(before)
	free(after)
	assert1(wc2_write_executable(output, image))
	wc2_test_exit(output, expected)
	assert1(file_write_text(input, source))
	process_result* compiled = wc2_test_compile(c"bin/wv2", input, reference)
	if (compiled.status != 0): print2(compiled.stderr_text)
	assert_equal(0, compiled.status)
	process_result_free(compiled)
	wc2_test_exit(reference, expected)
	# CLI and in-process output must agree also in the 64-bit host twin.
	compiled = wc2_test_compile(c"bin/wc2", input, reference)
	assert_equal(0, compiled.status)
	process_result_free(compiled)
	int fd = open(reference, 0, 0)
	assert1(fd >= 0)
	assert_equal(image.length, file_size(fd))
	char* bytes = malloc(image.length)
	assert_equal(image.length, read_exact(fd, bytes, image.length))
	assert1(mem_eq(bytes, image.data, image.length))
	free(bytes)
	close(fd)
	asm_buffer_free(image)
	wc2_module_free(m)
	unlink(input)
	unlink(output)
	unlink(reference)
	free(input)
	free(output)
	free(reference)


void test_wc2_locals_and_assignment():
	wc2_test_program(c"int main():\n\tint x = 65536\n\ty := x + 3\n\tx = y * 2\n\treturn x != 131078\n", 0)
	wc2_test_program(c"int main():\n\tint x = 1\n\tint y = 2\n\tx = y = 7\n\tx += 3\n\tx -= 2\n\tx *= 5\n\tx /= 4\n\tx %= 7\n\tx <<= 3\n\tx >>= 1\n\tx &= 15\n\tx |= 16\n\tx ^= 5\n\treturn (x != 25) || (y != 7)\n", 0)
	wc2_test_program(c"int main():\n\tint x = 7\n\tif 1:\n\t\tint x = 9\n\t\tx += 3\n\treturn x != 7\n", 0)
	wc2_test_program(c"int main():\n\tbool b = 7\n\tb = 65536\n\tx := b\n\treturn (b != 1) || (x != 1)\n", 0)
	wc2_test_program(c"int main():\n\tint x = 0\n\t0 && (x = 7)\n\t1 || (x = 8)\n\t1 && (x = 3)\n\t0 || (x += 4)\n\treturn x != 7\n", 0)


void test_wc2_calls_and_recursion():
	wc2_test_program(c"int combine(int a, int b): return a * 10 + b\nint main():\n\tint x = 0\n\treturn combine(x += 1, x += 1) != 12\n", 0)
	wc2_test_program(c"int combine(int a, int b): return a * 10 + b\nint main(): return combine(combine(1, 2), combine(3, 4)) != 154\n", 0)
	wc2_test_program(c"int fact(int n):\n\tif n <= 1: return 1\n\treturn n * fact(n - 1)\nint main(): return fact(8) != 40320\n", 0)
	wc2_test_program(c"int fib(int n):\n\tif n < 2: return n\n\treturn fib(n - 1) + fib(n - 2)\nint main(): return fib(10) != 55\n", 0)
	wc2_test_program(c"bool truth(int n): return n != 0\nint take(bool a, bool b): return a * 10 + b\nint main(): return take(42, truth(-7)) != 11\n", 0)
	wc2_test_program(c"void nothing(): pass\nvoid early(): return\nint main():\n\tnothing()\n\tearly()\n\treturn 0\n", 0)
	wc2_test_program(c"int change(int n):\n\tn += 5\n\treturn n\nint main():\n\tint x = 7\n\treturn (change(x) != 12) || (x != 7)\n", 0)


void test_wc2_branches_and_loops():
	wc2_test_program(c"int classify(int n):\n\tif n < 0: return 1\n\telif n == 0: return 2\n\telse: return 3\nint main(): return classify(-1) + classify(0) + classify(1) != 6\n", 0)
	wc2_test_program(c"int choose(int c):\n\tint x\n\tif c: x = 7\n\telse: x = 9\n\treturn x\nint main(): return choose(0) + choose(1) != 16\n", 0)
	wc2_test_program(c"int choose(int c):\n\tint x\n\tif c: return 4\n\telse: x = 7\n\treturn x\nint main(): return choose(0) + choose(1) != 11\n", 0)
	wc2_test_program(c"int main():\n\tint i = 0\n\tint sum = 0\n\twhile i < 10000:\n\t\tint next = i + 1\n\t\ti = next\n\t\tif i % 2 == 0: continue\n\t\tsum += i\n\treturn sum != 25000000\n", 0)
	wc2_test_program(c"int main():\n\tint i = 0\n\tint sum = 0\n\twhile i < 4:\n\t\ti += 1\n\t\tint j = 0\n\t\twhile j < 10:\n\t\t\tj += 1\n\t\t\tif j == 2: continue\n\t\t\tif j == 4: break\n\t\t\tsum += i * j\n\treturn sum != 40\n", 0)
	wc2_test_program(c"int find(int n):\n\twhile n > 0:\n\t\tif n % 7 == 0: return n\n\t\tn -= 1\n\treturn 0\nint main(): return find(99) != 98\n", 0)


void test_wc2_semantic_diagnostics():
	wc2_test_rejected(c"int main():\n\tint x\n\treturn x\n", c"may be uninitialized")
	wc2_test_rejected(c"int main():\n\tint x = x\n\treturn x\n", c"may be uninitialized")
	wc2_test_rejected(c"int main():\n\tint x\n\tif 1: x = 7\n\treturn x\n", c"may be uninitialized")
	wc2_test_rejected(c"int main():\n\tint x\n\twhile 0: x = 7\n\treturn x\n", c"may be uninitialized")
	wc2_test_rejected(c"int main():\n\tint x\n\t1 && (x = 7)\n\treturn x\n", c"may be uninitialized")
	wc2_test_rejected(c"int main():\n\tx := x + 1\n\treturn x\n", c"unknown name")
	wc2_test_rejected(c"int main():\n\tint x = 1\n\tif 1: x := 2\n\treturn x\n", c":= redeclares")
	wc2_test_rejected(c"int main():\n\tif 1: int x = 1\n\treturn x\n", c"unknown name")
	wc2_test_rejected(c"int main(): return later()\nint later(): return 1\n", c"previously declared function")
	wc2_test_rejected(c"int main(): return main(1)\n", c"wrong number")
	wc2_test_rejected(c"int f(int x, int x): return x\nint main(): return 0\n", c"duplicate parameter")
	wc2_test_rejected(c"int f(): return 1\nint f(): return 2\nint main(): return 0\n", c"duplicate function")
	wc2_test_rejected(c"int main():\n\tint x = 1\n\treturn x()\n", c"previously declared function")
	wc2_test_rejected(c"int main(): return main\n", c"expected a variable")
	wc2_test_rejected(c"void f(): return 1\nint main(): return 0\n", c"void function cannot")
	wc2_test_rejected(c"int f(): return\nint main(): return 0\n", c"must return a value")
	wc2_test_rejected(c"int f(int n):\n\tif n: return 1\nint main(): return 0\n", c"may reach its end")
	wc2_test_rejected(c"void f(): pass\nint main(): return f() + 1\n", c"expected an integer")
	wc2_test_rejected(c"int main():\n\tvoid x\n\treturn 0\n", c"variable cannot have void")
	wc2_test_rejected(c"int main():\n\treturn 0\n\tunknown = 1\n", c"unknown name")


void test_wc2_struct_values():
	wc2_test_program(c"struct Pair:\n\tint x\n\tint y\nint main():\n\tPair a\n\ta.x = 65536\n\ta.y = 7\n\tPair b = a\n\tb.x += b.y\n\treturn (a.x != 65536) || (b.x != 65543) || (b.y != 7)\n", 0)
	wc2_test_program(c"struct Pair:\n\tint x\n\tint y\nint sum(int extra, Pair p, int scale):\n\tp.x += extra\n\treturn (p.x + p.y) * scale\nint main():\n\tPair a\n\ta.x = 3\n\ta.y = 7\n\tb := a\n\tb.y = 8\n\ta = b\n\treturn (sum(2, a, 3) != 39) || (a.x != 3)\n", 0)
	wc2_test_program(c"struct Flags:\n\tbool ready\n\tint value\nint main():\n\tFlags f\n\tf.ready = 9\n\tif f.ready: f.value = 7\n\telse: f.value = 8\n\tFlags copy = f\n\treturn (copy.ready != 1) || (copy.value != 7)\n", 0)
	wc2_test_rejected(c"struct Pair:\n\tint x\n\tint y\nint main():\n\tPair p\n\tp.x = 1\n\treturn p.y\n", c"may be uninitialized")
	wc2_test_rejected(c"struct Pair:\n\tint x\n\tint y\nint main():\n\tPair p\n\tp.x = 1\n\tPair q = p\n\treturn 0\n", c"may be uninitialized")
	wc2_test_rejected(c"struct Pair:\n\tint x\nint main():\n\tPair p\n\tp.bad = 1\n\treturn 0\n", c"unknown struct field")
	wc2_test_rejected(c"struct A:\n\tint x\nstruct B:\n\tint x\nint main():\n\tA a\n\ta.x = 1\n\tB b = a\n\treturn 0\n", c"incompatible struct value")
	wc2_test_rejected(c"int main():\n\tUnknown p\n\treturn 0\n", c"unknown struct type")
	wc2_test_rejected(c"struct Pair:\n\tint x\n\tint x\nint main(): return 0\n", c"duplicate struct field")
	wc2_test_rejected(c"struct Pair:\n\tint x\nPair make(): pass\nint main(): return 0\n", c"struct return values")
	wc2_test_rejected(c"struct Pair:\n\tint x\n\tint y\nint main():\n\tPair p\n\tif 1: p.x = 7\n\telse: p.y = 7\n\treturn p.x\n", c"may be uninitialized")


void test_wc2_direct_bool_return_conversion():
	# wv2 currently dereferences the promoted int twice on this return
	# conversion (confirmed under wdbg). Assert wc2's intended result
	# independently instead of treating that production fault as an oracle.
	wc2_module* m = wc2_parse(c"bool truth(int n): return n\nint main(): return truth(-7) != 1\n", c"bool.w")
	asm_buffer* image = wc2_emit(m)
	assert1(image != 0)
	char* output = wc2_emit_test_path(c".bool")
	assert1(wc2_write_executable(output, image))
	wc2_test_exit(output, 0)
	unlink(output)
	free(output)
	asm_buffer_free(image)
	wc2_module_free(m)


void test_wc2_plain_imports():
	string_builder* name = string_new()
	string_append(name, c"wc2_import_")
	string_append_int(name, getpid())
	char* directory = path_join(c"bin", name.data)
	assert_equal(0, mkdir(directory, 493))
	string_builder* prefix = string_new()
	string_append(prefix, c"import bin.")
	string_append(prefix, name.data)
	string_append_char(prefix, '.')
	char* common = path_join(directory, c"common.w")
	char* left = path_join(directory, c"left.w")
	char* right = path_join(directory, c"right.w")
	assert1(file_write_text(common, c"struct Pair:\n\tint x\n\tint y\nint twice(int n): return n * 2\n"))
	string_builder* source = string_new()
	string_append(source, prefix.data)
	string_append(source, c"common\nint total(Pair p): return p.x + p.y\n")
	assert1(file_write_text(left, source.data))
	string_free(source)
	source = string_new()
	string_append(source, prefix.data)
	string_append(source, c"common\nint quad(int n): return twice(twice(n))\n")
	assert1(file_write_text(right, source.data))
	string_free(source)
	source = string_new()
	string_append(source, prefix.data)
	string_append(source, c"left\n")
	string_append(source, prefix.data)
	string_append(source, c"right\nint main():\n\tPair p\n\tp.x = 5\n\tp.y = 7\n\treturn quad(total(p)) != 48\n")
	wc2_test_program(source.data, 0)
	# Source order still matters after merging dependency tables.
	assert1(file_write_text(common, c"int twice(int n): return missing\n"))
	wc2_module* m = wc2_parse(source.data, c"importer.w")
	wc2_load_imports(m)
	assert1(wc2_emit(m) == 0)
	assert_contains(m.diagnostics.items[0].filename, c"common.w")
	assert_equal(1, m.diagnostics.items[0].line)
	wc2_module_free(m)
	# Cycles and missing modules fail without partial executable output.
	string_builder* cycle = string_new()
	string_append(cycle, prefix.data)
	string_append(cycle, c"left\n")
	assert1(file_write_text(common, cycle.data))
	m = wc2_parse(source.data, c"importer.w")
	wc2_load_imports(m)
	assert_equal(0, wc2_module_ok(m))
	assert_contains(m.diagnostics.items[0].message, c"cyclic import")
	wc2_module_free(m)
	unlink(common)
	m = wc2_parse(source.data, c"importer.w")
	wc2_load_imports(m)
	assert_equal(0, wc2_module_ok(m))
	assert_contains(m.diagnostics.items[0].message, c"cannot locate")
	wc2_module_free(m)
	# Parse diagnostics retain the dependency's filename too.
	assert1(file_write_text(common, c"int broken(\n"))
	m = wc2_parse(source.data, c"importer.w")
	wc2_load_imports(m)
	assert_equal(0, wc2_module_ok(m))
	assert_contains(m.diagnostics.items[0].filename, c"common.w")
	wc2_module_free(m)
	string_free(cycle)
	string_free(source)
	string_free(prefix)
	string_free(name)
	unlink(common)
	unlink(left)
	unlink(right)
	rmdir(directory)
	free(common)
	free(left)
	free(right)
	free(directory)
