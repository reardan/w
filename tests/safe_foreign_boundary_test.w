# wbuild: x64
# wbuild: deps=lib/safe_foreign_owner.w
# Audited foreign boundaries: attested imports and foreign owners. Every
# contract is checked and compiled with and without --safe, and a rejection
# must leave no executable. A case may write an audited module beside it: @M
# in the source names that module and @D is the SHA-256 of its bytes.
import lib.testing
import lib.process
import lib.file
import lib.str
import lib.sha256


int foreign_boundary_case_number


void foreign_boundary_result(process_result* result, char* diagnostic, int checking, char* path):
	assert1(result != 0)
	char* message = result.stderr_text
	if (checking): message = result.stdout_text
	if (diagnostic == 0):
		if (result.status):
			print(path)
			print(message)
		assert_equal(0, result.status)
	else:
		if ((result.status != 1) || (assert_has(message, diagnostic) == 0)):
			print(path)
			print(message)
		assert_equal(1, result.status)
		assert_contains(message, diagnostic)


char* foreign_boundary_digest(char* text):
	char[32] digest
	sha256(text, strlen(text), &digest[0])
	char* hex = cast(char*, malloc(65))
	char* digits = c"0123456789abcdef"
	for i in range(32):
		int value = digest[i] & 255
		hex[i * 2] = digits[value >> 4]
		hex[i * 2 + 1] = digits[value & 15]
	hex[64] = 0
	return hex


# Runs bin/wv2 with the given arguments after the fixed prefix.
process_result* foreign_boundary_run(int checking, int safe, char* root, char* full, char* output):
	char** argv = strv_new(13)
	int count = 0
	strv_set(argv, count, c"bin/wv2")
	count += 1
	if (checking):
		strv_set(argv, count, c"check")
		strv_set(argv, count + 1, c"--json")
		count += 2
	strv_set(argv, count, c"--quiet")
	strv_set(argv, count + 1, c"--strict")
	count += 2
	if (__word_size__ == 8):
		strv_set(argv, count, c"x64")
		count += 1
	if (root != 0):
		strv_set(argv, count, c"--import-root")
		strv_set(argv, count + 1, root)
		count += 2
	if (safe):
		strv_set(argv, count, c"--safe")
		count += 1
	strv_set(argv, count, full)
	count += 1
	if (checking == 0):
		strv_set(argv, count, c"-o")
		strv_set(argv, count + 1, output)
		count += 2
	process_result* result = process_run(argv[0], argv, 0, 0, 30000)
	free(cast(void*, argv))
	return result


# mode 1 edits the module after its digest is taken; mode 2 shadows it with
# a different file of the same name under an earlier import root.
void foreign_boundary_case(char* source, char* module, int mode, char* diagnostic, char* safe_diagnostic = 0):
	foreign_boundary_case_number = foreign_boundary_case_number + 1
	char* number = itoa(foreign_boundary_case_number)
	char* tag = c"32_"
	if (__word_size__ == 8): tag = c"64_"
	char* stem = strjoin(c"foreign_boundary_case", tag)
	char* full = strjoin(strjoin(c"bin/", strjoin(stem, number)), c".w")
	char* output = strjoin(full, c".out")
	char* name = strjoin(strjoin(c"foreign_boundary_module", tag), number)
	char* module_path = strjoin(strjoin(c"bin/", name), c".w")
	char* root = 0
	char* shadow = 0
	if (module != 0):
		source = replace(source, c"@D", foreign_boundary_digest(module))
		source = replace(source, c"@M", strjoin(c"bin.", name))
		if (mode == 1): module = strjoin(module, c"# edited after review\n")
		assert1(file_write_text(module_path, module))
		if (mode == 2):
			root = strjoin(c"bin/foreign_boundary_shadow", tag)
			mkdir(root, 493)
			mkdir(strjoin(root, c"/bin"), 493)
			shadow = strjoin(strjoin(root, c"/"), module_path)
			assert1(file_write_text(shadow, strjoin(module, c"# shadow\n")))
	assert1(file_write_text(full, source))
	for safe in range(2):
		char* expected = diagnostic
		if (safe && safe_diagnostic): expected = safe_diagnostic
		unlink(output)
		process_result* checked = foreign_boundary_run(1, safe, root, full, output)
		foreign_boundary_result(checked, expected, 1, full)
		process_result_free(checked)
		process_result* compiled = foreign_boundary_run(0, safe, root, full, output)
		foreign_boundary_result(compiled, expected, 0, full)
		process_result_free(compiled)
		if (expected):
			assert1(open(output, 0, 0) < 0)
		else:
			char** run = strv_new(1)
			strv_set(run, 0, output)
			process_result* executed = process_run(output, run, 0, 0, 30000)
			assert1(executed != 0)
			if (executed.status): print(full)
			assert_equal(0, executed.status)
			process_result_free(executed)
			free(cast(void*, run))
		unlink(output)
	unlink(full)
	if (module != 0): unlink(module_path)
	if (shadow != 0): unlink(shadow)


# An attested module adopts foreign objects; every exit releases them once.
void test_foreign_boundary_0():
	foreign_boundary_case(c"import @M unsafe \"@D\"\nimport lib.safe_foreign_owner\n\n\nint read_once(int start):\n\toptown WForeign[Counter]* counter = counter_open(start)\n\tif (counter == 0): return -1\n\tcounter_add(counter, 1)\n\treturn counter_read(counter)\n\n\nint main():\n\tint sum = 0\n\tfor i in range(5): sum += read_once(i)\n\tif (sum != 15): return 1\n\tif (counter_releases() != 5): return 2\n\toptown WForeign[Counter]* closing = counter_open(40)\n\tif (closing): foreign_close[Counter](closing)\n\tif (counter_releases() != 6): return 3\n\treturn 0\n", c"# Raw foreign-style code behind an audited checked boundary.\nimport lib.safe_foreign_owner\n\n\nstruct Counter:\n\tint value\n\n\nint counter_released\n\n\nvoid counter_release(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(raw)\n\n\nvoid counter_release_shifted(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(cast(void*, cast(int, raw) - 1))\n\n\noptown WForeign[Counter]* counter_open(int start):\n\tCounter* raw = cast(Counter*, malloc(sizeof(Counter)))\n\traw.value = start\n\treturn foreign_adopt[Counter](raw, cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_null():\n\treturn foreign_adopt[Counter](cast(Counter*, 0), cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_misaligned():\n\tint base = cast(int, malloc(sizeof(Counter) * 2))\n\treturn foreign_adopt[Counter](cast(Counter*, base + 1), cast(WForeignRelease*, counter_release_shifted))\n\n\nint counter_read(ref WForeign[Counter]* handle):\n\tCounter* raw = foreign_raw[Counter](handle)\n\treturn raw.value\n\n\nvoid counter_add(refmut WForeign[Counter]* handle, int amount):\n\tCounter* raw = foreign_raw[Counter](cast(ref WForeign[Counter]*, handle))\n\traw.value = raw.value + amount\n\n\n# Foreign code takes the object only when accept is set; otherwise the\n# caller gets its owner back.\noptown WForeign[Counter]* counter_give(own WForeign[Counter]* handle, int accept):\n\tif (accept == 0):\n\t\tWForeign[Counter]* kept = cast(WForeign[Counter]*, handle)\n\t\tWForeign[Counter]** cleared = cast(WForeign[Counter]**, &handle)\n\t\t*cleared = cast(WForeign[Counter]*, 0)\n\t\treturn cast(optown WForeign[Counter]*, kept)\n\tCounter* raw = foreign_disown[Counter](handle)\n\tcounter_release(cast(void*, raw))\n\treturn cast(optown WForeign[Counter]*, 0)\n\n\nown Counter* counter_new(int value):\n\town Counter* counter = new Counter(value)\n\treturn counter\n\n\nint counter_releases():\n\treturn counter_released\n\n\nint* counter_scratch():\n\treturn cast(int*, malloc(4))\n\n\nint counter_seven(int x):\n\tasm x86:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\tasm x64:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\treturn 7\n", 0, 0)

# A failed foreign transfer hands ownership back; a successful one does not release twice.
void test_foreign_boundary_1():
	foreign_boundary_case(c"import @M unsafe \"@D\"\nimport lib.safe_foreign_owner\n\n\nint main():\n\toptown WForeign[Counter]* counter = counter_open(3)\n\tif (!counter): return 1\n\town WForeign[Counter]* held = counter\n\toptown WForeign[Counter]* back = counter_give(held, 0)\n\tif (!back): return 2\n\tif (counter_releases() != 0): return 3\n\town WForeign[Counter]* again = back\n\toptown WForeign[Counter]* gone = counter_give(again, 1)\n\tif (gone): return 4\n\tif (counter_releases() != 1): return 5\n\treturn 0\n", c"# Raw foreign-style code behind an audited checked boundary.\nimport lib.safe_foreign_owner\n\n\nstruct Counter:\n\tint value\n\n\nint counter_released\n\n\nvoid counter_release(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(raw)\n\n\nvoid counter_release_shifted(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(cast(void*, cast(int, raw) - 1))\n\n\noptown WForeign[Counter]* counter_open(int start):\n\tCounter* raw = cast(Counter*, malloc(sizeof(Counter)))\n\traw.value = start\n\treturn foreign_adopt[Counter](raw, cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_null():\n\treturn foreign_adopt[Counter](cast(Counter*, 0), cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_misaligned():\n\tint base = cast(int, malloc(sizeof(Counter) * 2))\n\treturn foreign_adopt[Counter](cast(Counter*, base + 1), cast(WForeignRelease*, counter_release_shifted))\n\n\nint counter_read(ref WForeign[Counter]* handle):\n\tCounter* raw = foreign_raw[Counter](handle)\n\treturn raw.value\n\n\nvoid counter_add(refmut WForeign[Counter]* handle, int amount):\n\tCounter* raw = foreign_raw[Counter](cast(ref WForeign[Counter]*, handle))\n\traw.value = raw.value + amount\n\n\n# Foreign code takes the object only when accept is set; otherwise the\n# caller gets its owner back.\noptown WForeign[Counter]* counter_give(own WForeign[Counter]* handle, int accept):\n\tif (accept == 0):\n\t\tWForeign[Counter]* kept = cast(WForeign[Counter]*, handle)\n\t\tWForeign[Counter]** cleared = cast(WForeign[Counter]**, &handle)\n\t\t*cleared = cast(WForeign[Counter]*, 0)\n\t\treturn cast(optown WForeign[Counter]*, kept)\n\tCounter* raw = foreign_disown[Counter](handle)\n\tcounter_release(cast(void*, raw))\n\treturn cast(optown WForeign[Counter]*, 0)\n\n\nown Counter* counter_new(int value):\n\town Counter* counter = new Counter(value)\n\treturn counter\n\n\nint counter_releases():\n\treturn counter_released\n\n\nint* counter_scratch():\n\treturn cast(int*, malloc(4))\n\n\nint counter_seven(int x):\n\tasm x86:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\tasm x64:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\treturn 7\n", 0, 0)

