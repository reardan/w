	foreign_boundary_case(c"import @M unsafe \"@D\"\nimport lib.safe_foreign_owner\n\n\nint main():\n\toptown WForeign[Counter]* counter = counter_open(1)\n\treturn 0\n", c"# Raw foreign-style code behind an audited checked boundary.\nimport lib.safe_foreign_owner\n\n\nstruct Counter:\n\tint value\n\n\nint counter_released\n\n\nvoid counter_release(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(raw)\n\n\nvoid counter_release_shifted(void* raw):\n\tcounter_released = counter_released + 1\n\tfree(cast(void*, cast(int, raw) - 1))\n\n\noptown WForeign[Counter]* counter_open(int start):\n\tCounter* raw = cast(Counter*, malloc(sizeof(Counter)))\n\traw.value = start\n\treturn foreign_adopt[Counter](raw, cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_null():\n\treturn foreign_adopt[Counter](cast(Counter*, 0), cast(WForeignRelease*, counter_release))\n\n\noptown WForeign[Counter]* counter_open_misaligned():\n\tint base = cast(int, malloc(sizeof(Counter) * 2))\n\treturn foreign_adopt[Counter](cast(Counter*, base + 1), cast(WForeignRelease*, counter_release_shifted))\n\n\nint counter_read(ref WForeign[Counter]* handle):\n\tCounter* raw = foreign_raw[Counter](handle)\n\treturn raw.value\n\n\nvoid counter_add(refmut WForeign[Counter]* handle, int amount):\n\tCounter* raw = foreign_raw[Counter](cast(ref WForeign[Counter]*, handle))\n\traw.value = raw.value + amount\n\n\n# Foreign code takes the object only when accept is set; otherwise the\n# caller gets its owner back.\noptown WForeign[Counter]* counter_give(own WForeign[Counter]* handle, int accept):\n\tif (accept == 0):\n\t\tWForeign[Counter]* kept = cast(WForeign[Counter]*, handle)\n\t\tWForeign[Counter]** cleared = cast(WForeign[Counter]**, &handle)\n\t\t*cleared = cast(WForeign[Counter]*, 0)\n\t\treturn cast(optown WForeign[Counter]*, kept)\n\tCounter* raw = foreign_disown[Counter](handle)\n\tcounter_release(cast(void*, raw))\n\treturn cast(optown WForeign[Counter]*, 0)\n\n\nown Counter* counter_new(int value):\n\town Counter* counter = new Counter(value)\n\treturn counter\n\n\nint counter_releases():\n\treturn counter_released\n\n\nint* counter_scratch():\n\treturn cast(int*, malloc(4))\n\n\nint counter_seven(int x):\n\tasm x86:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\tasm x64:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\treturn 7\n", 1, c"safe: audited module differs from its attestation")

