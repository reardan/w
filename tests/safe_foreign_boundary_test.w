t(void*, raw))\n\treturn cast(optown WForeign[Counter]*, 0)\n\n\nown Counter* counter_new(int value):\n\town Counter* counter = new Counter(value)\n\treturn counter\n\n\nint counter_releases():\n\treturn counter_released\n\n\nint* counter_scratch():\n\treturn cast(int*, malloc(4))\n\n\nint counter_seven(int x):\n\tasm x86:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\tasm x64:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\treturn 7\n", 0, 0)

# Unattested assembly stays outside checked code.
void test_foreign_boundary_24():
	foreign_boundary_case(c"import @M\n\n\nint main():\n\treturn seven(0) - 7\n", c"int seven(int x):\n\tasm x86:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\tasm x64:\n\t\t\"mov eax, 7\"\n\t\t\"ret\"\n\treturn 7\n", 0, 0, c"safe: assembly function bodies are not supported")

# Trust does not follow imports: the attested module's raw dependency is still checked.
void test_foreign_boundary_25():
	foreign_boundary_case(c"import @M unsafe \"@D\"\n\n\nint main():\n\treturn twice(2) - 4\n", c"import lib.str\n\n\nint twice(int value):\n\tchar* text = itoa(value)\n\tfree(text)\n\treturn value * 2\n", 0, 0, c"safe: unsupported type or reference-bearing aggregate")
