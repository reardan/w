{
	"targets": [
		{
			"name": "hangs",
			"steps": [
				{"cmd": ["sleep", "30"], "timeout_ms": 300}
			]
		},
		{
			"name": "slow_ok",
			"steps": [
				{"cmd": ["sleep", "0.5"], "timeout_ms": 30000}
			]
		},
		{
			"name": "hangs_default",
			"steps": [
				{"cmd": ["sleep", "30"]}
			]
		},
		{
			"name": "explicit_zero",
			"steps": [
				{"cmd": ["sleep", "0.5"], "timeout_ms": 0}
			]
		},
		{
			"name": "leaky",
			"steps": [
				{"cmd": ["sh", "-c", "sleep 30 & echo $! > bin/wexec_group_leak_pid; exec sleep 30"], "timeout_ms": 400}
			]
		},
		{
			"name": "term_hang",
			"steps": [
				{"cmd": ["sh", "-c", "echo $$ > bin/wexec_group_term_pid; exec sleep 30"], "timeout_ms": 0}
			]
		}
	]
}
