{
	"dirs": ["bin"],
	"generate": {
		"exclude": [
			"tests/dynamic_darwin_test.w",
			"tests/pac_corrupt_fnptr_test.w",
			"tests/pac_corrupt_ret_test.w",
			"tests/parser_generator/generated_actions_test.w",
			"tests/parser_generator/generated_c_parser_test.w",
			"tests/parser_generator/generated_matcher_expressions_test.w",
			"tests/parser_generator/generated_sample_test.w",
			"tests/parser_generator/generated_streaming_fallback_test.w",
			"tests/parser_generator/generated_streaming_test.w",
			"tests/parser_generator/generated_w_parser_test.w",
			"tests/unix_tools_test.w",
			"tests/wasm_export_test.w",
			"tests/wasm_extern_test.w",
			"tests/wexec/direct_file/sample_test.w"
		],
		"no_umbrella": {
			"update": "promotes bin/wv3 to the local ./w seed; mutates the checkout",
			"update_win": "promotes the win64 fixpoint to w.exe; mutates the checkout",
			"update_darwin": "promotes the darwin fixpoint to ./w_darwin; mutates the checkout",
			"wexec_win": "Windows-host executor bootstrap used by wbuild.cmd",
			"wexec_darwin": "macOS-host executor bootstrap used by ./wbuild on a Mac",
			"manifest": "writes bin/build.json for reading",
			"wtest_cache": "warms bin/wtest's deps cache",
			"elf": "hand-run scratch program (tests/elf.w)",
			"net": "hand-run network demo; needs outbound network",
			"simple": "hand-run scratch program (tests/simple.w)",
			"testing_ground": "hand-run argv demo (tests/testing_ground.w)",
			"rewrite_c_strings": "one-off source rewriting tool",
			"storage_probe": "storage benchmark driver binary",
			"storage_native_test": "storage benchmark run (tools/storage/native_test.py)",
			"wast_audit": "AST audit tool binary",
			"ast_expression_suite": "AST migration audit; reruns the whole tests umbrella",
			"wbench_compare": "hand-run benchmark comparison; wbench_compare_test covers it",
			"profile_refresh": "regenerates profiles/*.wprof from instrumented runs; mutates the checkout (P1, docs/projects/register_allocation_pgo.md)",
			"bench_compare": "hand-run/CI program benchmark comparison against tests/bench/baseline.txt; wbench_compare_test covers the logic",
			"wcoverage_report": "writes a coverage report on demand",
			"wvm_pool_bench": "benchmark driver",
			"library_reference": "writes bin/library_reference.md on demand; library_reference_test covers it"
		},
		"tool_targets": [
			{
				"name": "wvm_image_test",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["python3", "tests/wvm_image_test.py"]}
				]
			},
			{
				"name": "manifest",
				"steps": [
					{"cmd": ["bin/wbuildgen"]}
				]
			},
			{
				"name": "manifest_check",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wbuildgen", "--check", "--check-umbrellas"], "expect_stdout": "wbuildgen: OK"}
				]
			},
			{
				"name": "metadata_check",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wmeta", "check", "package.wmeta"], "expect_stdout": "wmeta: OK"}
				]
			},
			{
				"name": "wvdiff_test",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wvdiff", "tests/vcs/wvdiff_old.txt", "tests/vcs/wvdiff_old.txt"], "expect_status": 0},
					{"cmd": ["bin/wvdiff", "tests/vcs/wvdiff_old.txt", "tests/vcs/wvdiff_new.txt"], "expect_status": 1, "expect_stdout": ["--- tests/vcs/wvdiff_old.txt", "+++ tests/vcs/wvdiff_new.txt", "@@ -1,4 +1,5 @@", "-beta", "+BETA", "+epsilon"]},
					{"cmd": ["bin/wvdiff", "tests/vcs/wvdiff_old.txt", "tests/vcs/no_such_file.txt"], "expect_status": 2, "expect_stderr": "wvdiff: cannot read"},
					{"cmd": ["bin/wvdiff", "tests/vcs/wvdiff_old.txt"], "expect_status": 2, "expect_stderr": "usage: wvdiff <old> <new>"}
				]
			},
			{
				"name": "wcloc_test",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wcloc", "--json", "tests/cloc/sample"], "expect_stdout": [
						"{\"kind\": \"group\", \"path\": \"tests/cloc/sample/sub\", \"files\": 1, \"blank\": 1, \"comment\": 3, \"code\": 3, \"tokens\": 11}",
						"{\"kind\": \"group\", \"path\": \"tests/cloc/sample\", \"files\": 1, \"blank\": 0, \"comment\": 1, \"code\": 2, \"tokens\": 7}",
						"{\"kind\": \"total\", \"files\": 2, \"blank\": 1, \"comment\": 4, \"code\": 5, \"tokens\": 18}"
					]},
					{"cmd": ["bin/wcloc", "--by-file", "tests/cloc/sample"], "expect_stdout": [
						"path                            files    blank  comment     code    tokens",
						"tests/cloc/sample/sub/leaf.w        1        1        3        3        11",
						"tests/cloc/sample/top.w             1        0        1        2         7",
						"total                               2        1        4        5        18"
					]},
					{"cmd": ["bin/wcloc", "tests/cloc/sample/top.w", "tests/cloc/no_such_dir"], "expect_status": 2, "expect_stdout": "tests/cloc/sample/top.w        1        0        1        2         7", "expect_stderr": "wcloc: cannot access 'tests/cloc/no_such_dir'"},
					{"cmd": ["bin/wcloc", "--bogus"], "expect_status": 2, "expect_stderr": "usage: wcloc [--by-file] [--json] [path ...]"}
				]
			},
			{
				"name": "wexec_keep_going_test",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wexec", "-f", "tests/wexec/keep_going.json", "-j", "2", "--keep-going", "boom", "standalone", "needs_boom", "needs_needs_boom"], "expect_fail": true, "expect_stdout": "standalone ran", "reject_stdout": "needs_boom ran", "expect_stderr": ["wexec: failed: boom", "wexec: skipped: needs_boom (dependency failed)", "wexec: skipped: needs_needs_boom (dependency failed)", "wexec: keep-going: 1 failed, 2 skipped, 1 succeeded (of 4 targets)"], "reject_stderr": "stopped early"},
					{"cmd": ["bin/wexec", "-f", "tests/wexec/keep_going.json", "-j", "2", "boom", "standalone", "needs_boom", "needs_needs_boom"], "expect_fail": true, "reject_stdout": "needs_boom ran", "expect_stderr": ["wexec: failed: boom (exit status 1)", "wexec: stopped early after failure: 2 of 4 targets not attempted"], "reject_stderr": "keep-going"},
					{"cmd": ["bin/wexec", "-f", "tests/wexec/keep_going.json", "--keep-going", "standalone"], "expect_stdout": ["standalone ran", "wexec: OK (1 targets)"]},
					{"cmd": ["bin/wexec", "-f", "tests/wexec/keep_going.json", "boom"], "expect_fail": true, "reject_stderr": "not attempted"}
				]
			},
			{
				"name": "wexec_ordered_output_test",
				"tags": ["tests"],
				"steps": [
					{"cmd": ["bin/wexec", "-j", "2", "-f", "tests/wexec/ordered_output.json", "alpha", "beta"], "expect_stdout": "wexec: OK (2 targets)", "reject_stdout": "wexec: --- "},
					{"cmd": ["bin/wexec", "--ordered-output", "-j", "2", "-f", "tests/wexec/ordered_output.json", "alpha", "beta"], "expect_stdout": ["wexec: --- beta ---\nwexec: target beta\n$ sleep 0.1\n$ echo beta-line-1\nbeta-line-1\n$ echo beta-line-2\nbeta-line-2\nwexec: --- alpha ---\nwexec: target alpha\n$ echo alpha-line-1\nalpha-line-1\n$ sleep 0.6\n$ echo alpha-line-2\nalpha-line-2\n", "wexec: OK (2 targets)"]},
					{"cmd": ["bin/wexec", "-f", "tests/wexec/keep_going.json", "-j", "2", "--keep-going", "--ordered-output", "boom", "standalone", "needs_boom", "needs_needs_boom"], "expect_fail": true, "expect_stdout": ["wexec: --- standalone ---\nwexec: target standalone\n$ echo standalone ran\nstandalone ran\n", "wexec: --- boom ---\nwexec: target boom\n$ false\n"], "reject_stdout": "needs_boom ran", "expect_stderr": ["wexec: error: target 'boom' step 1: command failed with exit status 1", "wexec: failed: boom", "wexec: skipped: needs_boom (dependency failed)", "wexec: skipped: needs_needs_boom (dependency failed)", "wexec: keep-going: 1 failed, 2 skipped, 1 succeeded (of 4 targets)"], "reject_stderr": "stopped early"}
				]
			},
			{
				"name": "asm_seed_gate",
				"tags": ["tests"],
				"inputs": ["libs/asm/", "code_generator/asm_text.w", "code_generator/code_emitter.w", "code_generator/integer.w", "tests/asm_seed_check.w", "w"],
				"steps": [
					{"cmd": ["./w", "tests/asm_seed_check.w", "-o", "bin/asm_seed_check"]},
					{"cmd": ["bin/asm_seed_check"]}
				]
			},
			{
				"name": "wtest_cache",
				"steps": [
					{"cmd": ["bin/wtest", "cache"], "expect_stdout": "wtest: deps cache ready"}
				]
			}
		]
	},
	"targets": [
		{
			"name": "wv2",
			"inputs": ["w.w", "compiler/", "grammar/", "code_generator/", "lib/", "structures/", "libs/", "debugger/"],
			"outputs": ["bin/wv2"],
			"steps": [
				{"cmd": ["./w", "w.w", "-o", "bin/wv2"], "atomic_output": "bin/wv2"}
			]
		},
		{
			"name": "wexec",
			"deps": ["wv2"],
			"inputs": ["tools/wexec_main.w"],
			"outputs": ["bin/wexec"],
			"steps": [
				{"cmd": ["bin/wv2", "tools/wexec_main.w", "-o", "bin/wexec.stage"]},
				{"cmd": ["mv", "bin/wexec.stage", "bin/wexec"]}
			]
		},
		{
			"name": "build",
			"tags": ["tests"],
			"deps": ["wv2"],
			"inputs": [],
			"outputs": ["bin/wv3", "bin/wv4", "bin/wv5"],
			"steps": [
				{"cmd": ["bin/wv2", "--strict", "w.w", "-o", "bin/wv3"], "atomic_output": "bin/wv3"},
				{"cmd": ["bin/wv3", "--strict", "w.w", "-o", "bin/wv4"], "atomic_output": "bin/wv4"},
				{"cmd": ["bin/wv4", "--strict", "w.w", "-o", "bin/wv5"], "atomic_output": "bin/wv5"}
			]
		},
		{
			"name": "verify",
			"tags": ["tests"],
			"deps": ["build"],
			"inputs": [],
			"steps": [
				{"cmd": ["cmp", "bin/wv3", "bin/wv4"]},
				{"cmd": ["cmp", "bin/wv4", "bin/wv5"]},
				{"cmd": ["echo", "self-host fixpoint OK: wv3 == wv4 == wv5"]}
			]
		},
		{
			"name": "build_pgo",
			"deps": ["wv2"],
			"inputs": ["profiles/self.wprof", "profiles/self_x64.wprof"],
			"outputs": ["bin/wv3_pgo", "bin/wv4_pgo", "bin/wv5_pgo", "bin/wv3_pgo_streaming", "bin/wv3_pgo_64", "bin/wv4_pgo_64"],
			"steps": [
				{"cmd": ["bin/wv2", "--profile-use=profiles/self.wprof", "--strict", "w.w", "-o", "bin/wv3_pgo"]},
				{"cmd": ["bin/wv3_pgo", "--profile-use=profiles/self.wprof", "--strict", "w.w", "-o", "bin/wv4_pgo"]},
				{"cmd": ["bin/wv4_pgo", "--profile-use=profiles/self.wprof", "--strict", "w.w", "-o", "bin/wv5_pgo"]},
				{"cmd": ["bin/wv2", "--profile-use=profiles/self.wprof", "--streaming", "--strict", "w.w", "-o", "bin/wv3_pgo_streaming"]},
				{"cmd": ["bin/wv2", "x64", "--profile-use=profiles/self_x64.wprof", "--strict", "w.w", "-o", "bin/wv3_pgo_64"]},
				{"cmd": ["bin/wv3_pgo_64", "x64", "--profile-use=profiles/self_x64.wprof", "--strict", "w.w", "-o", "bin/wv4_pgo_64"]}
			]
		},
		{
			"name": "verify_pgo",
			"tags": ["tests"],
			"deps": ["build_pgo"],
			"inputs": [],
			"steps": [
				{"cmd": ["cmp", "bin/wv3_pgo", "bin/wv4_pgo"]},
				{"cmd": ["cmp", "bin/wv4_pgo", "bin/wv5_pgo"]},
				{"cmd": ["cmp", "bin/wv3_pgo", "bin/wv3_pgo_streaming"]},
				{"cmd": ["cmp", "bin/wv3_pgo_64", "bin/wv4_pgo_64"]},
				{"cmd": ["echo", "PGO self-host fixpoint OK: wv3_pgo == wv4_pgo == wv5_pgo (== streaming), wv3_pgo_64 == wv4_pgo_64"]}
			]
		},
		{
			"name": "profile_check",
			"tags": ["tests"],
			"deps": ["wv2", "wprof"],
			"steps": [
				{"cmd": ["bin/wprof", "stats", "profiles/self.wprof", "w.w"]},
				{"cmd": ["bin/wprof", "stats", "--arch", "x64", "profiles/self_x64.wprof", "w.w"]},
				{"cmd": ["bin/wprof", "stats", "profiles/bench.wprof", "tests/bench/sum.w", "tests/bench/sieve.w", "tests/bench/sha256_1m.w", "tests/bench/siphash_keys.w", "tests/bench/inflate_corpus.w", "tests/bench/regex_backtrack.w", "tests/bench/matmul_256.w", "tests/bench/strcmp_sort.w"]}
			]
		},
		{
			"name": "update",
			"deps": ["verify"],
			"steps": [
				{"cmd": ["bin/wv2", "tools/promote_seed.w", "-o", "bin/promote_seed"]},
				{"cmd": ["bin/promote_seed", "w", "bin/wv3"]}
			]
		},
		{
			"name": "wv2_win",
			"deps": ["wv2"],
			"inputs": ["w.w", "compiler/", "grammar/", "code_generator/", "lib/", "structures/", "libs/", "debugger/"],
			"outputs": ["bin/wv2_win.exe"],
			"steps": [
				{"cmd": ["bin/wv2", "win64", "w.w", "-o", "bin/wv2_win.exe"]}
			]
		},
		{
			"name": "wexec_win",
			"deps": ["wv2"],
			"inputs": ["tools/wexec_main.w"],
			"outputs": ["bin/wexec_win.exe"],
			"steps": [
				{"cmd": ["bin/wv2", "win64", "tools/wexec_main.w", "-o", "bin/wexec_win.exe"]}
			]
		},
		{
			"name": "build_win",
			"deps": ["wv2_win"],
			"inputs": [],
			"outputs": ["bin/wv3_win.exe", "bin/wv4_win.exe", "bin/wv5_win.exe"],
			"steps": [
				{"cmd": ["wine", "bin/wv2_win.exe", "win64", "w.w", "-o", "bin/wv3_win.exe"]},
				{"cmd": ["wine", "bin/wv3_win.exe", "win64", "w.w", "-o", "bin/wv4_win.exe"]},
				{"cmd": ["wine", "bin/wv4_win.exe", "win64", "w.w", "-o", "bin/wv5_win.exe"]}
			]
		},
		{
			"name": "verify_win",
			"tags": ["tests_win64"],
			"deps": ["build_win"],
			"inputs": [],
			"steps": [
				{"cmd": ["cmp", "bin/wv3_win.exe", "bin/wv4_win.exe"]},
				{"cmd": ["cmp", "bin/wv4_win.exe", "bin/wv5_win.exe"]},
				{"cmd": ["echo", "win64 self-host fixpoint OK: wv3_win == wv4_win == wv5_win"]}
			]
		},
		{
			"name": "update_win",
			"deps": ["verify_win"],
			"steps": [
				{"cmd": ["bin/wv2", "tools/promote_seed.w", "-o", "bin/promote_seed"]},
				{"cmd": ["bin/promote_seed", "w.exe", "bin/wv3_win.exe"]}
			]
		},
		{
			"name": "wexec_darwin",
			"inputs": ["tools/wexec_main.w", "tools/wexec.w", "w_darwin"],
			"outputs": ["bin/wexec_darwin"],
			"steps": [
				{"cmd": ["./w_darwin", "arm64_darwin", "w.w", "-o", "bin/wv2_darwin_raw"]},
				{"cmd": ["cp", "bin/wv2_darwin_raw", "bin/wv2_darwin.new"]},
				{"cmd": ["mv", "-f", "bin/wv2_darwin.new", "bin/wv2_darwin"]},
				{"cmd": ["bin/wv2_darwin", "arm64_darwin", "tools/wexec_main.w", "-o", "bin/wexec_darwin_raw"]},
				{"cmd": ["cp", "bin/wexec_darwin_raw", "bin/wexec_darwin.new"]},
				{"cmd": ["mv", "-f", "bin/wexec_darwin.new", "bin/wexec_darwin"]}
			]
		},
		{
			"name": "build_darwin",
			"steps": [
				{"cmd": ["./w_darwin", "arm64_darwin", "w.w", "-o", "bin/wv2_darwin_raw"]},
				{"cmd": ["cp", "bin/wv2_darwin_raw", "bin/wv2_darwin.new"]},
				{"cmd": ["mv", "-f", "bin/wv2_darwin.new", "bin/wv2_darwin"]},
				{"cmd": ["bin/wv2_darwin", "arm64_darwin", "w.w", "-o", "bin/wv3_darwin_raw"]},
				{"cmd": ["cp", "bin/wv3_darwin_raw", "bin/wv3_darwin.new"]},
				{"cmd": ["mv", "-f", "bin/wv3_darwin.new", "bin/wv3_darwin"]},
				{"cmd": ["bin/wv3_darwin", "arm64_darwin", "w.w", "-o", "bin/wv4_darwin_raw"]}
			]
		},
		{
			"name": "verify_darwin",
			"tags": ["tests_darwin"],
			"deps": ["build_darwin"],
			"steps": [
				{"cmd": ["cmp", "bin/wv3_darwin_raw", "bin/wv4_darwin_raw"]},
				{"cmd": ["echo", "darwin self-host fixpoint OK: wv3_darwin == wv4_darwin"]}
			]
		},
		{
			"name": "arm64_optimization_darwin_test",
			"tags": ["tests_darwin"],
			"deps": ["build_darwin"],
			"steps": [
				{"cmd": ["tools/mac/run_optimizer_tests.sh"]}
			]
		},
		{
			"name": "update_darwin",
			"deps": ["verify_darwin"],
			"steps": [
				{"cmd": ["bin/wv3_darwin", "arm64_darwin", "tools/promote_seed.w", "-o", "bin/promote_seed_darwin"]},
				{"cmd": ["bin/promote_seed_darwin", "w_darwin", "bin/wv3_darwin"]}
			]
		},
		{
			"name": "build_x64",
			"deps": ["wv2"],
			"steps": [
				{"cmd": ["bin/wv2", "x64", "w.w", "-o", "bin/wv2_64"], "atomic_output": "bin/wv2_64"},
				{"cmd": ["bin/wv2_64", "x64", "w.w", "-o", "bin/wv3_64"], "atomic_output": "bin/wv3_64"},
				{"cmd": ["bin/wv3_64", "x64", "w.w", "-o", "bin/wv4_64"], "atomic_output": "bin/wv4_64"}
			]
		},
		{
			"name": "verify_x64",
			"tags": ["tests_x64"],
			"deps": ["build_x64"],
			"steps": [
				{"cmd": ["cmp", "bin/wv2_64", "bin/wv3_64"]},
				{"cmd": ["cmp", "bin/wv3_64", "bin/wv4_64"]},
				{"cmd": ["echo", "x64 self-host fixpoint OK: wv2_64 == wv3_64 == wv4_64"]}
			]
		},
		{
			"name": "build_arm64",
			"deps": ["wv2", "wrun"],
			"inputs": [],
			"outputs": ["bin/wv2_arm64", "bin/wv3_arm64"],
			"steps": [
				{"cmd": ["bin/wv2", "arm64", "w.w", "-o", "bin/wv2_arm64"]},
				{"cmd": ["bin/wrun", "arm64", "bin/wv2_arm64", "arm64", "w.w", "-o", "bin/wv3_arm64"]}
			]
		},
		{
			"name": "verify_arm64",
			"tags": ["tests_arm64"],
			"deps": ["build_arm64"],
			"inputs": [],
			"steps": [
				{"cmd": ["cmp", "bin/wv2_arm64", "bin/wv3_arm64"]},
				{"cmd": ["echo", "arm64 self-host fixpoint OK: wv2_arm64 == wv3_arm64"]}
			]
		},
		{
			"name": "build_wasm",
			"deps": ["wv2", "wrun"],
			"inputs": [],
			"steps": [
				{"cmd": ["bin/wv2", "wasm", "w.w", "-o", "bin/wv2_wasm"]},
				{"cmd": ["bin/wrun", "wasm", "bin/wv2_wasm", "wasm", "w.w", "-o", "bin/wv3_wasm"]}
			]
		},
		{
			"name": "verify_wasm",
			"tags": ["tests_wasm"],
			"deps": ["build_wasm"],
			"inputs": [],
			"steps": [
				{"cmd": ["cmp", "bin/wv2_wasm", "bin/wv3_wasm"]},
				{"cmd": ["echo", "wasm self-host fixpoint OK: wv2_wasm == wv3_wasm"]}
			]
		},
		{
			"name": "generated",
			"deps": []
		},
		{
			"name": "tests_arm64",
			"deps": []
		},
		{
			"name": "tests_arm64_native",
			"deps": [
				"memfd_test_arm64"
			]
		},
		{
			"name": "tests_wasm",
			"deps": []
		},
		{
			"name": "tests_darwin",
			"deps": []
		},
		{
			"name": "tests_interop",
			"deps": []
		},
		{
			"name": "tests_gpu",
			"deps": []
		},
		{
			"name": "tests_win64",
			"deps": []
		},
		{
			"name": "tests_x64",
			"deps": []
		},
		{
			"name": "tests",
			"deps": [
				"tests_x64"
			]
		},
		{
